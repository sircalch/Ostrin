// std.linalg.solve_checked on the same system as lu_solve (equilibration, LU with partial pivoting, residual and the
// condition estimate). The printed value is the sum of the solution entries; repeated K times.
import std.linalg

fn main() -> Void {
    values = args()
    mut n = 100
    mut repeats = 1
    if values.length() > 0 {
        n = parse_int(values[0]).unwrap()
    }
    if values.length() > 1 {
        repeats = parse_int(values[1]).unwrap()
    }
    mut d = zeros([n, n])
    for i in 0 until n {
        for j in 0 until n {
            if i == j {
                d.set(i, j, 2.0 * (n as Float))
            } else {
                d.set(i, j, ((((i * 3 + j * 5) % 7) - 3) as Float) / 4.0)
            }
        }
    }
    mut b = zeros([n])
    for i in 0 until n {
        mut s = 0.0
        for j in 0 until n {
            s = s + d.get(i, j) * (((j % 9) as Float) - 4.0)
        }
        b.set(i, s)
    }
    mut total = 0.0
    for k in 0 until repeats {
        match linalg.solve_checked(d, b) {
            Ok(fit) => {
                total = 0.0
                for j in 0 until n {
                    total = total + fit.x[j]
                }
            },
            Err(message) => print("error " + message),
        }
    }
    print("RESULT solve_checked " + total.to_string())
}
