// Solves D x = b by LU factorization with partial pivoting (std.numeric.lu and its solve), without the condition estimate.
// D is strictly diagonally dominant with entries of size at most 2n/ (a multiple of 1/4); b = D x* for the known x* below, so
// the printed value is the sum of the computed solution's entries, and the exact sum is sum_j x*_j. Repeated K times.
import std.numeric

fn main() -> Void {
    values = args()
    mut n = 100
    mut repeats = 1
    if values.length() > 0 {
        n = parse_int(values[0]).unwrap()
    }
    if values.length() > 1 {
        repeats = parse_int(values[1]).unwrap()
    }
    mut d = zeros([n, n])
    for i in 0 until n {
        for j in 0 until n {
            if i == j {
                d.set(i, j, 2.0 * (n as Float))
            } else {
                d.set(i, j, ((((i * 3 + j * 5) % 7) - 3) as Float) / 4.0)
            }
        }
    }
    mut b = zeros([n])
    for i in 0 until n {
        mut s = 0.0
        for j in 0 until n {
            s = s + d.get(i, j) * (((j % 9) as Float) - 4.0)
        }
        b.set(i, s)
    }
    mut total = 0.0
    for k in 0 until repeats {
        factors = numeric.lu(d, 0.0).unwrap()
        x = factors.solve(b)
        total = 0.0
        for j in 0 until n {
            total = total + x[j]
        }
    }
    print("RESULT lu_solve " + total.to_string())
}
