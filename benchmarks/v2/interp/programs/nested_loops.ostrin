// Benchmark V2 interpreter workload: two nested range loops. Generated by benchmarks/v2/interp/programs.mjs; do not edit.
fn main() -> Void {
    values = args()
    mut repeats = 1
    if values.length() > 0 {
        repeats = parse_int(values[0]).unwrap()
    }
    mut total = 0
    for k in 0 until repeats {
        for i in 0 until 600 {
            for j in 0 until 600 {
                total = total + i * j
            }
        }
    }
    print("RESULT nested_loops " + total.to_string())
}
