// Benchmark V2 interpreter workload: one integer addition per iteration. Generated by benchmarks/v2/interp/programs.mjs; do not edit.
fn main() -> Void {
    values = args()
    mut repeats = 1
    if values.length() > 0 {
        repeats = parse_int(values[0]).unwrap()
    }
    mut total = 0
    for k in 0 until repeats {
        for i in 0 until 500000 {
            total = total + i
        }
    }
    print("RESULT micro_int_add " + total.to_string())
}
