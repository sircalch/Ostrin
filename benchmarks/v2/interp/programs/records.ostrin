// Benchmark V2 interpreter workload: record field updates in a loop. Generated by benchmarks/v2/interp/programs.mjs; do not edit.
record Point {
    mut x: Int
    mut y: Int
}

fn main() -> Void {
    values = args()
    mut repeats = 1
    if values.length() > 0 {
        repeats = parse_int(values[0]).unwrap()
    }
    mut total = 0
    for k in 0 until repeats {
        mut p = Point { x: 0, y: 0 }
        for i in 0 until 100000 {
            p.x = p.x + i
            p.y = p.y + 1
        }
        total = total + p.x + p.y
    }
    print("RESULT records " + total.to_string())
}
