// Benchmark V2 interpreter workload: a loop body with three names. Generated by benchmarks/v2/interp/programs.mjs; do not edit.
fn main() -> Void {
    values = args()
    mut repeats = 1
    if values.length() > 0 {
        repeats = parse_int(values[0]).unwrap()
    }
    mut total = 0
    for k in 0 until repeats {
        for i in 0 until 500000 {
            a = i + 1
            b = a * 2
            c = b + a
            total = total + c
        }
    }
    print("RESULT frames_small " + total.to_string())
}
