// Benchmark V2 interpreter workload: recursive Fibonacci, fib(22). Generated by benchmarks/v2/interp/programs.mjs; do not edit.
fn fib(n: Int) -> Int {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

fn main() -> Void {
    values = args()
    mut repeats = 1
    if values.length() > 0 {
        repeats = parse_int(values[0]).unwrap()
    }
    mut total = 0
    for k in 0 until repeats {
        total = total + fib(22)
    }
    print("RESULT recursion_fib " + total.to_string())
}
