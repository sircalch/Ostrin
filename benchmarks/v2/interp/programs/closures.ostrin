// Benchmark V2 interpreter workload: a closure created and called in each iteration. Generated by benchmarks/v2/interp/programs.mjs; do not edit.
fn main() -> Void {
    values = args()
    mut repeats = 1
    if values.length() > 0 {
        repeats = parse_int(values[0]).unwrap()
    }
    mut total = 0
    for k in 0 until repeats {
        for i in 0 until 100000 {
            f = fn(x) { x + i }
            total = total + f(1)
        }
    }
    print("RESULT closures " + total.to_string())
}
