// Benchmark V2 interpreter workload: names defined three frames up, read inside nested blocks. Generated by benchmarks/v2/interp/programs.mjs; do not edit.
fn main() -> Void {
    values = args()
    mut repeats = 1
    if values.length() > 0 {
        repeats = parse_int(values[0]).unwrap()
    }
    base1 = 3
    base2 = 5
    base3 = 7
    mut total = 0
    for k in 0 until repeats {
        for i in 0 until 500000 {
            if i >= 0 {
                if i >= 0 {
                    total = total + base1 + base2 + base3 + i
                }
            }
        }
    }
    print("RESULT scope_lookup " + total.to_string())
}
