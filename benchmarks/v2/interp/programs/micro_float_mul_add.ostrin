// Benchmark V2 interpreter workload: two float operations per iteration. Generated by benchmarks/v2/interp/programs.mjs; do not edit.
fn main() -> Void {
    values = args()
    mut repeats = 1
    if values.length() > 0 {
        repeats = parse_int(values[0]).unwrap()
    }
    mut f = 1.0
    for k in 0 until repeats {
        for i in 0 until 500000 {
            f = f * 0.9999999 + 0.5
        }
    }
    print("RESULT micro_float_mul_add " + f.to_string())
}
