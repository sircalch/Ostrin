// Benchmark V2 interpreter workload: a while loop with a counter. Generated by benchmarks/v2/interp/programs.mjs; do not edit.
fn main() -> Void {
    values = args()
    mut repeats = 1
    if values.length() > 0 {
        repeats = parse_int(values[0]).unwrap()
    }
    mut total = 0
    for k in 0 until repeats {
        mut i = 0
        while i < 500000 {
            total = total + 1
            i = i + 1
        }
    }
    print("RESULT micro_while_loop " + total.to_string())
}
