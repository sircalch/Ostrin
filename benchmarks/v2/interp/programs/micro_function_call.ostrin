// Benchmark V2 interpreter workload: one user function call per iteration. Generated by benchmarks/v2/interp/programs.mjs; do not edit.
fn advance(x: Int) -> Int {
    return x + 1
}

fn main() -> Void {
    values = args()
    mut repeats = 1
    if values.length() > 0 {
        repeats = parse_int(values[0]).unwrap()
    }
    mut total = 0
    for k in 0 until repeats {
        for i in 0 until 500000 {
            total = advance(total)
        }
    }
    print("RESULT micro_function_call " + total.to_string())
}
