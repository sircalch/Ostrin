// Benchmark V2 interpreter workload: one array element read per iteration. Generated by benchmarks/v2/interp/programs.mjs; do not edit.
fn main() -> Void {
    values = args()
    mut repeats = 1
    if values.length() > 0 {
        repeats = parse_int(values[0]).unwrap()
    }
    v = zeros([16])
    mut sum = 0.0
    for k in 0 until repeats {
        for i in 0 until 500000 {
            sum = sum + v[i % 16]
        }
    }
    print("RESULT micro_array_read " + sum.to_string())
}
