// Benchmark V2 interpreter workload: one physical quantity addition per iteration. Generated by benchmarks/v2/interp/programs.mjs; do not edit.
fn main() -> Void {
    values = args()
    mut repeats = 1
    if values.length() > 0 {
        repeats = parse_int(values[0]).unwrap()
    }
    mut q = 0.0 m
    for k in 0 until repeats {
        for i in 0 until 100000 {
            q = q + 0.5 m
        }
    }
    print("RESULT micro_quantity_add " + q.value().to_string())
}
