record Cursor<T> {
    value: T
    mut remaining: Int
}

impl<T> Iterator<T> for Cursor<T> {
    fn next(mut self) -> Option<T> {
        if self.remaining <= 0 {
            None
        } else {
            self.remaining = self.remaining - 1
            Some(self.value)
        }
    }
}

fn main() -> Void {
    cursor = Cursor<List<String>> { value: ["a", "b"], remaining: 2 }
    for row in cursor {
        print(row.join("|"))
    }
}
