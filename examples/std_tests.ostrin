import std.math
import std.lists
import std.strings
import std.time
import std.json
import std.maps

fn test_min_max_clamp() -> Void {
    assert_eq(math.min(3, 9), 3)
    assert_eq(math.max(-4, -9), -4)
    assert_eq(math.max(2.5, 1.5), 2.5)
    assert_eq(math.min("pear", "apple"), "apple")
    assert_eq(math.clamp(15, 0, 10), 10)
    assert_eq(math.clamp(-5, 0, 10), 0)
    assert_eq(math.clamp(7, 0, 10), 7)
}

fn test_integer_helpers() -> Void {
    assert_eq(math.sign(-8), -1)
    assert_eq(math.sign(0), 0)
    assert_eq(math.sign(12), 1)
    assert_eq(math.gcd(12, 18), 6)
    assert_eq(math.gcd(0, 5), 5)
    assert_eq(math.gcd(-12, 18), 6)
    assert_eq(math.lcm(4, 6), 12)
    assert_eq(math.lcm(0, 3), 0)
    assert_eq(math.pow_int(2, 10), 1024)
    assert_eq(math.pow_int(3, 0), 1)
}

fn test_search() -> Void {
    assert(lists.contains([1, 2, 3], 2))
    assert(not lists.contains([1, 2, 3], 9))
    none: List<Int> = []
    assert(not lists.contains(none, 1))
    assert_eq(lists.index_of(["a", "b", "c"], "c"), 2)
    assert_eq(lists.index_of(["a"], "z"), -1)
}

fn test_construction() -> Void {
    assert_eq(lists.reversed([1, 2, 3]), [3, 2, 1])
    assert_eq(lists.take([1, 2, 3, 4], 2), [1, 2])
    assert_eq(lists.take([1, 2], 10), [1, 2])
    assert_eq(lists.drop_first([1, 2, 3, 4], 3), [4])
    assert_eq(lists.concat([1], [2, 3]), [1, 2, 3])
    assert_eq(lists.repeat("x", 3), ["x", "x", "x"])
    assert_eq(lists.range_list(2, 6), [2, 3, 4, 5])
    nothing: List<Int> = []
    assert_eq(lists.range_list(5, 5), nothing)
}

fn test_sorting_and_extremes() -> Void {
    assert_eq(lists.sorted([3, 1, 2, 5, 4]), [1, 2, 3, 4, 5])
    assert_eq(lists.sorted([2, 2, 1, 1]), [1, 1, 2, 2])
    assert_eq(lists.sorted(["pear", "apple", "fig"]), ["apple", "fig", "pear"])
    empty: List<Int> = []
    assert_eq(lists.sorted(empty), empty)
    assert_eq(lists.max_of([4, 9, 2]), Some(9))
    assert_eq(lists.min_of([4, 9, 2]), Some(2))
    assert(lists.max_of(empty).is_none())
}

fn test_strings() -> Void {
    assert_eq(strings.repeat("ab", 3), "ababab")
    assert_eq(strings.repeat("ab", 0), "")
    assert_eq(strings.pad_left("7", 3, "0"), "007")
    assert_eq(strings.pad_left("1234", 3, "0"), "1234")
    assert_eq(strings.pad_right("ab", 4, "."), "ab..")
    assert_eq(strings.count_of("a,b,c", ","), 2)
    assert_eq(strings.count_of("abc", ""), 0)
    assert_eq(strings.trim("  Ostrin  "), "Ostrin")
    assert_eq(strings.split("a,b,c", ","), ["a", "b", "c"])
    assert_eq(strings.lines("a\nb"), ["a", "b"])
    assert(strings.is_blank("   "))
    assert_eq(strings.format_text("{} + {} = {}", ["2", "3", "5"]), "2 + 3 = 5")
    assert_eq(strings.char_at("Ostrin", 1), "s")
    assert_eq(strings.slice("Ostrin", 1, 4), "str")
    assert_eq(strings.char_at("Ostrin", 1).codepoint().unwrap(), 115)
}

fn test_time_calendar() -> Void {
    assert(time.is_leap_year(2024))
    assert(not time.is_leap_year(1900))
    assert(time.is_leap_year(2000))
    assert_eq(time.days_in_month(2024, 2), 29)
    assert_eq(time.days_in_month(2023, 2), 28)
    leap = time.date(2024, 2, 29)
    assert(time.is_valid(leap))
    assert(not time.is_valid(time.date(2023, 2, 29)))
    assert_eq(time.day_of_year(leap), 60)
    assert_eq(time.day_of_year(time.date(2023, 3, 1)), 60)
    assert_eq(time.day_of_week(time.date(2024, 1, 1)), 1)
    assert_eq(time.iso(leap), "2024-02-29")
    from_ordinal = time.from_day_of_year(2024, 60).unwrap()
    assert_eq(from_ordinal.month, 2)
    assert_eq(from_ordinal.day, 29)
    assert(time.from_day_of_year(2024, 367).is_none())
    parsed = time.parse_iso("2024-02-29").unwrap()
    assert_eq(parsed.year, 2024)
    assert(time.parse_iso("2023-02-29").is_err())
    assert(time.parse_iso("2024-2-29").is_err())
}

fn test_json_dom_parser_and_serializer() -> Void {
    source = "{\"name\":\"Ostrin\",\"items\":[true,null,3.5],\"unicode\":\"\\uD83D\\uDE00\"}"
    value = json.parse(source).unwrap()
    assert_eq(json.stringify(value), "{\"name\":\"Ostrin\",\"items\":[true,null,3.5],\"unicode\":\"😀\"}")
    assert_eq(json.as_text(json.object_get(value, "name").unwrap()).unwrap(), "Ostrin")
    assert_eq(json.object_keys(value).unwrap(), ["name", "items", "unicode"])
    items = json.array_items(json.object_get(value, "items").unwrap()).unwrap()
    assert(json.as_bool(items[0]).unwrap())
    assert_eq(json.as_number(items[2]).unwrap(), 3.5)
    assert_eq(json.stringify(json.array_value([json.number_value(1.0), json.bool_value(false)])), "[1,false]")
    assert(json.parse("{\"duplicate\":1,\"duplicate\":2}").is_err())
    assert(json.parse("[1,").is_err())
}

fn test_maps() -> Void {
    scores = ["ann": 3, "bob": 5]
    assert_eq(maps.count(scores), 2)
    assert(not maps.is_empty(scores))
    assert(maps.contains_key(scores, "ann"))
    assert(not maps.contains_key(scores, "zed"))
    assert_eq(maps.get_or(scores, "ann", 0), 3)
    assert_eq(maps.get_or(scores, "zed", 0), 0)
    map_keys = maps.keys(scores)
    assert_eq(map_keys.length(), 2)
    drop(map_keys)
    map_values = maps.values(scores)
    assert_eq(map_values.length(), 2)
    drop(map_values)
}
