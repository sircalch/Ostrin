import std.args
import std.env

fn main() -> Void {
    values = args.all()
    print(args.count())
    print(args.at(0).unwrap())
    print(args.at(1).unwrap())
    print(args.at(2).is_none())
    print(env.get("OSTRIN_TEST_VALUE").unwrap())
    print(env.current_dir().length() > 0)
    print(env.join("src", "main.ostrin"))
    print(env.exists("../examples/format_filesystem.ostrin"))
}
