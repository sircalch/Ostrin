// Experimental std.measurements scalar API: explicit sources preserve correlation.
import std.measurements

fn main() -> Void {
    match measurements.standard(12.30, 0.02, "caliper") {
        Ok(x) => match measurements.standard(1.50, 0.03, "reference") {
            Ok(y) => {
                print("x = " + measurements.summary(x))
                print("x + x = " + measurements.summary(measurements.add(x, x).unwrap()))
                print("x - x = " + measurements.summary(measurements.sub(x, x).unwrap()))
                print("x + y = " + measurements.summary(measurements.add(x, y).unwrap()))
                print("2x = " + measurements.summary(measurements.mul(x, measurements.exact(2.0)).unwrap()))
                print("x * x = " + measurements.summary(measurements.mul(x, x).unwrap()))
                print("x * y = " + measurements.summary(measurements.mul(x, y).unwrap()))
                print("x / x = " + measurements.summary(measurements.div(x, x).unwrap()))
                print("unknown = " + measurements.summary(measurements.scale(measurements.unknown(4.0, "sensor offline"), 2.0)))
            },
            Err(message) => print("reference error: " + message),
        },
        Err(message) => print("caliper error: " + message),
    }

    match measurements.standard(1.0, -0.1, "bad") {
        Ok(_) => print("invalid sigma accepted"),
        Err(message) => print("invalid sigma = " + message),
    }
    match measurements.standard(1.0, 0.1, "") {
        Ok(_) => print("empty source accepted"),
        Err(message) => print("empty source = " + message),
    }
    match measurements.standard(sqrt(-1.0), 0.1, "nan value") {
        Ok(_) => print("non-finite value accepted"),
        Err(message) => print("non-finite value = " + message),
    }
    match measurements.standard(1.0, sqrt(-1.0), "nan sigma") {
        Ok(_) => print("non-finite sigma accepted"),
        Err(message) => print("non-finite sigma = " + message),
    }
    match measurements.standard(1.0, 1.0 / 0.0, "infinite sigma") {
        Ok(_) => print("infinite sigma accepted"),
        Err(message) => print("infinite sigma = " + message),
    }
    print("non-finite exact = " + measurements.summary(measurements.exact(sqrt(-1.0))))
    source_a = measurements.from_source(3.0, 0.1, "run-7:sample-1", "thermometer")
    source_b = measurements.from_source(4.0, 0.1, "run-7:sample-1", "reference thermometer")
    print("same id, different labels = " + measurements.summary(measurements.sub(source_a.unwrap(), source_b.unwrap()).unwrap()))
    independent_a = measurements.from_source(3.0, 0.1, "run-7:channel-a", "same label")
    independent_b = measurements.from_source(4.0, 0.1, "run-7:channel-b", "same label")
    print("different ids, same label = " + measurements.summary(measurements.add(independent_a.unwrap(), independent_b.unwrap()).unwrap()))
    mismatch = measurements.from_source(4.0, 0.2, "run-7:sample-1", "new label")
    match measurements.add(source_a.unwrap(), mismatch.unwrap()) {
        Ok(_) => print("source sigma mismatch accepted"),
        Err(message) => print("source sigma mismatch = " + message),
    }
    match measurements.from_source(1.0, 0.1, "", "label") {
        Ok(_) => print("empty source id accepted"),
        Err(message) => print("empty source id = " + message),
    }
    legacy = measurements.standard(5.0, 0.1, "legacy-source")
    explicit_legacy = measurements.from_source(6.0, 0.1, "legacy-source", "renamed label")
    print("legacy and explicit id = " + measurements.summary(measurements.sub(legacy.unwrap(), explicit_legacy.unwrap()).unwrap()))
    match measurements.uncertainties([measurements.unknown(4.0, "series offline")]) {
        Ok(_) => print("unknown series accepted"),
        Err(message) => print("unknown series = " + message),
    }
}
