fn main() -> Void {
    base = 3
    captured = spawn {
        base + 4
    }
    plain = spawn {
        3 + 4
    }
    label = "cap" + "tured"
    text_task = spawn {
        label
    }
    built_task = spawn {
        "inside" + " task"
    }
    print(captured.join())
    print(plain.join())
    print(text_task.join())
    print(built_task.join())
}
