// std.viz · lines: three damped oscillators, their envelope and a reference line.
import std.viz
import std.json

fn input_samples(fallback: Int) -> Int {
    loaded = read_file("data.json")
    if loaded.is_err() {
        return fallback
    }
    document = json.parse(loaded.unwrap())
    if document.is_err() {
        return fallback
    }
    parameters = json.object_get(document.unwrap(), "parameters")
    if parameters.is_none() {
        return fallback
    }
    value = json.object_get(parameters.unwrap(), "samples")
    if value.is_none() {
        return fallback
    }
    number = json.as_number(value.unwrap())
    if number.is_none() {
        return fallback
    }
    number.unwrap() as Int
}

fn main() -> Void {
    samples = input_samples(300)
    t = linspace(0.0, 12.0, samples)
    envelope = exp(t * -0.2)
    fig = viz.figure("Damped oscillators")
        .describe("x(t) = exp(-t/5) cos(ω t) for three frequencies")
        .labels("time t", "displacement x")
        .band(t, envelope * -1.0, envelope, label: "envelope")
        .line(t, envelope * cos(t * 1.0), label: "ω = 1")
        .line(t, envelope * cos(t * 2.0), label: "ω = 2")
        .line(t, envelope * cos(t * 3.5), label: "ω = 3.5", dash: "6 4")
        .hline(0.0)
    print(fig.svg())
}
