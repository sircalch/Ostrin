import std.measurements

fn main() -> Void {
    mut x: Measurement<Quantity<Length>> = Measurement<Quantity<Length>> {
        value: 12 m,
        sources: [Sensitivity<Quantity<Length>> {
            source_id: "caliper-a",
            label: "caliper",
            source_dimension: "Length",
            source_sigma: 0.02,
            contribution: 0.02 m
        }],
        known: true,
        reason: ""
    }
    print(x.value)
    x_uncertainty = measurements.quantity_uncertainty(x).unwrap()
    print(x_uncertainty.dimension_key)
    print(x_uncertainty.value)
    drop(x)

    exact_dimensional = Measurement<Quantity<Length>> {
        value: 0 m,
        sources: [],
        known: true,
        reason: ""
    }
    exact_uncertainty = measurements.quantity_uncertainty(exact_dimensional).unwrap()
    print(exact_uncertainty.dimension_key)
    print(exact_uncertainty.value)

    unknown_dimensional = Measurement<Quantity<Length>> {
        value: 12 m,
        sources: [],
        known: false,
        reason: "sensor offline"
    }
    match measurements.quantity_uncertainty(unknown_dimensional) {
        Ok(_) => print("unknown dimensional uncertainty accepted"),
        Err(message) => print("unknown dimensional uncertainty = " + message),
    }

    match measurements.from_quantity_source(12 m, 20 cm, "caliper-a", "caliper") {
        Ok(measured) => {
            print(measured.sources[0].source_dimension)
            print(measured.sources[0].source_sigma)
            print(measured.sources[0].contribution)
        },
        Err(_) => print("invalid quantity measurement"),
    }
    match measurements.from_quantity_source(1200 cm, 0.2 m, "caliper-a", "same caliper") {
        Ok(measured) => print(measured.sources[0].source_sigma),
        Err(_) => print("invalid quantity measurement"),
    }

    shared_a = measurements.from_quantity_source(12 m, 20 cm, "shared-caliper", "caliper").unwrap()
    shared_b = measurements.from_quantity_source(1200 cm, 0.2 m, "shared-caliper", "same caliper").unwrap()
    summed = measurements.add_quantity(shared_a, shared_b).unwrap()
    print(summed.value)
    print(summed.sources[0].contribution)
    print(summed.sources.length())
    summed_uncertainty = measurements.quantity_uncertainty(summed).unwrap()
    print(summed_uncertainty.dimension_key)
    print(summed_uncertainty.value)

    independent_a = measurements.from_quantity_source(12 m, 20 cm, "caliper-a", "same label").unwrap()
    independent_b = measurements.from_quantity_source(12 m, 20 cm, "caliper-b", "same label").unwrap()
    independent_sum = measurements.add_quantity(independent_a, independent_b).unwrap()
    print(independent_sum.sources.length())
    independent_uncertainty = measurements.quantity_uncertainty(independent_sum).unwrap()
    print(independent_uncertainty.value)

    overflowing = measurements.from_quantity_source(1 m, 1e200 m, "large-sigma", "large").unwrap()
    match measurements.quantity_uncertainty(overflowing) {
        Ok(_) => print("overflowing dimensional uncertainty accepted"),
        Err(message) => print("overflowing dimensional uncertainty = " + message),
    }

    product_a = measurements.from_quantity_source(4 m, 10 cm, "shared-length", "ruler").unwrap()
    product_b = measurements.from_quantity_source(4 m, 0.1 m, "shared-length", "same ruler").unwrap()
    product = measurements.mul_quantity(product_a, product_b).unwrap()
    print(product.value.dimension_key())
    print(product.sources[0].source_dimension)
    product_uncertainty = measurements.quantity_uncertainty(product).unwrap()
    print(product_uncertainty.dimension_key)
    print(product_uncertainty.value)

    cross_product_a = measurements.from_quantity_source(3 m, 10 cm, "length-source", "ruler").unwrap()
    cross_product_b = measurements.from_quantity_source(2 s, 0.2 s, "time-source", "clock").unwrap()
    cross_product = measurements.mul_quantity(cross_product_a, cross_product_b).unwrap()
    print(cross_product.value.dimension_key())
    print(cross_product.sources[0].contribution.value() * cross_product.sources[0].contribution.unit_scale())
    print(cross_product.sources[1].contribution.value() * cross_product.sources[1].contribution.unit_scale())
    cross_product_uncertainty = measurements.quantity_uncertainty(cross_product).unwrap()
    print(cross_product_uncertainty.value)

    ratio_a = measurements.from_quantity_source(4 m, 10 cm, "shared-length", "ruler").unwrap()
    ratio_b = measurements.from_quantity_source(400 cm, 0.1 m, "shared-length", "same ruler").unwrap()
    ratio = measurements.div_quantity_same(ratio_a, ratio_b).unwrap()
    print(ratio.value)
    print(measurements.uncertainty(ratio).unwrap())
    match measurements.div_quantity(ratio_a, ratio_b) {
        Ok(_) => print("dimensionless quotient accepted as a quantity"),
        Err(message) => print("dimensionless quantity quotient = " + message),
    }

    ratio_independent_a = measurements.from_quantity_source(4 m, 10 cm, "numerator", "ruler").unwrap()
    ratio_independent_b = measurements.from_quantity_source(400 cm, 0.1 m, "denominator", "ruler").unwrap()
    ratio_independent = measurements.div_quantity_same(ratio_independent_a, ratio_independent_b).unwrap()
    print(measurements.uncertainty(ratio_independent).unwrap())

    distance_reading = measurements.from_quantity_source(10 m, 10 cm, "distance", "distance").unwrap()
    elapsed_reading = measurements.from_quantity_source(2 s, 0.2 s, "elapsed", "elapsed").unwrap()
    measured_speed = measurements.div_quantity(distance_reading, elapsed_reading).unwrap()
    print(measured_speed.value.dimension_key())
    print(measured_speed.value.value() * measured_speed.value.unit_scale())
    print(measured_speed.sources[0].contribution.value() * measured_speed.sources[0].contribution.unit_scale())
    print(measured_speed.sources[1].contribution.value() * measured_speed.sources[1].contribution.unit_scale())
    speed_uncertainty = measurements.quantity_uncertainty(measured_speed).unwrap()
    print(speed_uncertainty.dimension_key)
    print(speed_uncertainty.value)

    zero_denominator = measurements.from_quantity_source(0 m, 10 cm, "zero", "ruler").unwrap()
    match measurements.div_quantity_same(ratio_a, zero_denominator) {
        Ok(_) => print("zero dimensional denominator accepted"),
        Err(message) => print("zero dimensional denominator = " + message),
    }

    difference_a = measurements.from_quantity_source(12 m, 20 cm, "shared-caliper", "caliper").unwrap()
    difference_b = measurements.from_quantity_source(1200 cm, 0.2 m, "shared-caliper", "same caliper").unwrap()
    difference = measurements.sub_quantity(difference_a, difference_b).unwrap()
    print(difference.value)
    print(difference.sources[0].contribution)
    difference_uncertainty = measurements.quantity_uncertainty(difference).unwrap()
    print(difference_uncertainty.value)

    mismatch_a = measurements.from_quantity_source(12 m, 20 cm, "shared-caliper", "caliper").unwrap()
    mismatch_b = measurements.from_quantity_source(12 m, 25 cm, "shared-caliper", "changed calibration").unwrap()
    match measurements.add_quantity(mismatch_a, mismatch_b) {
        Ok(_) => print("changed dimensional source sigma accepted"),
        Err(message) => print("changed dimensional source sigma = " + message),
    }

    match measurements.from_quantity_source(12 m, -20 cm, "bad-sigma", "caliper") {
        Ok(_) => print("negative dimensional sigma accepted"),
        Err(message) => print("negative dimensional sigma = " + message),
    }
    match measurements.from_quantity_source(12 m, 20 cm, "", "caliper") {
        Ok(_) => print("empty dimensional source id accepted"),
        Err(message) => print("empty dimensional source id = " + message),
    }
    match measurements.from_quantity_source(sqrt(-1.0) * 1 m, 20 cm, "nan-value", "caliper") {
        Ok(_) => print("non-finite dimensional value accepted"),
        Err(message) => print("non-finite dimensional value = " + message),
    }
    match measurements.from_quantity_source(12 m, sqrt(-1.0) * 1 cm, "nan-sigma", "caliper") {
        Ok(_) => print("non-finite dimensional sigma accepted"),
        Err(message) => print("non-finite dimensional sigma = " + message),
    }
}
