fn sum_up() -> Int {
    mut total = 0
    for i in 1 to 9 step 2 {
        total = total + i
    }
    total
}

fn sum_down() -> Int {
    mut total = 0
    for i in 8 until 0 step -2 {
        total = total + i
    }
    total
}

fn control() -> Int {
    mut total = 0
    for i in 0 to 10 step 1 {
        if i == 2 {
            continue
        }
        if i == 7 {
            break
        }
        total = total + i
    }
    total
}

fn empty() -> Int {
    mut total = 0
    for i in 1 to 5 step 0 {
        total = total + i
    }
    total
}

fn main() -> Void {
    print(sum_up())
    print(sum_down())
    print(control())
    print(empty())
}
