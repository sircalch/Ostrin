record Inner {
    text: String
}

record Outer {
    item: Option<Inner>
}

fn collect() -> List<Outer> {
    [Outer { item: Some(Inner { text: "a" }) }, Outer { item: None }]
}

fn main() -> Void {
    for row in collect() {
        match row.item {
            Some(inner) => print(inner.text),
            None => print("none")
        }
    }
}
