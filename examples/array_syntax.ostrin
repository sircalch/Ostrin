fn main() -> Void {
    a = array([[1.0, 2.0], [3.0, 4.0]])
    b = array([[0.0, 1.0], [1.0, 0.0]])
    print(a @ b)
    print(a @ b @ a)
    print(a.transpose() @ a)

    v = array([3.0, -1.0, 4.0, -1.0, 5.0, -9.0, 2.0, 6.0])
    positive = v > 0.0
    print(positive)
    print(positive.count_true())
    print(positive.any())
    print(positive.all())
    print(v[positive])
    print(v[v > 4.0])
    print(v[2 until 5])
    print(v[0 to 2])
    print(where(v < 0.0, 0.0, v))
    print(where(positive, v * 2.0, -v))
    print(not positive)
    print(positive and (v < 5.0))
    print((v > 2.0) or (v < -5.0))
    print(v == v)

    grid = array([[1, 2, 3], [4, 5, 6]])
    print(grid.row(1))
    print(grid.col(2))
    print(grid > 2)
    print(grid[grid > 2])
    print(grid * 2 >= 6)

    clipped = where(v > 5.0, 5.0, where(v < -5.0, -5.0, v))
    print(clipped)
    print(clipped.sum())
}
