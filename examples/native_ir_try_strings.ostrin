fn succeed() -> Result<String, String> {
    Ok("value".to_upper())
}

fn fail() -> Result<String, String> {
    Err("failure".to_upper())
}

fn extract() -> Result<String, String> {
    value = try succeed()
    Ok(value + "!")
}

fn propagate() -> Result<String, String> {
    value = try fail()
    Ok(value)
}

fn recover() -> Result<String, String> {
    value = try fail() catch fn(error) { "recovered: " + error }
    Ok(value)
}

fn main() -> Void {
    match extract() {
        Ok(value) => print(value),
        Err(error) => print(error),
    }
    print(propagate().is_err())
    match recover() {
        Ok(value) => print(value),
        Err(error) => print(error),
    }
}
