// Scientific Lab · ODE
// A damped, driven pendulum solved with adaptive RK45 from std.numeric and
// animated by std.viz: the pendulum on the left, its phase portrait on the right.
import std.numeric
import std.viz

fn main() -> Void {
    damping = 0.15
    drive = 1.1
    start_angle = 0.2
    seconds = 40.0
    sol = numeric.rk45(fn(t, y) { array([y[1], 0.0 - damping * y[1] - sin(y[0]) + drive * cos(0.8 * t)]) }, array([start_angle, 0.0]), 0.0, seconds, tol: 1e-8)
    print("steps " + sol.length().to_string() + ", final angle " + viz.num(sol.final_state()[0]))
    // 25 samples per simulated second, played at double speed.
    t = linspace(0.0, seconds, 1001)
    theta = numeric.interp_all(sol.t, sol.component(0), t)
    omega = numeric.interp_all(sol.t, sol.component(1), t)
    bob_x = sin(theta)
    bob_y = cos(theta) * -1.0
    pendulum = viz.figure("Pendulum").size(360, 380).xlim(-1.3, 1.3).ylim(-1.3, 1.3).no_legend().no_axes()
        .animate(seconds / 2.0)
        .rod(0.0, 0.0, bob_x, bob_y, color: "#475569", width: 3.0)
        .moving_point(bob_x, bob_y, color: "#7c3aed", size: 11.0, trail: false)
        .scatter(array([0.0]), array([0.0]), size: 4.0, color: "#0f172a")
    phase = viz.figure("Phase portrait").size(480, 380).labels("θ [rad]", "ω [rad/s]").no_legend()
        .animate(seconds / 2.0)
        .line(theta, omega, color: "#e9d5ff", width: 1.0)
        .moving_point(theta, omega, color: "#7c3aed", size: 5.0)
    print(viz.grid([pendulum.svg(), phase.svg()], 2, 420, 380))
}
