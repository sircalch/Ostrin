fn classify(n: Int) -> Int {
    if n < 0 {
        -1
    } else if n == 0 {
        0
    } else {
        1
    }
}

fn sum_to(n: Int) -> Int {
    mut i = 0
    mut total = 0
    while i <= n {
        total = total + i
        i = i + 1
    }
    total
}

fn main() -> Void {
    print(classify(-2))
    print(classify(0))
    print(classify(4))
    print(sum_to(5))
}
