// The exit status follows the type of main. A Result<Int, String> main that returns Err prints
// "error: <message>" to stderr and exits with status 1; Ok(n) exits with n (low 8 bits).
fn check(n: Int) -> Result<Int, String> {
    if n > 2 {
        return Err("value too large")
    }
    Ok(n)
}

fn main() -> Result<Int, String> {
    print("start")
    v = check(7)
    match v {
        Ok(x) => print(x),
        Err(message) => {
            return Err(message)
        },
    }
    Ok(0)
}
