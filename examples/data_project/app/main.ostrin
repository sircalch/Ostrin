import tables.table

fn main() -> Void {
    data = "ciudad,temp\nLima,21.5\nCusco,12.0\nLima,23.5\nCusco,10.0\nQuito,15.5\n"
    t = table.table_from_csv(data)
    print(table.table_rows(t))
    table.describe(t, "temp")
    lima = table.filter_rows(t, "ciudad", "Lima")
    print(table.table_rows(lima))
    table.describe(lima, "temp")

    cities = table.unique(t, "ciudad")
    means = table.group_mean(t, "ciudad", "temp")
    counts = table.group_count(t, "ciudad")
    for i in 0 until cities.length() {
        print(cities[i] + ": n=" + counts[i].to_string() + " media=" + means[i].to_string())
    }
    print(table.table_rows(table.head(t, 2)))
}
