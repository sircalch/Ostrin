// std.measurements · bounded covariance propagation for scalar source graphs.
import std.measurements

fn rounded(value: Float) -> Float {
    round(value * 10000.0) / 10000.0
}

fn main() -> Void {
    correlated = measurements.covariance(
        ["caliper", "reference"],
        array([
            [4.0, 1.0],
            [1.0, 1.0]
        ])
    ).unwrap()
    caliper = measurements.from_source(10.0, 2.0, "caliper", "caliper")
    reference = measurements.from_source(4.0, 1.0, "reference", "reference")
    total = measurements.add(caliper.unwrap(), reference.unwrap()).unwrap()
    difference = measurements.sub(caliper.unwrap(), reference.unwrap()).unwrap()
    print("correlated sum variance = " + rounded(measurements.variance_with_covariance(total, correlated).unwrap()).to_string())
    print("correlated sum uncertainty = " + rounded(measurements.uncertainty_with_covariance(total, correlated).unwrap()).to_string())
    print("correlated difference variance = " + rounded(measurements.variance_with_covariance(difference, correlated).unwrap()).to_string())
    print("correlated difference uncertainty = " + rounded(measurements.uncertainty_with_covariance(difference, correlated).unwrap()).to_string())
    doubled = measurements.scale(total, 2.0)
    print("scaled correlated variance = " + rounded(measurements.variance_with_covariance(doubled, correlated).unwrap()).to_string())

    near_symmetric = measurements.covariance(
        ["caliper", "reference"],
        array([
            [4.0, 1.0000000000001],
            [1.0, 1.0]
        ])
    ).unwrap()
    print("within-tolerance symmetric variance = " + rounded(measurements.variance_with_covariance(total, near_symmetric).unwrap()).to_string())

    independent = measurements.covariance(
        ["caliper", "reference"],
        array([
            [4.0, 0.0],
            [0.0, 1.0]
        ])
    ).unwrap()
    print("independent sum uncertainty = " + rounded(measurements.uncertainty_with_covariance(total, independent).unwrap()).to_string())

    rank_deficient = measurements.covariance(
        ["shared-a", "shared-b"],
        array([
            [1.0, 1.0],
            [1.0, 1.0]
        ])
    ).unwrap()
    shared_a = measurements.from_source(3.0, 1.0, "shared-a", "same source")
    shared_b = measurements.from_source(5.0, 1.0, "shared-b", "same source")
    cancelled = measurements.sub(shared_a.unwrap(), shared_b.unwrap()).unwrap()
    print("rank-deficient cancellation uncertainty = " + rounded(measurements.uncertainty_with_covariance(cancelled, rank_deficient).unwrap()).to_string())

    match measurements.covariance(["caliper", "reference"], array([[1.0, 2.0], [2.0, 1.0]])) {
        Ok(_) => print("indefinite covariance accepted"),
        Err(message) => print("indefinite covariance = " + message),
    }
    match measurements.covariance(["caliper", "reference"], array([[1.0, 0.5], [0.25, 1.0]])) {
        Ok(_) => print("nonsymmetric covariance accepted"),
        Err(message) => print("nonsymmetric covariance = " + message),
    }
    match measurements.covariance(["caliper", "caliper"], array([[1.0, 0.0], [0.0, 1.0]])) {
        Ok(_) => print("duplicate covariance id accepted"),
        Err(message) => print("duplicate covariance id = " + message),
    }
    match measurements.covariance(["caliper", "reference"], array([[sqrt(-1.0), 0.0], [0.0, 1.0]])) {
        Ok(_) => print("non-finite covariance accepted"),
        Err(message) => print("non-finite covariance = " + message),
    }
    match measurements.covariance(["bad"], array([[-1.0]]), 1.0) {
        Ok(_) => print("excessive covariance tolerance accepted an indefinite matrix"),
        Err(message) => print("excessive covariance tolerance = " + message),
    }
    mismatch = measurements.covariance(["caliper", "reference"], array([[9.0, 1.0], [1.0, 1.0]])).unwrap()
    match measurements.uncertainty_with_covariance(total, mismatch) {
        Ok(_) => print("source variance mismatch accepted"),
        Err(message) => print("source variance mismatch = " + message),
    }
    missing = measurements.covariance(["caliper"], array([[4.0]])).unwrap()
    match measurements.variance_with_covariance(total, missing) {
        Ok(_) => print("missing source accepted"),
        Err(message) => print("missing source = " + message),
    }
    unknown = measurements.unknown(1.0, "sensor offline")
    match measurements.variance_with_covariance(unknown, correlated) {
        Ok(_) => print("unknown uncertainty accepted"),
        Err(message) => print("unknown uncertainty = " + message),
    }
}
