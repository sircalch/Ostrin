fn succeed() -> Result<String, String> {
    Ok("value".to_upper())
}

fn fail() -> Result<String, String> {
    Err("failure".to_upper())
}

fn make_recover(prefix: String) -> fn(String) -> String {
    fn(error) { prefix + error }
}

fn success() -> Result<String, String> {
    handler = make_recover("handled: ")
    value = try succeed() catch handler
    Ok(value + "!")
}

fn failure() -> Result<String, String> {
    handler = make_recover("handled: ")
    value = try fail() catch handler
    Ok(value)
}

fn main() -> Void {
    match success() {
        Ok(value) => print(value),
        Err(error) => print(error),
    }
    match failure() {
        Ok(value) => print(value),
        Err(error) => print(error),
    }
}
