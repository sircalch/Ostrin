// std.viz · grouped boxplots: distribution summaries computed by Ostrin.
import std.json
import std.viz

fn input_int(key: String, fallback: Int) -> Int {
    loaded = read_file("data.json")
    if loaded.is_err() {
        return fallback
    }
    document = json.parse(loaded.unwrap())
    if document.is_err() {
        return fallback
    }
    value = json.object_get(document.unwrap(), key)
    if value.is_none() {
        return fallback
    }
    number = json.as_number(value.unwrap())
    if number.is_none() {
        return fallback
    }
    number.unwrap() as Int
}

fn input_parameter_int(key: String, fallback: Int) -> Int {
    loaded = read_file("data.json")
    if loaded.is_err() {
        return fallback
    }
    document = json.parse(loaded.unwrap())
    if document.is_err() {
        return fallback
    }
    parameters = json.object_get(document.unwrap(), "parameters")
    if parameters.is_none() {
        return fallback
    }
    value = json.object_get(parameters.unwrap(), key)
    if value.is_none() {
        return fallback
    }
    number = json.as_number(value.unwrap())
    if number.is_none() {
        return fallback
    }
    number.unwrap() as Int
}

fn main() -> Void {
    seed = input_int("seed", 41)
    samples_per_group = input_parameter_int("samples_per_group", 80)
    r = rng(seed)
    control = r.randn([samples_per_group]) * 0.55 + 4.2
    treatment = r.randn([samples_per_group]) * 0.8 + 5.3
    follow_up = r.randn([samples_per_group]) * 0.4 + 6.1
    fig = viz.figure("Distribution summary")
        .describe("median, interquartile range, whiskers")
        .labels("cohort", "response")
        .boxplot(1.0, control, label: "control", color: "#2563eb")
        .boxplot(2.0, treatment, label: "treatment", color: "#db2777")
        .boxplot(3.0, follow_up, label: "follow-up", color: "#059669")
    print(fig.svg())
}
