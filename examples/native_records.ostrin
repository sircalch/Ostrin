record Point {
    mut x: Int
    mut y: Int
}

record Line {
    start: Point
    end: Point
}

fn manhattan_length(line: Line) -> Int {
    line.end.x - line.start.x + (line.end.y - line.start.y)
}

fn main() -> Void {
    mut p = Point { x: 1, y: 2 }
    p.x = p.x + 10
    print(p.x)
    print(p.y)

    line = Line { start: Point { x: 0, y: 0 }, end: p }
    print(manhattan_length(line))
}
