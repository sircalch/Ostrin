// Determinante, inversa, traza e identidad; comprobación A * inv(A) = I.
fn main() -> Void {
    a = array([[4.0, 7.0, 2.0], [3.0, 6.0, 1.0], [2.0, 5.0, 3.0]])
    print(det(a))
    print(trace(a))
    ai = inv(a)
    print(ai)
    check = a @ ai
    print(check)
    print(eye(3))
    print(det(eye(4)))
    swapped = array([[0.0, 1.0], [1.0, 0.0]])
    print(det(swapped))
    print(inv(swapped))
    singular = array([[1.0, 2.0], [2.0, 4.0]])
    print(det(singular))
    b = array([1.0, 2.0, 3.0])
    print(solve(a, b))
}
