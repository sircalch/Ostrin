fn main() -> Void {
    spawn_scope {
        values = [1]
        first = spawn {
            print("started")
            print(values.length())
            yield()
            print("must-not-run")
        }

        controller = spawn {
            print(first.cancel())
        }

        yield()
        print("controller-finished")
        print(first.cancel())
    }
}
