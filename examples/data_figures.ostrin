// Scientific figures from computed data: the measurements with their linear and quadratic fits, the residuals of
// the quadratic, and the table behind both figures. Every plotted value is computed here from the file, by the
// same code as examples/data_engine.ostrin; nothing is stored in advance.
//
// Run from the examples directory:  cd examples && ostrinc --run data_figures.ostrin
// It writes data/figures/calibration_fit.svg, data/figures/calibration_residuals.svg and
// data/figures/calibration_table.csv.
import std.data
import std.viz

fn main() -> Void {
    text = match read_file("data/calibration.csv") {
        Ok(contents) => contents,
        Err(message) => {
            print("cannot read the experiment: " + message)
            return
        },
    }
    names = ["run", "operator", "temperature_c", "pressure_kpa", "response"]
    kinds = ["int", "text", "float", "float", "float"]
    table = match data.read_table(text, ",", names, kinds) {
        Ok(t) => t,
        Err(message) => {
            print("invalid experiment: " + message)
            return
        },
    }
    temperature = match data.floats(table, "temperature_c") {
        Ok(t) => t,
        Err(message) => {
            print("error: " + message)
            return
        },
    }
    response = match data.floats(table, "response") {
        Ok(r) => r,
        Err(message) => {
            print("error: " + message)
            return
        },
    }
    linear = match data.fit_polynomial(temperature, response, 1) {
        Ok(f) => f,
        Err(message) => {
            print("error: " + message)
            return
        },
    }
    quadratic = match data.fit_polynomial(temperature, response, 2) {
        Ok(f) => f,
        Err(message) => {
            print("error: " + message)
            return
        },
    }

    // The curves are evaluated on a grid across the measured range, from the fitted polynomial itself.
    low = data.describe(temperature).unwrap().min
    high = data.describe(temperature).unwrap().max
    grid = linspace(low, high, 101)
    linear_curve = data.predict_all(linear, grid)
    quadratic_curve = data.predict_all(quadratic, grid)

    fit_figure = viz.figure("Calibration: response against temperature")
        .describe("36 measurements, a linear and a quadratic least-squares fit (QR), from examples/data/calibration.csv")
        .labels("temperature / deg C", "response")
        .scatter(temperature, response, label: "measurements")
        .line(grid, linear_curve, label: "linear fit", dash: "6 4")
        .line(grid, quadratic_curve, label: "quadratic fit")
    print("fit figure: " + fit_figure.svg().length().to_string() + " characters of SVG")
    match fit_figure.save("data/figures/calibration_fit.svg") {
        Ok(_) => print("wrote data/figures/calibration_fit.svg"),
        Err(message) => print("cannot write the fit figure: " + message),
    }

    residual_figure = viz.figure("Residuals of the quadratic fit")
        .describe("observed minus fitted response, one point per measurement")
        .labels("temperature / deg C", "residual")
        .scatter(temperature, quadratic.residuals, label: "residuals")
        .hline(0.0, label: "zero")
    match residual_figure.save("data/figures/calibration_residuals.svg") {
        Ok(_) => print("wrote data/figures/calibration_residuals.svg"),
        Err(message) => print("cannot write the residual figure: " + message),
    }

    // The numbers behind both figures, as a table with the same rows.
    table_out = data.fit_table(temperature, response, quadratic, "temperature_c", "response")
    match write_file("data/figures/calibration_table.csv", data.table_text(table_out, ",")) {
        Ok(_) => print("wrote data/figures/calibration_table.csv with " + table_out.rows.to_string() + " rows"),
        Err(message) => print("cannot write the table: " + message),
    }
    print("quadratic residual sum: " + sum_of(quadratic.residuals).to_string())
}

fn sum_of(values: Array<Float>) -> Float {
    mut total = 0.0
    for i in 0 until values.length() {
        total = total + values[i]
    }
    total
}
