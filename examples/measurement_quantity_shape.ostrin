import std.measurements

fn wrap<D: Dimension>(value: Quantity<D>) -> Measurement<Quantity<D>> {
    Measurement<Quantity<D>> {
        value: value,
        sources: [],
        known: true,
        reason: "",
    }
}

fn main() -> Void {
    measured = wrap(12.0 m)
    print(measured.value)
    print(measured.known)
}
