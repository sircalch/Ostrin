// std.viz · kernel-density violins: full distributions with median markers.
import std.viz

fn main() -> Void {
    r = rng(73)
    baseline = r.randn([140]) * 0.42 + 4.2
    shifted = r.randn([140]) * 0.75 + 5.25
    bimodal = zeros([140])
    for i in 0 until 140 {
        center = if i < 70 { 5.2 } else { 6.1 }
        spread = if i < 70 { 0.28 } else { 0.18 }
        bimodal.set(i, r.randn([1])[0] * spread + center)
    }
    fig = viz.figure("Distribution shapes")
        .describe("Gaussian KDE violins with medians computed in Ostrin")
        .labels("cohort", "response")
        .violin(1.0, baseline, 40, "baseline", "#2563eb")
        .violin(2.0, shifted, 40, "shifted", "#db2777")
        .violin(3.0, bimodal, 40, "bimodal", "#059669")
    print(fig.svg())
}
