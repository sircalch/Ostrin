// Scientific Lab · Measurements
// Source identity carries correlation through dimensional products and ratios.
import std.measurements

fn rounded(value: Float) -> Float {
    round(value * 10000.0) / 10000.0
}

fn main() -> Void {
    exact_zero = measurements.exact_quantity(0 m).unwrap()
    print("exact zero uncertainty (m) = " + measurements.quantity_uncertainty(exact_zero).unwrap().value.to_string())

    pending_reading = measurements.unknown_quantity(12 m, "sensor offline").unwrap()
    print("unknown reading = " + pending_reading.reason)

    ruler_a = measurements.from_quantity_source(4 m, 10 cm, "shared-ruler", "ruler reading A").unwrap()
    ruler_b = measurements.from_quantity_source(4 m, 10 cm, "shared-ruler", "ruler reading B").unwrap()

    combined = measurements.add_quantity(ruler_a, ruler_b).unwrap()
    combined_u = measurements.quantity_uncertainty(combined).unwrap()
    print("shared readings")
    print(combined.value)
    print("standard uncertainty (m) = " + combined_u.value.to_string())

    area = measurements.mul_quantity(ruler_a, ruler_b).unwrap()
    area_u = measurements.quantity_uncertainty(area).unwrap()
    print("product dimension = " + area.value.dimension_key())
    print("product contribution")
    print(area.sources[0].contribution)
    print("product standard uncertainty = " + area_u.value.to_string())

    ratio = measurements.div_quantity_same(ruler_a, ruler_b).unwrap()
    print("same-source ratio = " + measurements.summary(ratio))

    distance = measurements.from_quantity_source(10 m, 10 cm, "distance", "distance").unwrap()
    elapsed = measurements.from_quantity_source(2 s, 0.2 s, "elapsed", "elapsed").unwrap()
    speed = measurements.div_quantity(distance, elapsed).unwrap()
    speed_u = measurements.quantity_uncertainty(speed).unwrap()
    print("cross-dimension ratio = " + speed.value.to_string())
    print("speed dimension = " + speed.value.dimension_key())
    print("speed standard uncertainty (m/s) = " + speed_u.value.to_string())

    caliper = measurements.from_source(10.0, 2.0, "caliper", "caliper").unwrap()
    reference = measurements.from_source(4.0, 1.0, "reference", "reference").unwrap()
    source_covariance = measurements.covariance(
        ["caliper", "reference"],
        array([
            [4.0, 1.0],
            [1.0, 1.0]
        ])
    ).unwrap()
    scalar_sum = measurements.add(caliper, reference).unwrap()
    print("dimensionless scalar covariance")
    print("sum variance = " + measurements.variance_with_covariance(scalar_sum, source_covariance).unwrap().to_string())
    print("sum uncertainty = " + rounded(measurements.uncertainty_with_covariance(scalar_sum, source_covariance).unwrap()).to_string())

    measured_length = measurements.from_quantity_source(2 m, 0.1 m, "length-source", "length reading").unwrap()
    measured_time = measurements.from_quantity_source(3 s, 0.2 s, "time-source", "time reading").unwrap()
    measured_product = measurements.mul_quantity(measured_length, measured_time).unwrap()
    product_correlation = measurements.source_correlation(
        ["length-source", "time-source"],
        array([
            [1.0, 0.5],
            [0.5, 1.0]
        ])
    ).unwrap()
    correlated_product_u = measurements.quantity_uncertainty_with_correlation(measured_product, product_correlation).unwrap()
    print("dimensioned source correlation")
    print("product dimension = " + measured_product.value.dimension_key())
    print("product standard uncertainty = " + correlated_product_u.value.to_string())

    invalid_correlation = measurements.source_correlation(
        ["length-source", "time-source"],
        array([
            [1.0, 0.2],
            [0.2, 0.9]
        ])
    )
    match invalid_correlation {
        Ok(_) => print("invalid correlation diagonal = accepted"),
        Err(message) => print("invalid correlation diagonal = " + message),
    }

    incomplete_correlation = measurements.source_correlation(["length-source"], array([[1.0]])).unwrap()
    match measurements.quantity_uncertainty_with_correlation(measured_product, incomplete_correlation) {
        Ok(_) => print("missing correlation source = accepted"),
        Err(message) => print("missing correlation source = " + message),
    }
}
