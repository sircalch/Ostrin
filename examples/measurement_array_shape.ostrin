import std.measurements

record MeasurementBox {
    mut values: Array<Measurement<Float>>
}

fn forward(values: Array<Measurement<Float>>) -> Array<Measurement<Float>> {
    values
}

fn choose(flag: Bool, left: Array<Measurement<Float>>, right: Array<Measurement<Float>>) -> Array<Measurement<Float>> {
    if flag { left } else { right }
}

fn loop_alias(values: Array<Measurement<Float>>) -> Array<Measurement<Float>> {
    mut current = clone(values)
    mut i = 0
    while i < 2 {
        current = clone(current)
        i = i + 1
    }
    current
}

fn main() -> Void {
    values: Array<Measurement<Float>> = array([
        measurements.exact(2.0),
        measurements.exact(3.0)
    ])
    print(values.length())
    print(measurements.summary(values[0]))
    print(measurements.summary(values.get(1)))
    print(values[0 until 1].length())
    print(values.to_list().length())
    forwarded = forward(clone(values))
    mut box = MeasurementBox { values: forwarded }
    box.values = clone(values)
    selected = choose(true, clone(box.values), clone(values))
    print(loop_alias(selected).length())
}
