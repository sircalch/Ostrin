// std.polynomial integer content, primitive part and squarefree part: 40 generated integer
// polynomials, each put through poly_content, poly_primitive and poly_squarefree, plus fixed edge
// cases. The inputs come from a Park-Miller generator (seed 11) so scripts/polynomial-factor-oracle.mjs
// can regenerate the same cases in BigInt arithmetic and print the same rows; the two outputs are
// compared line by line.
import std.polynomial

fn next_state(s: Int) -> Int {
    (s * 16807) % 2147483647
}

/// A value in lo..=hi from a generator state.
fn draw(s: Int, lo: Int, hi: Int) -> Int {
    lo + s % (hi - lo + 1)
}

fn int_mul(a: List<Int>, b: List<Int>) -> List<Int> {
    mut out: List<Int> = []
    for k in 0 until a.length() + b.length() - 1 {
        mut acc = 0
        for i in 0 until a.length() {
            j = k - i
            if j >= 0 and j < b.length() {
                acc = acc + a[i] * b[j]
            }
        }
        out.push(acc)
    }
    out
}

fn row(idx: Int, label: String, text: String) -> Void {
    print("case " + idx.to_string() + " " + label + " " + text)
}

fn main() -> Void {
    mut state = 11
    for idx in 0 until 40 {
        state = next_state(state)
        mode = draw(state, 0, 2)
        mut p_list: List<Int> = []
        if mode == 2 {
            // square of a random polynomial of degree 1..3: repeated factors, degree 2..6
            state = next_state(state)
            dr = 1 + draw(state, 0, 2)
            mut r_list: List<Int> = []
            for i in 0 until dr + 1 {
                state = next_state(state)
                mut c = draw(state, 0 - 12, 12)
                if i == dr and c == 0 {
                    c = 1
                }
                r_list.push(c)
            }
            p_list = int_mul(r_list, r_list)
        } else {
            // random polynomial of degree 1..6
            state = next_state(state)
            d = 1 + draw(state, 0, 5)
            for i in 0 until d + 1 {
                state = next_state(state)
                mut c = draw(state, 0 - 12, 12)
                if i == d and c == 0 {
                    c = 1
                }
                p_list.push(c)
            }
        }

        p = polynomial.poly_from_ints(p_list)
        row(idx, "p", polynomial.poly_to_string(p))
        match polynomial.poly_content(p) {
            Ok(text) => row(idx, "content", text),
            Err(message) => row(idx, "content", "error " + message),
        }
        match polynomial.poly_primitive(p) {
            Ok(q) => row(idx, "primitive", polynomial.poly_to_string(q)),
            Err(message) => row(idx, "primitive", "error " + message),
        }
        match polynomial.poly_squarefree(p) {
            Ok(q) => row(idx, "squarefree", polynomial.poly_to_string(q)),
            Err(message) => row(idx, "squarefree", "error " + message),
        }
    }

    // Fixed edge cases.
    zero = polynomial.poly_from_ints([])
    match polynomial.poly_content(zero) {
        Ok(text) => row(0 - 1, "zero-content", text),
        Err(message) => row(0 - 1, "zero-content", "error " + message),
    }
    match polynomial.poly_primitive(zero) {
        Ok(q) => row(0 - 1, "zero-primitive", polynomial.poly_to_string(q)),
        Err(message) => row(0 - 1, "zero-primitive", "error " + message),
    }
    match polynomial.poly_squarefree(zero) {
        Ok(q) => row(0 - 1, "zero-squarefree", polynomial.poly_to_string(q)),
        Err(message) => row(0 - 1, "zero-squarefree", "error " + message),
    }
    half = polynomial.poly_from_texts(["1/2", "1"]).unwrap()
    match polynomial.poly_content(half) {
        Ok(text) => row(0 - 1, "rational-content", text),
        Err(message) => row(0 - 1, "rational-content", "error " + message),
    }
    match polynomial.poly_primitive(half) {
        Ok(q) => row(0 - 1, "rational-primitive", polynomial.poly_to_string(q)),
        Err(message) => row(0 - 1, "rational-primitive", "error " + message),
    }
    square_quarter = polynomial.poly_from_texts(["1/4", "1", "1"]).unwrap()
    match polynomial.poly_squarefree(square_quarter) {
        Ok(q) => row(0 - 1, "rational-squarefree", polynomial.poly_to_string(q)),
        Err(message) => row(0 - 1, "rational-squarefree", "error " + message),
    }
    match polynomial.poly_primitive(polynomial.poly_from_ints([0 - 4, 0 - 6])) {
        Ok(q) => row(0 - 1, "negative-primitive", polynomial.poly_to_string(q)),
        Err(message) => row(0 - 1, "negative-primitive", "error " + message),
    }
    match polynomial.poly_squarefree(polynomial.poly_from_ints([0 - 6])) {
        Ok(q) => row(0 - 1, "constant-squarefree", polynomial.poly_to_string(q)),
        Err(message) => row(0 - 1, "constant-squarefree", "error " + message),
    }
    huge = polynomial.poly_from_texts(["123456789012345678901234567890", "123456789012345678901234567890000"]).unwrap()
    match polynomial.poly_content(huge) {
        Ok(text) => row(0 - 1, "huge-content", text),
        Err(message) => row(0 - 1, "huge-content", "error " + message),
    }
    match polynomial.poly_primitive(huge) {
        Ok(q) => row(0 - 1, "huge-primitive", polynomial.poly_to_string(q)),
        Err(message) => row(0 - 1, "huge-primitive", "error " + message),
    }
    cubic = polynomial.poly_from_ints([2, 0 - 3, 0, 1])
    match polynomial.poly_squarefree(cubic) {
        Ok(q) => row(0 - 1, "cubic-squarefree", polynomial.poly_to_string(q)),
        Err(message) => row(0 - 1, "cubic-squarefree", "error " + message),
    }
}
