// The numeric bridge of the symbolic module: samples, counterexamples and derivative checks.
//
// The symbolic results are compared with numbers that do not come from the symbolic code. Derivatives are checked
// against central differences of the expression evaluated at points. An identity is tested at many points, and a
// claimed identity that is false gives counterexamples. A point where the expression cannot be evaluated (1/x at 0)
// fails the sample with a message rather than returning a number. The sampled values are plotted with std.viz.
import std.symbolic
import std.viz

fn main() -> Void {
    s = symbolic.store()
    x = symbolic.symbol(s, "x")
    two = symbolic.number(s, 2)
    three = symbolic.number(s, 3)
    mut failures = 0
    xs = linspace(0.0 - 2.0, 2.0, 41)

    // 1. Symbolic derivatives agree with central differences (step 1e-6, relative tolerance 1e-6).
    cubic = symbolic.add(symbolic.power(x, three), symbolic.add(symbolic.mul(symbolic.number(s, 0 - 2), x), symbolic.number(s, 1)))
    match symbolic.derivative_mismatches(cubic, x, xs, 0.000001, 0.000001) {
        Ok(points) => {
            print("derivative of x^3 - 2x + 1: " + points.length().to_string() + " mismatched points")
            if points.length() > 0 {
                print("FAIL derivative of x^3 - 2x + 1 mismatches at " + points[0].to_string())
                failures = failures + 1
            }
        },
        Err(message) => {
            print("FAIL derivative: " + message)
            failures = failures + 1
        },
    }
    product = symbolic.mul(symbolic.call("sin", x), symbolic.call("exp", x))
    match symbolic.derivative_mismatches(product, x, xs, 0.000001, 0.000001) {
        Ok(points) => {
            print("derivative of sin(x) exp(x): " + points.length().to_string() + " mismatched points")
            if points.length() > 0 {
                print("FAIL derivative of sin(x) exp(x)")
                failures = failures + 1
            }
        },
        Err(message) => {
            print("FAIL derivative: " + message)
            failures = failures + 1
        },
    }
    squared_cos = symbolic.call("cos", symbolic.power(x, two))
    match symbolic.derivative_mismatches(squared_cos, x, xs, 0.000001, 0.000001) {
        Ok(points) => {
            print("derivative of cos(x^2): " + points.length().to_string() + " mismatched points")
            if points.length() > 0 {
                print("FAIL derivative of cos(x^2)")
                failures = failures + 1
            }
        },
        Err(message) => {
            print("FAIL derivative: " + message)
            failures = failures + 1
        },
    }

    // A wrong derivative is caught: d/dx of x^3 is 3x^2, so 3x^2 + 1 must disagree everywhere.
    wrong = symbolic.add(symbolic.mul(three, symbolic.power(x, two)), symbolic.number(s, 1))
    match symbolic.disagreements(symbolic.diff(symbolic.power(x, three), x).unwrap(), wrong, x, xs, 0.000001) {
        Ok(points) => {
            if points.length() != 41 {
                print("FAIL a wrong derivative was not caught at every point: " + points.length().to_string())
                failures = failures + 1
            } else {
                print("wrong derivative 3x^2 + 1 disagrees at all 41 points")
            }
        },
        Err(message) => {
            print("FAIL disagreements: " + message)
            failures = failures + 1
        },
    }

    // 2. Identities: a true one has no counterexample, a false one has some.
    square_plus = symbolic.power(symbolic.add(x, symbolic.number(s, 1)), two)
    expanded = symbolic.add(symbolic.power(x, two), symbolic.add(symbolic.mul(two, x), symbolic.number(s, 1)))
    match symbolic.disagreements(square_plus, expanded, x, xs, 0.000000000001) {
        Ok(points) => {
            print("(x + 1)^2 = x^2 + 2x + 1: " + points.length().to_string() + " counterexamples")
            if points.length() > 0 {
                print("FAIL a true identity has a counterexample at " + points[0].to_string())
                failures = failures + 1
            }
        },
        Err(message) => {
            print("FAIL identity: " + message)
            failures = failures + 1
        },
    }
    pythagorean = symbolic.add(symbolic.power(symbolic.call("sin", x), two), symbolic.power(symbolic.call("cos", x), two))
    match symbolic.disagreements(pythagorean, symbolic.number(s, 1), x, xs, 0.000000000001) {
        Ok(points) => {
            print("sin^2 + cos^2 = 1: " + points.length().to_string() + " counterexamples")
            if points.length() > 0 {
                print("FAIL sin^2 + cos^2 = 1 at " + points[0].to_string())
                failures = failures + 1
            }
        },
        Err(message) => {
            print("FAIL identity: " + message)
            failures = failures + 1
        },
    }
    false_identity = symbolic.add(symbolic.power(x, two), symbolic.number(s, 1))
    match symbolic.disagreements(square_plus, false_identity, x, xs, 0.000000000001) {
        Ok(points) => {
            print("(x + 1)^2 = x^2 + 1: " + points.length().to_string() + " counterexamples")
            if points.length() == 0 {
                print("FAIL a false identity had no counterexample")
                failures = failures + 1
            }
        },
        Err(message) => {
            print("FAIL identity: " + message)
            failures = failures + 1
        },
    }

    // 3. A point that cannot be evaluated fails the sample, and the message names the point.
    inverse = symbolic.power(x, symbolic.number(s, 0 - 1))
    holes = linspace(0.0 - 1.0, 1.0, 3)
    match symbolic.sample(inverse, x, holes) {
        Ok(values) => {
            print("FAIL 1/x sampled through 0 returned " + values.length().to_string() + " values")
            failures = failures + 1
        },
        Err(message) => {
            print("1/x through 0 fails: " + message)
            if not message.contains("division by zero") {
                print("FAIL the message does not name the division by zero")
                failures = failures + 1
            }
        },
    }

    // 4. Other symbols have no value in a sample and fail it.
    y = symbolic.symbol(s, "y")
    match symbolic.sample(symbolic.add(x, y), x, xs) {
        Ok(values) => {
            print("FAIL a sample with a free symbol returned " + values.length().to_string() + " values")
            failures = failures + 1
        },
        Err(message) => {
            print("x + y with y free fails: " + message)
        },
    }

    // 5. The visual bridge: the sampled values of the cubic are plotted; the figure is an SVG.
    match symbolic.sample(cubic, x, xs) {
        Ok(values) => {
            fig = viz.figure("x^3 - 2x + 1 from its sampled values")
                .labels("x", "p(x)")
                .line(xs, values, label: "p(x)")
                .hline(0.0)
            svg = fig.svg()
            print("figure of the sampled cubic is svg: " + svg.starts_with("<svg").to_string())
            if not svg.starts_with("<svg") {
                failures = failures + 1
            }
        },
        Err(message) => {
            print("FAIL sample for the figure: " + message)
            failures = failures + 1
        },
    }

    // 6. Steps that are too small (rounding) or too large (truncation) are refused, not reported as agreement.
    match symbolic.derivative_mismatches(cubic, x, xs, 0.0000000000000001, 0.000001) {
        Ok(points) => {
            print("FAIL a step of 1e-16 was accepted with " + points.length().to_string() + " mismatches")
            failures = failures + 1
        },
        Err(message) => {
            print("step 1e-16 is refused: " + message)
        },
    }
    match symbolic.derivative_mismatches(squared_cos, x, xs, 1.0, 0.000001) {
        Ok(points) => {
            print("FAIL a step of 1 was accepted with " + points.length().to_string() + " mismatches")
            failures = failures + 1
        },
        Err(message) => {
            print("step 1 is refused for cos(x^2): " + message)
        },
    }

    // 7. A value that is not finite is never reported as agreement: exp(1000) overflows, so the point is a mismatch.
    overflow = linspace(1000.0, 1000.0, 1)
    match symbolic.disagreements(symbolic.call("exp", x), symbolic.call("exp", x), x, overflow, 0.000001) {
        Ok(points) => {
            if points.length() != 1 {
                print("FAIL a non-finite value was treated as agreement")
                failures = failures + 1
            } else {
                print("exp(1000) = exp(1000) is reported as a non-finite mismatch")
            }
        },
        Err(message) => {
            print("FAIL overflow: " + message)
            failures = failures + 1
        },
    }

    // 8. An empty list of points is refused by the library (sample says so). It cannot be shown from a program:
    // zeros([0]) fails at run time in Ostrin, so no empty Array can be built here.

    if failures == 0 {
        print("all numeric bridge checks passed")
    } else {
        print("numeric bridge checks failed: " + failures.to_string())
    }
}
