// Range loops: continue and break, negative and zero steps, and bounds evaluated once before the first iteration.
//
// The expected values are worked out by hand in the comments and checked in the program. The loop does not build its
// values first, so these checks are the behaviour the lazy loop must keep.
fn main() -> Void {
    mut failures = 0

    // continue skips one value: 0 + 1 + 3 + 4 = 8
    mut total = 0
    for i in 0 until 5 {
        if i == 2 {
            continue
        }
        total = total + i
    }
    if total != 8 {
        print("FAIL continue: " + total.to_string())
        failures = failures + 1
    }

    // break ends the loop at 3: exactly three iterations before it
    mut count = 0
    for i in 0 to 100 {
        if i == 3 {
            break
        }
        count = count + 1
    }
    if count != 3 {
        print("FAIL break: " + count.to_string())
        failures = failures + 1
    }

    // a negative step counts down: 8, 6, 4, 2 (until 0 excludes 0), sum 20
    mut down = 0
    for i in 8 until 0 step -2 {
        down = down + i
    }
    if down != 20 {
        print("FAIL negative step: " + down.to_string())
        failures = failures + 1
    }

    // a zero step produces no values
    mut zero_step = 0
    for i in 1 to 5 step 0 {
        zero_step = zero_step + 1
    }
    if zero_step != 0 {
        print("FAIL zero step: " + zero_step.to_string())
        failures = failures + 1
    }

    // the bounds are evaluated once: growing n inside the loop does not extend it (3 iterations, not more)
    mut n = 3
    mut iterations = 0
    for i in 0 until n {
        n = n + 1
        iterations = iterations + 1
    }
    if iterations != 3 or n != 6 {
        print("FAIL bounds were re-evaluated: " + iterations.to_string() + " iterations, n = " + n.to_string())
        failures = failures + 1
    }

    // a break in the inner loop leaves only the inner loop: 3 outer iterations, each with 2 inner ones
    mut pairs = 0
    for a in 0 until 3 {
        for b in 0 until 10 {
            if b == 2 {
                break
            }
            pairs = pairs + 1
        }
    }
    if pairs != 6 {
        print("FAIL nested break: " + pairs.to_string())
        failures = failures + 1
    }

    // an empty range (start after end) runs no iteration
    mut empty = 0
    for i in 5 until 5 {
        empty = empty + 1
    }
    if empty != 0 {
        print("FAIL empty range")
        failures = failures + 1
    }

    if failures == 0 {
        print("all range checks passed")
    } else {
        print("range checks failed: " + failures.to_string())
    }
}
