// Scientific Lab · Concurrency
// Integrate sin(x) on [0, pi] with the midpoint rule, split across tasks joined by a channel.
fn partial(start: Int, stop: Int, n: Int) -> Float {
    h = pi() / (n as Float)
    mut total = 0.0
    for i in start until stop {
        total = total + sin(((i as Float) + 0.5) * h) * h
    }
    total
}

fn main() -> Void {
    workers = 4
    intervals = 4000
    results = channel<Float>()
    chunk = intervals / workers

    mut tasks: List<Task<Void>> = []
    for w in 0 until workers {
        start = w * chunk
        stop = if w == workers - 1 { intervals } else { start + chunk }
        tasks.push(spawn {
            results.send(partial(start, stop, intervals))
        })
    }

    mut total = 0.0
    for w in 0 until workers {
        value = results.receive().unwrap()
        print("partial " + w.to_string() + " = " + (round(value * 1000000.0) / 1000000.0).to_string())
        total = total + value
    }
    for task in tasks {
        task.join()
    }
    print("integral ≈ " + (round(total * 1000000.0) / 1000000.0).to_string() + " (exact 2)")
}
