record HashPoint: Hash {
    x: Int
    y: Int
}

record HashEnvelope: Hash {
    value: Option<Int>
}

enum HashShape: Hash {
    Empty
    Point(Int, Int)
}

fn main() -> Void {
    print(hash(42))
    print(hash(255 as UInt8))
    print(hash(true))
    print(hash(1.5))
    print(hash(1.5 as Float32))
    print(hash("Ostrin"))

    maybe: Option<Int> = Some(42)
    empty: Option<Int> = None
    success: Result<Int, String> = Ok(7)
    failure: Result<Int, String> = Err("bad")
    print(hash(maybe))
    print(hash(empty))
    print(hash(success))
    print(hash(failure))

    point = HashPoint { x: 3, y: 4 }
    print(hash(point))
    envelope = HashEnvelope { value: Some(5) }
    print(hash(envelope))

    shape = Point(3, 4)
    print(hash(shape))

    numbers = [1, 2, 3]
    print(hash(numbers))

    mut scores = Map<String, Int>()
    scores.set("a", 1)
    scores.set("b", 2)
    print(hash(scores))
    mut reversed_scores = Map<String, Int>()
    reversed_scores.set("b", 2)
    reversed_scores.set("a", 1)
    assert_eq(hash(scores), hash(reversed_scores))

    mut flags = Set<Int>()
    flags.add(1)
    flags.add(2)
    print(hash(flags))
    mut reversed_flags = Set<Int>()
    reversed_flags.add(2)
    reversed_flags.add(1)
    assert_eq(hash(flags), hash(reversed_flags))
}
