record HashPoint: Hash {
    x: Int
    y: Int
}

record HashEnvelope: Hash {
    value: Option<Int>
}

fn main() -> Void {
    print(hash(42))
    print(hash(255 as UInt8))
    print(hash(true))
    print(hash(1.5))
    print(hash(1.5 as Float32))
    print(hash("Ostrin"))

    maybe: Option<Int> = Some(42)
    empty: Option<Int> = None
    success: Result<Int, String> = Ok(7)
    failure: Result<Int, String> = Err("bad")
    print(hash(maybe))
    print(hash(empty))
    print(hash(success))
    print(hash(failure))

    point = HashPoint { x: 3, y: 4 }
    print(hash(point))
    envelope = HashEnvelope { value: Some(5) }
    print(hash(envelope))
}
