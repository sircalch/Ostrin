// Scientific Lab · Linear Algebra
// Three masses joined by springs: solve, normal modes, LU, QR, SVD and Cholesky factorizations.
import std.numeric

fn clean(x: Float) -> Float {
    round(x * 10000.0) / 10000.0
}

fn main() -> Void {
    coupling = 1.0
    k = array([
        [1.0 + coupling, 0.0 - coupling, 0.0],
        [0.0 - coupling, 1.0 + 2.0 * coupling, 0.0 - coupling],
        [0.0, 0.0 - coupling, 1.0 + coupling]
    ])
    force = array([1.0, 0.0, -1.0])

    print("det(K) = " + clean(det(k)).to_string())
    print("trace(K) = " + clean(trace(k)).to_string())

    x = solve(k, force)
    print("displacement x = K⁻¹ f:")
    print(round(x * 10000.0) / 10000.0)
    print("residual |K x - f| = " + clean(norm(k @ x - force)).to_string())

    pivoted = numeric.lu(k)
    match pivoted {
        Ok(factors) => {
            print("LU determinant = " + clean(factors.determinant()).to_string())
            print("LU reconstruction residual = " + clean(norm(factors.reconstruct() - k)).to_string())
            lu_solution = factors.solve(force)
            print("LU solve residual = " + clean(norm(k @ lu_solution - force)).to_string())
        },
        Err(message) => print("LU error: " + message),
    }

    modes = eigvals(k)
    print("eigenvalues (squared mode frequencies):")
    print(round(modes * 10000.0) / 10000.0)
    print("sum of eigenvalues - trace = " + clean(abs(modes.sum() - trace(k))).to_string())

    decomposition = numeric.qr(k)
    match decomposition {
        Ok(factors) => {
            print("Q (orthonormal basis):")
            print(round(factors.q * 10000.0) / 10000.0)
            print("R (upper triangular):")
            print(round(factors.r * 10000.0) / 10000.0)
            print("QR residual = " + clean(norm(factors.reconstruct() - k)).to_string())
            print("Q orthogonality = " + clean(factors.orthogonality()).to_string())
        },
        Err(message) => print("QR error: " + message),
    }

    singular = numeric.svd(k)
    match singular {
        Ok(factors) => {
            print("SVD singular values:")
            print(round(factors.s * 10000.0) / 10000.0)
            print("SVD rank = " + factors.rank().to_string())
            print("SVD reconstruction residual = " + clean(norm(factors.reconstruct() - k)).to_string())
            svd_solution = factors.solve(clone(force))
            print("SVD solve residual = " + clean(norm(k @ svd_solution - force)).to_string())
        },
        Err(message) => print("SVD error: " + message),
    }

    positive = numeric.cholesky(k)
    match positive {
        Ok(factors) => {
            print("Cholesky residual = " + clean(norm(factors.reconstruct() - k)).to_string())
            cholesky_solution = factors.solve(force)
            print("Cholesky solve residual = " + clean(norm(k @ cholesky_solution - force)).to_string())
        },
        Err(message) => print("Cholesky error: " + message),
    }
}
