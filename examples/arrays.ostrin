fn main() -> Void {
    a = array([1.0, 2.0, 3.0])
    b = array([10.0, 20.0, 30.0])
    print(a + b)
    print(a * 2.0)
    print(2.0 - a)
    print(a.sum())
    print(a.mean())
    print(a.dot(b))

    m = array([[1.0, 2.0], [3.0, 4.0]])
    print(m)
    print(m.shape())
    print(m.transpose())
    print(m.matmul(m))
    print(m + array([100.0, 200.0]))
    print(m.sum_axis(0))
    print(m.sum_axis(1))
    print(m.get(1, 0))

    mut z = zeros([2, 3])
    z.set(0, 1, 5.5)
    print(z)
    print(z.reshape([3, 2]))
    print(full([2, 2], 7))
    print(arange(0, 5))
    print(linspace(0.0, 1.0, 5))
    print(a[2])
    print(a.max() - a.min())
    print(-a)

    ints = array([[1, 2, 3], [4, 5, 6]])
    print(ints.mean())
    print(ints / 2)
    print(ints.to_list())

    f = array([1.5f32, 2.5f32])
    print(f * 2.0)
    print(f.mean())
}
