// Audit of the assumption system: a symbol's built-in assumption is combined with the context, never overridden by it;
// contexts are values; a conditional result is not an identity.
import std.symbolic

fn main() -> Void {
    s = symbolic.store()
    x = symbolic.symbol(s, "x")
    legacy = symbolic.symbol(s, "w", "positive")
    mut failures = 0
    empty = symbolic.context()

    // 1. The old API's assumption is inherited by every context that does not contradict it.
    if symbolic.knows(empty, legacy, "positive") != "true" {
        print("FAIL a positive symbol is not known positive")
        failures = failures + 1
    }
    if symbolic.sign_of(empty, legacy) != "positive" {
        print("FAIL the sign of a positive symbol is not positive")
        failures = failures + 1
    }

    // 2. A context that contradicts the built-in assumption is reported, and no rule runs on it.
    negative_w = symbolic.assume(empty, "w", "negative").unwrap()
    print("A. knows positive under w negative: " + symbolic.knows(negative_w, legacy, "positive"))
    if symbolic.knows(negative_w, legacy, "positive") != "contradictory" {
        print("FAIL the conflict between the built-in positive and the context negative is not reported")
        failures = failures + 1
    }
    if symbolic.sign_of(negative_w, legacy) != "contradictory" {
        print("FAIL the sign under a contradiction must be contradictory, not " + symbolic.sign_of(negative_w, legacy))
        failures = failures + 1
    }
    sqrt_conflict = symbolic.sqrt_of_square(negative_w, legacy)
    print("A. sqrt(w^2) under the contradiction: " + sqrt_conflict.status + ": " + sqrt_conflict.reason)
    if sqrt_conflict.status != "refused" {
        print("FAIL a contradictory context must refuse the radical rule")
        failures = failures + 1
    }
    cancel_conflict = symbolic.simplify_self_quotient(negative_w, legacy)
    if cancel_conflict.status != "refused" {
        print("FAIL a contradictory context must refuse x / x")
        failures = failures + 1
    }

    // 3. A context alone (by name) is consistent with the built-in assumption when it agrees.
    agreeing = symbolic.assume(empty, "w", "nonzero").unwrap()
    if symbolic.knows(agreeing, legacy, "nonzero") != "true" {
        print("FAIL positive should keep nonzero")
        failures = failures + 1
    }

    // 4. Contexts are values: one symbol under two contexts, with the store and the context unchanged.
    positive_x = symbolic.assume(empty, "x", "positive").unwrap()
    negative_x = symbolic.assume(empty, "x", "negative").unwrap()
    print("B. sign of x: positive under one context, " + symbolic.sign_of(negative_x, x) + " under another")
    if symbolic.sign_of(positive_x, x) != "positive" or symbolic.sign_of(negative_x, x) != "negative" {
        print("FAIL one symbol must take each context's sign")
        failures = failures + 1
    }
    if symbolic.show(x) != "x" or symbolic.describe(empty) != "no assumptions (every symbol real)" {
        print("FAIL the expression or the empty context changed")
        failures = failures + 1
    }

    // 5. A conditional result is not an identity: is_identity is true only when no condition is required.
    real_root = symbolic.sqrt_of_square(empty, x)
    nonneg_root = symbolic.sqrt_of_square(symbolic.assume(empty, "x", "nonnegative").unwrap(), x)
    print("C. identity for real x: " + symbolic.is_identity(real_root).to_string() + "; identity under x >= 0: " + symbolic.is_identity(nonneg_root).to_string())
    if not symbolic.is_identity(real_root) {
        print("FAIL abs(x) = sqrt(x^2) is an identity for real x")
        failures = failures + 1
    }
    if symbolic.is_identity(nonneg_root) {
        print("FAIL sqrt(x^2) = x is only conditional and must not be an identity")
        failures = failures + 1
    }

    if failures == 0 {
        print("all audit checks passed")
    } else {
        print("audit checks failed: " + failures.to_string())
    }
}
