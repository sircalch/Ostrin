// Generated by scripts/rational-equations-oracle.mjs --write from tests/oracle/rational-equations-cases.json.
// Do not edit by hand. The expected output is tests/oracle/rational-equations-expected.txt, from an independent oracle.
import std.rational

fn coeffs_of(text: String) -> List<String> {
    mut out: List<String> = []
    if text == "" {
        return out
    }
    for piece in text.split(";") {
        out.push(piece)
    }
    out
}

fn summary(index: Int, nf: String, df: String, ng: String, dg: String) -> String {
    f = rational.rational_new(coeffs_of(nf), coeffs_of(df)).unwrap()
    g = rational.rational_new(coeffs_of(ng), coeffs_of(dg)).unwrap()
    s = rational.rational_solve(f, g).unwrap()
    mut sols = "none"
    if s.solutions.length() > 0 {
        sols = s.solutions.join(" | ")
    }
    return "case " + index.to_string() + ": status=" + s.status + "; solutions=" + sols + "; excluded=" + s.excluded.length().to_string() + "; rejected=" + s.rejected.length().to_string() + "; pending=" + s.pending.length().to_string() + "; domain=" + s.domain.length().to_string() + "; complex=" + s.complex_roots.length().to_string()
}

