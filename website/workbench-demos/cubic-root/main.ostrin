// Workbench demonstration: the cubic x^3 - 2x - 5, its root and three derivatives, checked numerically.
import std.numeric
import model
import analysis
import graphics

fn main() -> Int {
    print("model: " + analysis.symbolic_form())
    mut failures = 0
    match analysis.root_in(1.0, 3.0) {
        Ok(root) => {
            print("root: " + root.to_string())
            residual = model.f(root)
            print("residual |f(root)|: " + abs(residual).to_string())
            if abs(residual) > 1e-12 {
                print("FAIL residual above 1e-12")
                failures = failures + 1
            }
            analytic = model.df(root)
            match analysis.symbolic_derivative(root) {
                Ok(symbolic) => {
                    print("symbolic derivative: " + symbolic.to_string())
                    if abs(symbolic - analytic) > 1e-12 {
                        print("FAIL symbolic derivative differs from 3x^2 - 2")
                        failures = failures + 1
                    }
                },
                Err(message) => {
                    print("FAIL symbolic derivative: " + message)
                    failures = failures + 1
                }
            }
            match analysis.autodiff_derivative(root) {
                Ok(automatic) => {
                    print("autodiff derivative: " + automatic.to_string())
                    if abs(automatic - analytic) > 1e-12 {
                        print("FAIL autodiff derivative differs from 3x^2 - 2")
                        failures = failures + 1
                    }
                },
                Err(message) => {
                    print("FAIL autodiff derivative: " + message)
                    failures = failures + 1
                }
            }
            numerical = analysis.numerical_derivative(root)
            print("finite-difference derivative: " + numerical.to_string())
            if abs(numerical - analytic) > 1e-5 {
                print("FAIL finite difference differs by more than 1e-5")
                failures = failures + 1
            }
            print(graphics.figure(root))
        },
        Err(message) => {
            print("error: " + message)
            failures = failures + 1
        }
    }
    match analysis.root_in(0.0, 1.0) {
        Ok(root) => print("unexpected root in [0, 1]: " + root.to_string()),
        Err(message) => print("expected error for [0, 1]: " + message),
    }
    if failures == 0 {
        print("all checks passed")
        0
    } else {
        print("checks failed: " + failures.to_string())
        1
    }
}
