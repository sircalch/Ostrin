enum Message {
    Text(String)
    Empty
}

fn show(message: Message) -> Void {
    match message {
        Text(text) => print(text),
        Empty => print("empty"),
    }
}

fn main() -> Void {
    message = Text("closure payload")
    callback: fn() -> Void = fn() { show(message) }
    callback()
    drop(callback)
}
