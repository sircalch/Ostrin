// Several bindings named `x` in different scopes. Each closure must capture the binding its own declaration refers to. Expected
// (worked out by hand; each line is one print):
//   11        loop closure sees the loop x (10 + 0) and increments it
//   12        the second loop closure sees the loop x (10 + 1 = 11) and increments it
//   1         the outer closure keeps the outer x, which the loop never changed
//   5         after x = 5 the outer closure sees the reassigned outer x
//   7         a reads the outer x (5), then the inner closure captures the inner x (2): 5 + 2
//   7         the lambda declares its own mut x = 7; no outer binding is captured
//   4         a closure in a nested block captures the block x (4), not the function x
//   1         make_outer returns a closure over its own x (1)
fn make_outer() -> fn() -> Int {
    mut x = 1
    return fn() { x }
}

fn main() -> Void {
    mut x = 1
    outer = fn() { x }
    for i in 0 until 2 {
        mut x = 10 + i
        bump = fn() {
            x = x + 1
            x
        }
        print(bump())
    }
    print(outer())
    x = 5
    print(outer())

    shadow = fn() {
        a = x
        mut x = 2
        inner = fn() { x }
        a + inner()
    }
    print(shadow())

    own = fn() {
        mut x = 7
        get = fn() { x }
        get()
    }
    print(own())

    if true {
        mut x = 4
        block_get = fn() { x }
        print(block_get())
    }
    print(make_outer()())
}
