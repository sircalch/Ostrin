trait Message {
    fn text(self) -> String
}

record Speaker { text: String }

impl Message for Speaker {
    fn text(self) -> String { self.text }
}

fn main() -> Void {
    shape: dyn Message = Speaker { text: "task payload" }
    alias: dyn Message = shape
    worker = spawn {
        shape.text()
    }
    print(worker.join())
    print(alias.text())
}
