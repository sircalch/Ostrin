fn make(shape: List<Int>) -> Array<Float> {
    zeros(shape)
}

fn make_ones(shape: List<Int>) -> Array<Float> {
    ones(shape)
}

fn make_full(shape: List<Int>, value: Int) -> Array<Int> {
    full(shape, value)
}

fn make_range(start: Int, stop: Int) -> Array<Int> {
    arange(start, stop)
}

fn measure(value: Array<Float>) -> Float {
    norm(value)
}

fn scalar_cast(value: Int) -> Float {
    value as Float
}

fn mapped(value: Array<Float>) -> Array<Float> {
    abs(value)
}

fn main() -> Void {
    values = make([2, 2])
    values.set(0, 0, 3.0)
    values.set(0, 1, 4.0)
    print(measure(values))
    print(sqrt(9.0))
    print(make_ones([1])[0])
    print(scalar_cast(3))
    print(sin(pi() / 2.0))
    print(exp(ln(2.0)))
    print(mapped(array([-3.0, 4.0]))[0])
    print(eye(2).get(1, 1))
    print(make_full([2, 2], 7))
    print(make_range(0, 5))
}
