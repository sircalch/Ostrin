// std.symbolic — typed symbolic algebra on a hash-consed expression store.
//
// Expressions live in a `Store` as nodes addressed by index (a DAG), so equal sub-expressions are
// shared and equality is an integer comparison. Constructors canonicalize as they build: sums and
// products are flattened and ordered, numeric constants are folded exactly, and like terms and
// repeated factors are collected. Nothing is simplified unless it is valid on the declared domain:
// every symbol is a real variable, `positive`, `nonzero` and `integer` are explicit assumptions, and
// rules such as x^0 = 1, x * x^-1 = 1 or exp(ln(x)) = x fire only when the assumptions justify them.
//
// Exact numbers are rationals. They are stored as two 64-bit integers while they fit and switch to
// arbitrary precision (std.bigint, as decimal text) as soon as a result does not, so there is no
// overflow: only a zero denominator marks the store as failed (`symbolic.status`).

import std.bigint
import std.polynomial

// ---------------------------------------------------------------- store and nodes

/// Node kinds: 0 number, 1 symbol, 2 sum, 3 product, 4 power, 5 function call.
pub record Store {
    kinds: List<Int>
    nums: List<Int>
    dens: List<Int>
    names: List<String>
    starts: List<Int>
    counts: List<Int>
    pool: List<Int>
    index: Map<String, Int>
    failures: List<String>
    notes: List<String>
    dimtable: List<String>
    dimmemo: Map<Int, String>
}

/// A handle to one expression of a store.
pub record Expr {
    store: Store
    id: Int
}

record Rat {
    n: Int
    d: Int
    big: String
}

pub fn store() -> Store {
    Store {
        kinds: [],
        nums: [],
        dens: [],
        names: [],
        starts: [],
        counts: [],
        pool: [],
        index: Map<String, Int>(),
        failures: [],
        notes: [],
        dimtable: ["1"],
        dimmemo: Map<Int, String>(),
    }
}

/// "" while every exact operation fit in 64 bits, otherwise the first failure.
pub fn status(s: Store) -> String {
    if s.failures.length() == 0 {
        return ""
    }
    s.failures[0]
}

fn fail(s: Store, message: String) -> Void {
    s.failures.push(message)
}

fn note(s: Store, message: String) -> Void {
    s.notes.push(message)
}

fn join_ints(items: List<Int>) -> String {
    mut text = ""
    for i in 0 until items.length() {
        if i > 0 {
            text = text + ","
        }
        text = text + items[i].to_string()
    }
    text
}

fn intern(s: Store, kind: Int, num: Int, den: Int, name: String, args: List<Int>) -> Int {
    key = kind.to_string() + "|" + num.to_string() + "|" + den.to_string() + "|" + name + "|" + join_ints(args)
    found = s.index.get(key)
    match found {
        Some(id) => id,
        None => {
            id = s.kinds.length()
            s.kinds.push(kind)
            s.nums.push(num)
            s.dens.push(den)
            s.names.push(name)
            s.starts.push(s.pool.length())
            s.counts.push(args.length())
            for i in 0 until args.length() {
                s.pool.push(args[i])
            }
            s.index.set(key, id)
            id
        },
    }
}

fn arg_of(s: Store, id: Int, i: Int) -> Int {
    s.pool[s.starts[id] + i]
}

fn args_of(s: Store, id: Int) -> List<Int> {
    mut out: List<Int> = []
    for i in 0 until s.counts[id] {
        out.push(arg_of(s, id, i))
    }
    out
}

// ---------------------------------------------------------------- exact rationals

fn gcd_int(a: Int, b: Int) -> Int {
    mut x = if a < 0 { 0 - a } else { a }
    mut y = if b < 0 { 0 - b } else { b }
    while y != 0 {
        r = x % y
        x = y
        y = r
    }
    x
}

fn fits(value: Float) -> Bool {
    abs(value) < 9.0e18
}

fn rat(s: Store, n: Int, d: Int) -> Rat {
    if d == 0 {
        fail(s, "division by zero in an exact number")
        return Rat { n: 0, d: 1, big: "" }
    }
    g = gcd_int(n, d)
    sign = if d < 0 { 0 - 1 } else { 1 }
    Rat { n: sign * (n / g), d: sign * (d / g), big: "" }
}

fn rat_text_of(r: Rat) -> String {
    if r.big != "" {
        return r.big
    }
    if r.d == 1 {
        return r.n.to_string()
    }
    r.n.to_string() + "/" + r.d.to_string()
}

/// A rational from reduced decimal text: two 64-bit integers when they fit, otherwise the text.
fn rat_from_text(s: Store, text: String) -> Rat {
    if bigint.rational_fits_int(text) {
        return rat(s, bigint.rational_numerator_int(text), bigint.rational_denominator_int(text))
    }
    Rat { n: bigint.rational_sign(text), d: 0, big: text }
}

fn rat_big_result(s: Store, result: Result<String, String>) -> Rat {
    match result {
        Ok(text) => rat_from_text(s, text),
        Err(message) => {
            fail(s, message)
            Rat { n: 0, d: 1, big: "" }
        },
    }
}

fn rat_add(s: Store, a: Rat, b: Rat) -> Rat {
    if a.big == "" and b.big == "" and fits((a.n as Float) * (b.d as Float)) and fits((b.n as Float) * (a.d as Float)) and fits((a.d as Float) * (b.d as Float)) {
        return rat(s, a.n * b.d + b.n * a.d, a.d * b.d)
    }
    rat_big_result(s, bigint.rational_add(rat_text_of(a), rat_text_of(b)))
}

fn rat_mul(s: Store, a: Rat, b: Rat) -> Rat {
    if a.big == "" and b.big == "" and fits((a.n as Float) * (b.n as Float)) and fits((a.d as Float) * (b.d as Float)) {
        return rat(s, a.n * b.n, a.d * b.d)
    }
    rat_big_result(s, bigint.rational_mul(rat_text_of(a), rat_text_of(b)))
}

fn rat_is_zero(r: Rat) -> Bool {
    r.big == "" and r.n == 0
}

fn rat_pow_int(s: Store, base: Rat, exponent: Int) -> Rat {
    if exponent < 0 {
        if rat_is_zero(base) {
            fail(s, "zero raised to a negative power")
            return Rat { n: 0, d: 1, big: "" }
        }
        inverse = rat_big_result(s, bigint.rational_reciprocal(rat_text_of(base)))
        return rat_pow_int(s, inverse, 0 - exponent)
    }
    mut result = Rat { n: 1, d: 1, big: "" }
    mut square = base
    mut remaining = exponent
    while remaining > 0 {
        if remaining % 2 == 1 {
            result = rat_mul(s, result, square)
        }
        remaining = remaining / 2
        if remaining > 0 {
            square = rat_mul(s, square, square)
        }
    }
    result
}

fn num_id(s: Store, r: Rat) -> Int {
    if r.big != "" {
        return intern(s, 0, r.n, 0, r.big, [])
    }
    intern(s, 0, r.n, r.d, "", [])
}

fn int_id(s: Store, n: Int) -> Int {
    intern(s, 0, n, 1, "", [])
}

fn is_num(s: Store, id: Int) -> Bool {
    s.kinds[id] == 0
}

fn rat_of(s: Store, id: Int) -> Rat {
    if s.dens[id] == 0 {
        return Rat { n: s.nums[id], d: 0, big: s.names[id] }
    }
    Rat { n: s.nums[id], d: s.dens[id], big: "" }
}

fn is_int_num(s: Store, id: Int) -> Bool {
    s.kinds[id] == 0 and s.dens[id] == 1
}

fn is_zero(s: Store, id: Int) -> Bool {
    s.kinds[id] == 0 and s.nums[id] == 0
}

fn is_one(s: Store, id: Int) -> Bool {
    s.kinds[id] == 0 and s.nums[id] == 1 and s.dens[id] == 1
}

/// True when the expression is provably nonzero: a nonzero number, a symbol assumed nonzero or
/// positive, or a power or product of such factors.
fn known_nonzero(s: Store, id: Int) -> Bool {
    kind = s.kinds[id]
    if kind == 0 {
        return s.nums[id] != 0
    }
    if kind == 1 {
        return s.nums[id] % 4 >= 2 or s.nums[id] % 2 == 1
    }
    if kind == 3 {
        for i in 0 until s.counts[id] {
            if not known_nonzero(s, arg_of(s, id, i)) {
                return false
            }
        }
        return true
    }
    if kind == 4 {
        return known_nonzero(s, arg_of(s, id, 0))
    }
    false
}

/// True when the expression is provably positive.
fn known_positive(s: Store, id: Int) -> Bool {
    kind = s.kinds[id]
    if kind == 0 {
        return s.nums[id] > 0
    }
    if kind == 1 {
        return s.nums[id] % 2 == 1
    }
    if kind == 3 {
        for i in 0 until s.counts[id] {
            if not known_positive(s, arg_of(s, id, i)) {
                return false
            }
        }
        return true
    }
    if kind == 4 {
        return known_positive(s, arg_of(s, id, 0))
    }
    if kind == 2 {
        for i in 0 until s.counts[id] {
            if not known_positive(s, arg_of(s, id, i)) {
                return false
            }
        }
        return true
    }
    false
}

fn sort_ids(items: List<Int>) -> List<Int> {
    mut out: List<Int> = []
    for x in items {
        mut next: List<Int> = []
        mut placed = false
        for y in out {
            if not placed and x < y {
                next.push(x)
                placed = true
            }
            next.push(y)
        }
        if not placed {
            next.push(x)
        }
        out = next
    }
    out
}

// ---------------------------------------------------------------- canonical constructors

fn concat_ids(a: List<Int>, b: List<Int>) -> List<Int> {
    mut out: List<Int> = []
    for x in a {
        out.push(x)
    }
    for y in b {
        out.push(y)
    }
    out
}

/// Split a term into its numeric coefficient and the remaining factor id (-1 for a pure number).
fn term_coefficient(s: Store, id: Int) -> Rat {
    if s.kinds[id] == 0 {
        return rat_of(s, id)
    }
    if s.kinds[id] == 3 and s.kinds[arg_of(s, id, 0)] == 0 {
        return rat_of(s, arg_of(s, id, 0))
    }
    Rat { n: 1, d: 1, big: "" }
}

fn term_rest(s: Store, id: Int) -> Int {
    if s.kinds[id] == 0 {
        return 0 - 1
    }
    if s.kinds[id] == 3 and s.kinds[arg_of(s, id, 0)] == 0 {
        count = s.counts[id]
        if count == 2 {
            return arg_of(s, id, 1)
        }
        mut rest: List<Int> = []
        for i in 1 until count {
            rest.push(arg_of(s, id, i))
        }
        return intern(s, 3, 0, 1, "", rest)
    }
    id
}

fn add_ids(s: Store, items: List<Int>) -> Int {
    mut flat: List<Int> = []
    for item in items {
        if s.kinds[item] == 2 {
            flat = concat_ids(flat, args_of(s, item))
        } else {
            flat.push(item)
        }
    }
    mut constant = Rat { n: 0, d: 1, big: "" }
    mut rests: List<Int> = []
    mut coefs: List<Rat> = []
    for term in flat {
        c = term_coefficient(s, term)
        r = term_rest(s, term)
        if r == 0 - 1 {
            constant = rat_add(s, constant, c)
        } else {
            mut found = false
            mut next_coefs: List<Rat> = []
            for k in 0 until rests.length() {
                if rests[k] == r {
                    next_coefs.push(rat_add(s, coefs[k], c))
                    found = true
                } else {
                    next_coefs.push(coefs[k])
                }
            }
            if found {
                coefs = next_coefs
            } else {
                rests.push(r)
                coefs.push(c)
            }
        }
    }
    mut terms: List<Int> = []
    for k in 0 until rests.length() {
        c = coefs[k]
        if c.n != 0 {
            if c.n == 1 and c.d == 1 {
                terms.push(rests[k])
            } else {
                terms.push(mul_ids(s, [num_id(s, c), rests[k]]))
            }
        }
    }
    sorted = sort_ids(terms)
    mut all: List<Int> = []
    if constant.n != 0 {
        all.push(num_id(s, constant))
    }
    all = concat_ids(all, sorted)
    if all.length() == 0 {
        return int_id(s, 0)
    }
    if all.length() == 1 {
        return all[0]
    }
    intern(s, 2, 0, 1, "", all)
}

/// A factor as (base, exponent): a power with a numeric exponent splits, anything else has exponent 1.
fn factor_base(s: Store, id: Int) -> Int {
    if s.kinds[id] == 4 and s.kinds[arg_of(s, id, 1)] == 0 {
        return arg_of(s, id, 0)
    }
    id
}

fn factor_exponent(s: Store, id: Int) -> Rat {
    if s.kinds[id] == 4 and s.kinds[arg_of(s, id, 1)] == 0 {
        return rat_of(s, arg_of(s, id, 1))
    }
    Rat { n: 1, d: 1, big: "" }
}

fn mul_ids(s: Store, items: List<Int>) -> Int {
    mut flat: List<Int> = []
    for item in items {
        if s.kinds[item] == 3 {
            flat = concat_ids(flat, args_of(s, item))
        } else {
            flat.push(item)
        }
    }
    mut constant = Rat { n: 1, d: 1, big: "" }
    mut bases: List<Int> = []
    mut exps: List<Rat> = []
    for factor in flat {
        if s.kinds[factor] == 0 {
            constant = rat_mul(s, constant, rat_of(s, factor))
        } else {
            b = factor_base(s, factor)
            e = factor_exponent(s, factor)
            mut found = false
            mut next_exps: List<Rat> = []
            for k in 0 until bases.length() {
                if bases[k] == b {
                    next_exps.push(rat_add(s, exps[k], e))
                    found = true
                } else {
                    next_exps.push(exps[k])
                }
            }
            if found {
                exps = next_exps
            } else {
                bases.push(b)
                exps.push(e)
            }
        }
    }
    if constant.n == 0 {
        return int_id(s, 0)
    }
    mut factors: List<Int> = []
    for k in 0 until bases.length() {
        factors.push(pow_ids(s, bases[k], num_id(s, exps[k])))
    }
    mut numeric_extra = constant
    mut kept: List<Int> = []
    for f in factors {
        if s.kinds[f] == 0 {
            numeric_extra = rat_mul(s, numeric_extra, rat_of(s, f))
        } else {
            kept.push(f)
        }
    }
    sorted = sort_ids(kept)
    mut all: List<Int> = []
    if not (numeric_extra.n == 1 and numeric_extra.d == 1) {
        all.push(num_id(s, numeric_extra))
    }
    all = concat_ids(all, sorted)
    if all.length() == 0 {
        return int_id(s, 1)
    }
    if all.length() == 1 {
        return all[0]
    }
    intern(s, 3, 0, 1, "", all)
}

fn pow_ids(s: Store, base: Int, exponent: Int) -> Int {
    if s.kinds[exponent] == 0 and (s.dens[exponent] == 0 or abs(s.nums[exponent]) > 100000) {
        return intern(s, 4, 0, 1, "", [base, exponent])
    }
    if s.kinds[exponent] == 0 {
        e = rat_of(s, exponent)
        if e.n == 0 {
            if known_nonzero(s, base) {
                return int_id(s, 1)
            }
            return intern(s, 4, 0, 1, "", [base, exponent])
        }
        if e.n == 1 and e.d == 1 {
            return base
        }
        if is_one(s, base) {
            return base
        }
        if s.kinds[base] == 0 and e.d == 1 {
            return num_id(s, rat_pow_int(s, rat_of(s, base), e.n))
        }
        if s.kinds[base] == 0 and s.nums[base] == 0 and e.n > 0 {
            return base
        }
        // A positive integer to a half-integer power: n^(p/2) = k^p * m^(p/2) where n = k*k*m and m is squarefree,
        // so sqrt(8) is 2*2^(1/2) and sqrt(4) is 2. The square part leaves the radical; the rest stays inside it.
        if s.kinds[base] == 0 and e.d == 2 and e.n > 0 {
            b = rat_of(s, base)
            if b.big == "" and b.d == 1 and b.n > 0 and b.n <= 1000000000000 {
                parts = square_split(b.n)
                if parts[0] > 1 {
                    // e.n is odd here (e.d is 2), so (p/2) = (p-1)/2 + 1/2 and only one half-power stays inside.
                    half = (e.n - 1) / 2
                    outside = rat_mul(s, rat_pow_int(s, rat(s, parts[0], 1), e.n), rat_pow_int(s, rat(s, parts[1], 1), half))
                    radical = pow_ids(s, int_id(s, parts[1]), num_id(s, rat(s, 1, 2)))
                    return mul_ids(s, [num_id(s, outside), radical])
                }
            }
        }
        if s.kinds[base] == 4 and s.kinds[arg_of(s, base, 1)] == 0 {
            inner_base = arg_of(s, base, 0)
            inner = rat_of(s, arg_of(s, base, 1))
            if e.d == 1 or known_positive(s, inner_base) {
                return pow_ids(s, inner_base, num_id(s, rat_mul(s, inner, e)))
            }
        }
        // (a*b)^r = a^r * b^r holds for any exponent when every factor is positive; for an integer exponent it always does.
        if s.kinds[base] == 3 and (e.d == 1 or known_positive(s, base)) {
            mut parts: List<Int> = []
            for i in 0 until s.counts[base] {
                parts.push(pow_ids(s, arg_of(s, base, i), exponent))
            }
            return mul_ids(s, parts)
        }
    }
    intern(s, 4, 0, 1, "", [base, exponent])
}

fn call_id(s: Store, name: String, arg: Int) -> Int {
    if name == "sin" and is_zero(s, arg) {
        return int_id(s, 0)
    }
    if name == "cos" and is_zero(s, arg) {
        return int_id(s, 1)
    }
    if name == "exp" {
        if is_zero(s, arg) {
            return int_id(s, 1)
        }
        if s.kinds[arg] == 5 and s.names[arg] == "ln" and known_positive(s, arg_of(s, arg, 0)) {
            return arg_of(s, arg, 0)
        }
    }
    if name == "ln" {
        if is_one(s, arg) {
            return int_id(s, 0)
        }
        if s.kinds[arg] == 5 and s.names[arg] == "exp" {
            return arg_of(s, arg, 0)
        }
    }
    intern(s, 5, 0, 1, name, [arg])
}

// ---------------------------------------------------------------- structure queries

fn free_of(s: Store, id: Int, v: Int) -> Bool {
    if id == v {
        return false
    }
    if s.kinds[id] <= 1 {
        return true
    }
    for i in 0 until s.counts[id] {
        if not free_of(s, arg_of(s, id, i), v) {
            return false
        }
    }
    true
}

// ---------------------------------------------------------------- differentiation

fn diff_ids(s: Store, id: Int, v: Int) -> Int {
    kind = s.kinds[id]
    if kind == 0 {
        return int_id(s, 0)
    }
    if kind == 1 {
        return int_id(s, if id == v { 1 } else { 0 })
    }
    if kind == 2 {
        mut parts: List<Int> = []
        for i in 0 until s.counts[id] {
            parts.push(diff_ids(s, arg_of(s, id, i), v))
        }
        return add_ids(s, parts)
    }
    if kind == 3 {
        mut terms: List<Int> = []
        n = s.counts[id]
        for i in 0 until n {
            mut factors: List<Int> = []
            for j in 0 until n {
                if i == j {
                    factors.push(diff_ids(s, arg_of(s, id, j), v))
                } else {
                    factors.push(arg_of(s, id, j))
                }
            }
            terms.push(mul_ids(s, factors))
        }
        return add_ids(s, terms)
    }
    if kind == 4 {
        base = arg_of(s, id, 0)
        exponent = arg_of(s, id, 1)
        base_d = diff_ids(s, base, v)
        if free_of(s, exponent, v) {
            reduced = add_ids(s, [exponent, int_id(s, 0 - 1)])
            return mul_ids(s, [exponent, pow_ids(s, base, reduced), base_d])
        }
        if known_positive(s, base) {
            exp_d = diff_ids(s, exponent, v)
            inner = add_ids(s, [mul_ids(s, [exp_d, call_id(s, "ln", base)]), mul_ids(s, [exponent, base_d, pow_ids(s, base, int_id(s, 0 - 1))])])
            return mul_ids(s, [id, inner])
        }
        note(s, "differentiating a power with a variable exponent needs a positive base")
        return int_id(s, 0)
    }
    arg = arg_of(s, id, 0)
    inner_d = diff_ids(s, arg, v)
    name = s.names[id]
    if name == "sin" {
        return mul_ids(s, [call_id(s, "cos", arg), inner_d])
    }
    if name == "cos" {
        return mul_ids(s, [int_id(s, 0 - 1), call_id(s, "sin", arg), inner_d])
    }
    if name == "exp" {
        return mul_ids(s, [id, inner_d])
    }
    if name == "ln" {
        return mul_ids(s, [inner_d, pow_ids(s, arg, int_id(s, 0 - 1))])
    }
    if name == "abs" {
        // d/dx abs(u) = sign(u) du/dx. sign is undefined at 0, where abs has a corner: the expression keeps that point
        // undefined, and evaluating it there fails instead of returning a value.
        return mul_ids(s, [call_id(s, "sign", arg), inner_d])
    }
    note(s, "no derivative rule for function " + name)
    int_id(s, 0)
}

// ---------------------------------------------------------------- substitution and expansion

fn subs_ids(s: Store, id: Int, v: Int, replacement: Int) -> Int {
    if id == v {
        return replacement
    }
    kind = s.kinds[id]
    if kind <= 1 {
        return id
    }
    mut parts: List<Int> = []
    for i in 0 until s.counts[id] {
        parts.push(subs_ids(s, arg_of(s, id, i), v, replacement))
    }
    if kind == 2 {
        return add_ids(s, parts)
    }
    if kind == 3 {
        return mul_ids(s, parts)
    }
    if kind == 4 {
        return pow_ids(s, parts[0], parts[1])
    }
    call_id(s, s.names[id], parts[0])
}

fn product_of_two(s: Store, a: Int, b: Int) -> Int {
    if s.kinds[a] == 2 {
        mut parts: List<Int> = []
        for i in 0 until s.counts[a] {
            parts.push(product_of_two(s, arg_of(s, a, i), b))
        }
        return add_ids(s, parts)
    }
    if s.kinds[b] == 2 {
        mut parts: List<Int> = []
        for i in 0 until s.counts[b] {
            parts.push(product_of_two(s, a, arg_of(s, b, i)))
        }
        return add_ids(s, parts)
    }
    mul_ids(s, [a, b])
}

fn expand_ids(s: Store, id: Int) -> Int {
    kind = s.kinds[id]
    if kind <= 1 {
        return id
    }
    if kind == 5 {
        return call_id(s, s.names[id], expand_ids(s, arg_of(s, id, 0)))
    }
    if kind == 2 {
        mut parts: List<Int> = []
        for i in 0 until s.counts[id] {
            parts.push(expand_ids(s, arg_of(s, id, i)))
        }
        return add_ids(s, parts)
    }
    if kind == 3 {
        mut acc = int_id(s, 1)
        for i in 0 until s.counts[id] {
            acc = product_of_two(s, acc, expand_ids(s, arg_of(s, id, i)))
        }
        return acc
    }
    base = expand_ids(s, arg_of(s, id, 0))
    exponent = arg_of(s, id, 1)
    if s.kinds[base] == 2 and is_int_num(s, exponent) and s.nums[exponent] >= 2 and s.nums[exponent] <= 32 {
        mut acc = int_id(s, 1)
        for i in 0 until s.nums[exponent] {
            acc = product_of_two(s, acc, base)
        }
        return acc
    }
    pow_ids(s, base, exponent)
}

// ---------------------------------------------------------------- numeric evaluation

fn eval_ids(s: Store, id: Int, names: List<String>, values: List<Float>) -> Result<Float, String> {
    kind = s.kinds[id]
    if kind == 0 {
        if s.dens[id] == 0 {
            return Ok(bigint.rational_to_float(s.names[id]))
        }
        return Ok((s.nums[id] as Float) / (s.dens[id] as Float))
    }
    if kind == 1 {
        for i in 0 until names.length() {
            if names[i] == s.names[id] {
                return Ok(values[i])
            }
        }
        return Err("no value for symbol " + s.names[id])
    }
    mut parts: List<Float> = []
    for i in 0 until s.counts[id] {
        match eval_ids(s, arg_of(s, id, i), names, values) {
            Ok(value) => parts.push(value),
            Err(message) => {
                return Err(message)
            },
        }
    }
    if kind == 2 {
        mut total = 0.0
        for p in parts {
            total = total + p
        }
        return Ok(total)
    }
    if kind == 3 {
        mut total = 1.0
        for p in parts {
            total = total * p
        }
        return Ok(total)
    }
    if kind == 4 {
        base = parts[0]
        exponent = parts[1]
        if base < 0.0 and exponent != floor(exponent) {
            return Err("negative base with a non-integer exponent")
        }
        if base == 0.0 and exponent < 0.0 {
            return Err("division by zero")
        }
        return Ok(pow(base, exponent))
    }
    name = s.names[id]
    x = parts[0]
    if name == "abs" {
        return Ok(abs(x))
    }
    if name == "sign" {
        if x == 0.0 {
            return Err("sign is undefined at 0: the derivative of abs has a corner there and no value")
        }
        if x > 0.0 {
            return Ok(1.0)
        }
        return Ok(0.0 - 1.0)
    }
    if name == "sin" {
        return Ok(sin(x))
    }
    if name == "cos" {
        return Ok(cos(x))
    }
    if name == "exp" {
        return Ok(exp(x))
    }
    if name == "ln" {
        if x <= 0.0 {
            return Err("ln of a non-positive number")
        }
        return Ok(ln(x))
    }
    Err("cannot evaluate function " + name)
}

// ---------------------------------------------------------------- printing

fn atomic(s: Store, id: Int) -> Bool {
    kind = s.kinds[id]
    if kind == 0 {
        return s.dens[id] == 1 and s.nums[id] >= 0
    }
    kind == 1 or kind == 5
}

fn show_ids(s: Store, id: Int) -> String {
    kind = s.kinds[id]
    if kind == 0 {
        return rat_text_of(rat_of(s, id))
    }
    if kind == 1 {
        return s.names[id]
    }
    if kind == 5 {
        return s.names[id] + "(" + show_ids(s, arg_of(s, id, 0)) + ")"
    }
    if kind == 4 {
        base = arg_of(s, id, 0)
        exponent = arg_of(s, id, 1)
        mut left = show_ids(s, base)
        if not atomic(s, base) {
            left = "(" + left + ")"
        }
        mut right = show_ids(s, exponent)
        if not atomic(s, exponent) {
            right = "(" + right + ")"
        }
        return left + "^" + right
    }
    if kind == 3 {
        mut text = ""
        for i in 0 until s.counts[id] {
            factor = arg_of(s, id, i)
            mut piece = show_ids(s, factor)
            if s.kinds[factor] == 2 or (s.kinds[factor] == 0 and i > 0) {
                piece = "(" + piece + ")"
            }
            if i == 0 and s.kinds[factor] == 0 and s.nums[factor] == 0 - 1 and s.dens[factor] == 1 {
                text = "-"
            } else {
                if i > 0 and text != "-" {
                    text = text + "*"
                }
                text = text + piece
            }
        }
        return text
    }
    mut text = ""
    for i in 0 until s.counts[id] {
        piece = show_ids(s, arg_of(s, id, i))
        if i == 0 {
            text = piece
        } else {
            if piece.starts_with("-") {
                text = text + " - " + piece.slice(1, piece.length())
            } else {
                text = text + " + " + piece
            }
        }
    }
    text
}

// ---------------------------------------------------------------- public API

fn wrap(s: Store, id: Int) -> Expr {
    Expr { store: s, id: id }
}

/// The exact rational n/d (d defaults to 1).
pub fn number(s: Store, n: Int, d: Int = 1) -> Expr {
    wrap(s, num_id(s, rat(s, n, d)))
}

/// True when the expression is provably positive under the symbols' assumptions. Numbers, positive symbols, and
/// products and powers built from them count; a real symbol alone does not.
pub fn is_positive(a: Expr) -> Bool {
    known_positive(a.store, a.id)
}

/// True when the expression is provably nonzero under the symbols' assumptions.
pub fn is_nonzero(a: Expr) -> Bool {
    known_nonzero(a.store, a.id)
}

/// A real symbol. `assumption` is "real" (no assumption), "positive", "nonzero" or "integer".
pub fn symbol(s: Store, name: String, assumption: String = "real") -> Expr {
    bits = if assumption == "positive" {
        1
    } else if assumption == "nonzero" {
        2
    } else if assumption == "integer" {
        4
    } else {
        0
    }
    wrap(s, intern(s, 1, bits, 1, name, []))
}

pub fn add(a: Expr, b: Expr) -> Expr {
    wrap(a.store, add_ids(a.store, [a.id, b.id]))
}

pub fn neg(a: Expr) -> Expr {
    wrap(a.store, mul_ids(a.store, [int_id(a.store, 0 - 1), a.id]))
}

pub fn sub(a: Expr, b: Expr) -> Expr {
    add(a, neg(b))
}

pub fn mul(a: Expr, b: Expr) -> Expr {
    wrap(a.store, mul_ids(a.store, [a.id, b.id]))
}

/// a / b as a * b^-1; fails the store when b is the number zero.
pub fn div(a: Expr, b: Expr) -> Expr {
    if is_zero(b.store, b.id) {
        fail(b.store, "division by zero")
    }
    wrap(a.store, mul_ids(a.store, [a.id, pow_ids(a.store, b.id, int_id(a.store, 0 - 1))]))
}

pub fn power(a: Expr, b: Expr) -> Expr {
    wrap(a.store, pow_ids(a.store, a.id, b.id))
}

/// A named function call: "sin", "cos", "exp" or "ln".
pub fn call(name: String, a: Expr) -> Expr {
    wrap(a.store, call_id(a.store, name, a.id))
}

/// Structural equality (expressions of one store are canonical and shared).
pub fn same(a: Expr, b: Expr) -> Bool {
    a.id == b.id
}

pub fn show(a: Expr) -> String {
    show_ids(a.store, a.id)
}

/// Distribute products over sums and expand small integer powers of sums.
pub fn expand(a: Expr) -> Expr {
    wrap(a.store, expand_ids(a.store, a.id))
}

/// Replace `v` (a symbol) by `replacement`, re-canonicalizing.
pub fn subs(a: Expr, v: Expr, replacement: Expr) -> Expr {
    wrap(a.store, subs_ids(a.store, a.id, v.id, replacement.id))
}

/// d a / d v for a symbol `v`. Fails with a typed message for unsupported functions, a variable
/// exponent over a base that is not known positive, or a store that already failed.
pub fn diff(a: Expr, v: Expr) -> Result<Expr, String> {
    if a.store.kinds[v.id] != 1 {
        return Err("diff needs a symbol to differentiate by")
    }
    if a.store.failures.length() > 0 {
        return Err(a.store.failures[0])
    }
    before = a.store.notes.length()
    result = diff_ids(a.store, a.id, v.id)
    if a.store.notes.length() > before {
        return Err(a.store.notes[before])
    }
    if a.store.failures.length() > 0 {
        return Err(a.store.failures[0])
    }
    Ok(wrap(a.store, result))
}

/// Numeric value with the given symbol values (`names[i]` takes `values[i]`).
pub fn eval(a: Expr, names: List<String>, values: List<Float>) -> Result<Float, String> {
    if a.store.failures.length() > 0 {
        return Err(a.store.failures[0])
    }
    eval_ids(a.store, a.id, names, values)
}

/// True when `a` contains the symbol `v`.
pub fn depends_on(a: Expr, v: Expr) -> Bool {
    not free_of(a.store, a.id, v.id)
}

/// The derivative rendered as text, or "error: ..." with the typed message.
pub fn diff_text(a: Expr, v: Expr) -> String {
    match diff(a, v) {
        Ok(d) => show(d),
        Err(message) => "error: " + message,
    }
}

/// The numeric value rendered as text, or "error: ..." with the typed message.
pub fn eval_text(a: Expr, names: List<String>, values: List<Float>) -> String {
    match eval(a, names, values) {
        Ok(value) => value.to_string(),
        Err(message) => "error: " + message,
    }
}

/// The numeric value, or `fallback` when evaluation fails (unknown symbol, domain error).
pub fn eval_or(a: Expr, names: List<String>, values: List<Float>, fallback: Float) -> Float {
    match eval(a, names, values) {
        Ok(value) => value,
        Err(message) => fallback,
    }
}

/// The values of `a` at the points `xs`, with the symbol `v` as the variable. Any other symbol in `a` has no value and
/// fails. The first point that cannot be evaluated (a division by zero, a negative base to a fraction) fails the whole
/// sample, so a domain error is reported rather than replaced by a number.
pub fn sample(a: Expr, v: Expr, xs: Array<Float>) -> Result<Array<Float>, String> {
    if a.store.failures.length() > 0 {
        return Err(a.store.failures[0])
    }
    if xs.length() == 0 {
        return Err("sample needs at least one point")
    }
    if v.store.kinds[v.id] != 1 {
        return Err("sample needs a symbol as its variable")
    }
    name = v.store.names[v.id]
    mut out = zeros([xs.length()])
    for i in 0 until xs.length() {
        match eval_ids(a.store, a.id, [name], [xs[i]]) {
            Ok(value) => out.set(i, value),
            Err(message) => {
                return Err("at " + xs[i].to_string() + ": " + message)
            },
        }
    }
    Ok(out)
}

/// True for an ordinary finite number. NaN is not equal to itself; an infinite value is larger than any finite bound.
fn finite_value(v: Float) -> Bool {
    if v != v {
        return false
    }
    abs(v) < 1.0e308
}

/// The points where two sampled value lists disagree. A point where either value is not finite always disagrees, since
/// a NaN or an infinity is not evidence of agreement. Otherwise a point disagrees when the difference exceeds `tol`
/// relative to the larger magnitude, and at least `tol` in absolute size (the scale never falls below 1).
fn mismatched_points(left: Array<Float>, right: Array<Float>, xs: Array<Float>, tol: Float) -> List<Float> {
    mut found: List<Float> = []
    for i in 0 until xs.length() {
        if not finite_value(left[i]) or not finite_value(right[i]) {
            found.push(xs[i])
        } else {
            mut scale = 1.0
            if abs(left[i]) > scale {
                scale = abs(left[i])
            }
            if abs(right[i]) > scale {
                scale = abs(right[i])
            }
            if abs(left[i] - right[i]) > tol * scale {
                found.push(xs[i])
            }
        }
    }
    found
}

/// The points of `xs` where `a` and `b` disagree (see mismatched_points). These are counterexamples to the identity
/// a = b. An empty list means that no sampled point disagrees; it is evidence for the identity on those points, not a
/// proof. Duplicate points are sampled and compared like any others; an empty `xs` gives an empty list.
pub fn disagreements(a: Expr, b: Expr, v: Expr, xs: Array<Float>, tol: Float) -> Result<List<Float>, String> {
    left = sample(a, v, xs)
    right = sample(b, v, xs)
    match left {
        Ok(lv) => {
            match right {
                Ok(rv) => Ok(mismatched_points(lv, rv, xs, tol)),
                Err(message) => Err(message),
            }
        },
        Err(message) => Err(message),
    }
}

/// `xs` moved by `shift`.
fn shifted_points(xs: Array<Float>, shift: Float) -> Array<Float> {
    mut out = zeros([xs.length()])
    for i in 0 until xs.length() {
        out.set(i, xs[i] + shift)
    }
    out
}

/// The central difference quotient of `a` at each point of `xs`, with step `delta`.
fn difference_quotients(a: Expr, v: Expr, xs: Array<Float>, delta: Float) -> Result<Array<Float>, String> {
    up = sample(a, v, shifted_points(xs, delta))
    down = sample(a, v, shifted_points(xs, 0.0 - delta))
    match up {
        Ok(uv) => {
            match down {
                Ok(dv) => {
                    mut out = zeros([xs.length()])
                    for i in 0 until xs.length() {
                        out.set(i, (uv[i] - dv[i]) / (2.0 * delta))
                    }
                    Ok(out)
                },
                Err(message) => Err(message),
            }
        },
        Err(message) => Err(message),
    }
}

/// Compares the symbolic derivative of `a` with central differences of `a` at the points `xs`. The quotient is taken
/// with the step `delta` and with `delta / 10`. A central difference is trusted only when the two steps agree: a step
/// too large leaves truncation error, a step too small leaves rounding error, and either one would make the comparison
/// misleading. When they disagree the call fails and names the point. Otherwise it returns the points where the
/// symbolic derivative and the quotient disagree (see mismatched_points). A missing derivative rule also fails.
pub fn derivative_mismatches(a: Expr, v: Expr, xs: Array<Float>, delta: Float, tol: Float) -> Result<List<Float>, String> {
    if xs.length() == 0 {
        return Err("derivative_mismatches needs at least one point")
    }
    derivative = diff(a, v)
    coarse = difference_quotients(a, v, xs, delta)
    fine = difference_quotients(a, v, xs, delta / 10.0)
    match derivative {
        Ok(d) => {
            match coarse {
                Ok(cq) => {
                    match fine {
                        Ok(fq) => {
                            mut unstable = -1
                            for i in 0 until xs.length() {
                                if unstable < 0 and not (not finite_value(cq[i]) or not finite_value(fq[i])) {
                                    if abs(cq[i] - fq[i]) > tol * (1.0 + abs(cq[i])) {
                                        unstable = i
                                    }
                                }
                            }
                            if unstable >= 0 {
                                return Err("the step is not reliable at " + xs[unstable].to_string() + ": steps " + delta.to_string() + " and " + (delta / 10.0).to_string() + " give different quotients; choose a step between them")
                            }
                            match sample(d, v, xs) {
                                Ok(exact) => Ok(mismatched_points(exact, cq, xs, tol)),
                                Err(message) => Err(message),
                            }
                        },
                        Err(message) => Err(message),
                    }
                },
                Err(message) => Err(message),
            }
        },
        Err(message) => Err(message),
    }
}

/// An exact integer given as decimal text of any length ("-123456789012345678901234567890").
pub fn big_number(s: Store, text: String) -> Expr {
    match bigint.rational_make(text, "1") {
        Ok(reduced) => wrap(s, num_id(s, rat_from_text(s, reduced))),
        Err(message) => {
            fail(s, message)
            wrap(s, int_id(s, 0))
        },
    }
}

/// An exact rational from two decimal integer texts of any length.
pub fn rational_from_text(s: Store, numerator: String, denominator: String) -> Expr {
    match bigint.rational_make(numerator, denominator) {
        Ok(reduced) => wrap(s, num_id(s, rat_from_text(s, reduced))),
        Err(message) => {
            fail(s, message)
            wrap(s, int_id(s, 0))
        },
    }
}

// ---------------------------------------------------------------- physical dimensions
//
// A symbol may be declared with a dimension such as "Mass*Length^2/Time^2". Dimensions are vectors of
// rational exponents over named base dimensions (a name without a leading digit or syntax characters,
// so "Base2" and "Ángulo" are valid). `dimension_of(expr)` propagates them:
// a sum needs equal dimensions, a product adds exponents, a power with a numeric exponent scales them,
// and sin, cos, exp and ln need a dimensionless argument and return a dimensionless value. Canonical
// text lists base dimensions alphabetically ("Length*Mass*Time^-2"); "1" is dimensionless. Values are
// meant in coherent units of those dimensions. Constructors never fail on a mismatch; the check is the
// explicit `dimension_of` call, so an expression can still be built and inspected.

record DimVec {
    names: List<String>
    nums: List<Int>
    dens: List<Int>
}

record Frac {
    n: Int
    d: Int
}

fn dim_empty() -> DimVec {
    DimVec { names: [], nums: [], dens: [] }
}

fn dim_add_term(v: DimVec, name: String, n: Int, d: Int) -> DimVec {
    mut names: List<String> = []
    mut nums: List<Int> = []
    mut dens: List<Int> = []
    mut found = false
    for i in 0 until v.names.length() {
        if v.names[i] == name {
            found = true
            nn = v.nums[i] * d + n * v.dens[i]
            dd = v.dens[i] * d
            if nn != 0 {
                g = gcd_int(nn, dd)
                names.push(name)
                nums.push(nn / g)
                dens.push(dd / g)
            }
        } else {
            names.push(v.names[i])
            nums.push(v.nums[i])
            dens.push(v.dens[i])
        }
    }
    if not found and n != 0 {
        names.push(name)
        nums.push(n)
        dens.push(d)
    }
    DimVec { names: names, nums: nums, dens: dens }
}

fn dim_combine(a: DimVec, b: DimVec, sign: Int) -> DimVec {
    mut result = a
    for i in 0 until b.names.length() {
        result = dim_add_term(result, b.names[i], sign * b.nums[i], b.dens[i])
    }
    result
}

fn dim_scale(v: DimVec, n: Int, d: Int) -> DimVec {
    mut result = dim_empty()
    if n == 0 {
        return result
    }
    for i in 0 until v.names.length() {
        nn = v.nums[i] * n
        dd = v.dens[i] * d
        g = gcd_int(nn, dd)
        sign = if dd < 0 { 0 - 1 } else { 1 }
        result = dim_add_term(result, v.names[i], sign * (nn / g), sign * (dd / g))
    }
    result
}

fn dim_to_text(v: DimVec) -> String {
    if v.names.length() == 0 {
        return "1"
    }
    mut order: List<Int> = []
    for i in 0 until v.names.length() {
        mut next: List<Int> = []
        mut placed = false
        for j in order {
            if not placed and v.names[i] < v.names[j] {
                next.push(i)
                placed = true
            }
            next.push(j)
        }
        if not placed {
            next.push(i)
        }
        order = next
    }
    mut text = ""
    mut first = true
    for i in order {
        mut piece = v.names[i]
        if v.dens[i] == 1 {
            if v.nums[i] != 1 {
                piece = piece + "^" + v.nums[i].to_string()
            }
        } else {
            piece = piece + "^(" + v.nums[i].to_string() + "/" + v.dens[i].to_string() + ")"
        }
        if first {
            text = piece
            first = false
        } else {
            text = text + "*" + piece
        }
    }
    text
}

fn parse_frac(text: String) -> Result<Frac, String> {
    if text.length() == 0 {
        return Err("a dimension exponent after ^ must be an integer or n/d")
    }
    mut slash = 0 - 1
    for i in 0 until text.length() {
        if text.slice(i, i + 1) == "/" {
            slash = i
        }
    }
    if slash < 0 {
        return match text.to_int() {
            Ok(n) => Ok(Frac { n: n, d: 1 }),
            Err(message) => Err("dimension exponent '" + text + "' is not an integer or n/d"),
        }
    }
    match text.slice(0, slash).to_int() {
        Ok(n) => match text.slice(slash + 1, text.length()).to_int() {
            Ok(d) => {
                if d <= 0 {
                    return Err("dimension exponent '" + text + "' needs a positive denominator")
                }
                g = gcd_int(n, d)
                Ok(Frac { n: n / g, d: d / g })
            },
            Err(message) => Err("dimension exponent '" + text + "' is not an integer or n/d"),
        },
        Err(message) => Err("dimension exponent '" + text + "' is not an integer or n/d"),
    }
}

fn dim_parse(text: String) -> Result<DimVec, String> {
    digits = "0123456789"
    delimiters = " */^()-+,"
    mut v = dim_empty()
    n = text.length()
    mut i = 0
    mut sign = 1
    while i < n and text.slice(i, i + 1) == " " {
        i = i + 1
    }
    if i >= n or text.slice(i, n) == "1" {
        return Ok(v)
    }
    while i < n {
        while i < n and text.slice(i, i + 1) == " " {
            i = i + 1
        }
        start = i
        // A base dimension is any name that does not start with a digit and contains none of the
        // syntax characters, so digits after the first character and non-ASCII letters are allowed.
        if i < n and not digits.contains(text.slice(i, i + 1)) {
            while i < n and not delimiters.contains(text.slice(i, i + 1)) {
                i = i + 1
            }
        }
        if i == start {
            return Err("dimension '" + text + "' has an unexpected character at position " + start.to_string())
        }
        name = text.slice(start, i)
        mut exponent = Frac { n: 1, d: 1 }
        if i < n and text.slice(i, i + 1) == "^" {
            i = i + 1
            if i < n and text.slice(i, i + 1) == "(" {
                i = i + 1
                mut j = i
                while j < n and text.slice(j, j + 1) != ")" {
                    j = j + 1
                }
                if j >= n {
                    return Err("dimension '" + text + "' has an unclosed exponent")
                }
                match parse_frac(text.slice(i, j)) {
                    Ok(parsed) => {
                        exponent = parsed
                    },
                    Err(message) => {
                        return Err(message)
                    },
                }
                i = j + 1
            } else {
                mut j = i
                if j < n and text.slice(j, j + 1) == "-" {
                    j = j + 1
                }
                while j < n and digits.contains(text.slice(j, j + 1)) {
                    j = j + 1
                }
                match parse_frac(text.slice(i, j)) {
                    Ok(parsed) => {
                        exponent = parsed
                    },
                    Err(message) => {
                        return Err(message)
                    },
                }
                i = j
            }
        }
        v = dim_add_term(v, name, sign * exponent.n, exponent.d)
        while i < n and text.slice(i, i + 1) == " " {
            i = i + 1
        }
        if i < n {
            c = text.slice(i, i + 1)
            if c == "*" {
                sign = 1
            } else if c == "/" {
                sign = 0 - 1
            } else {
                return Err("dimension '" + text + "' has an unexpected character '" + c + "'")
            }
            i = i + 1
        }
    }
    Ok(v)
}

/// The dimension of node `id`, or the first inconsistency found below it.
fn dim_of(s: Store, id: Int) -> Result<String, String> {
    cached = s.dimmemo.get(id)
    match cached {
        Some(text) => {
            return Ok(text)
        },
        None => {},
    }
    kind = s.kinds[id]
    mut result = "1"
    if kind == 1 {
        result = s.dimtable[s.dens[id] - 1]
    }
    if kind == 2 {
        match dim_of(s, arg_of(s, id, 0)) {
            Ok(first) => {
                result = first
                for i in 1 until s.counts[id] {
                    match dim_of(s, arg_of(s, id, i)) {
                        Ok(other) => {
                            if other != first {
                                return Err("cannot add terms with different dimensions: " + first + " and " + other)
                            }
                        },
                        Err(message) => {
                            return Err(message)
                        },
                    }
                }
            },
            Err(message) => {
                return Err(message)
            },
        }
    }
    if kind == 3 {
        mut total = dim_empty()
        for i in 0 until s.counts[id] {
            match dim_of(s, arg_of(s, id, i)) {
                Ok(text) => {
                    match dim_parse(text) {
                        Ok(vector) => {
                            total = dim_combine(total, vector, 1)
                        },
                        Err(message) => {
                            return Err(message)
                        },
                    }
                },
                Err(message) => {
                    return Err(message)
                },
            }
        }
        result = dim_to_text(total)
    }
    if kind == 4 {
        base = arg_of(s, id, 0)
        exponent = arg_of(s, id, 1)
        match dim_of(s, base) {
            Ok(base_text) => {
                match dim_of(s, exponent) {
                    Ok(exponent_text) => {
                        if exponent_text != "1" {
                            return Err("an exponent must be dimensionless, got " + exponent_text)
                        }
                        if base_text != "1" {
                            if s.kinds[exponent] != 0 or s.dens[exponent] == 0 {
                                return Err("a dimensional base needs a small numeric exponent, got base " + base_text)
                            }
                            match dim_parse(base_text) {
                                Ok(vector) => {
                                    result = dim_to_text(dim_scale(vector, s.nums[exponent], s.dens[exponent]))
                                },
                                Err(message) => {
                                    return Err(message)
                                },
                            }
                        }
                    },
                    Err(message) => {
                        return Err(message)
                    },
                }
            },
            Err(message) => {
                return Err(message)
            },
        }
    }
    if kind == 5 {
        match dim_of(s, arg_of(s, id, 0)) {
            Ok(argument) => {
                if argument != "1" {
                    return Err(s.names[id] + " needs a dimensionless argument, got " + argument)
                }
            },
            Err(message) => {
                return Err(message)
            },
        }
    }
    s.dimmemo.set(id, result)
    Ok(result)
}

fn dim_index(s: Store, canonical: String) -> Int {
    for i in 0 until s.dimtable.length() {
        if s.dimtable[i] == canonical {
            return i
        }
    }
    s.dimtable.push(canonical)
    s.dimtable.length() - 1
}

/// A real symbol that carries a physical dimension such as "Mass*Length^2/Time^2" ("1" or "" is
/// dimensionless). The dimension text is canonicalized; a malformed one is an error.
pub fn unit_symbol(s: Store, name: String, dim_text: String, assumption: String = "real") -> Result<Expr, String> {
    match dim_parse(dim_text) {
        Ok(vector) => {
            bits = if assumption == "positive" {
                1
            } else if assumption == "nonzero" {
                2
            } else if assumption == "integer" {
                4
            } else {
                0
            }
            index = dim_index(s, dim_to_text(vector))
            Ok(wrap(s, intern(s, 1, bits, index + 1, name, [])))
        },
        Err(message) => Err(message),
    }
}

/// The canonical dimension of the expression, or the first dimensional inconsistency (adding
/// different dimensions, a dimensional argument to a transcendental function, a variable exponent
/// on a dimensional base).
pub fn dimension_of(a: Expr) -> Result<String, String> {
    dim_of(a.store, a.id)
}

/// The dimension as text, or "error: ..." with the inconsistency.
pub fn dimension_text(a: Expr) -> String {
    match dimension_of(a) {
        Ok(text) => text,
        Err(message) => "error: " + message,
    }
}

// ---------------------------------------------------------------- operators
//
// `+`, `-`, `*` and `/` build expressions directly, `-x` negates, and an Int on the left of an
// operator is read as an exact number (`2 * x`, `1 - x`). The right operand of an operator must be an
// Expr: write `x + symbolic.number(s, 1)`, or put the Int on the left. Powers stay explicit (`power`).

fn plus_expr(a: Expr, b: Expr) -> Expr {
    add(a, b)
}

fn minus_expr(a: Expr, b: Expr) -> Expr {
    sub(a, b)
}

fn times_expr(a: Expr, b: Expr) -> Expr {
    mul(a, b)
}

fn over_expr(a: Expr, b: Expr) -> Expr {
    div(a, b)
}

fn negate_expr(a: Expr) -> Expr {
    neg(a)
}

fn literal(a: Expr, k: Int) -> Expr {
    number(a.store, k)
}

impl Expr {
    fn neg(self) -> Expr { negate_expr(self) }
    fn radd(self, k: Int) -> Expr { plus_expr(literal(self, k), self) }
    fn rsub(self, k: Int) -> Expr { minus_expr(literal(self, k), self) }
    fn rmul(self, k: Int) -> Expr { times_expr(literal(self, k), self) }
    fn rdiv(self, k: Int) -> Expr { over_expr(literal(self, k), self) }
}

impl Add for Expr {
    fn add(self, other: Expr) -> Expr {
        plus_expr(self, other)
    }
}

impl Sub for Expr {
    fn sub(self, other: Expr) -> Expr {
        minus_expr(self, other)
    }
}

impl Mul for Expr {
    fn mul(self, other: Expr) -> Expr {
        times_expr(self, other)
    }
}

impl Div for Expr {
    fn div(self, other: Expr) -> Expr {
        over_expr(self, other)
    }
}

// ---------------------------------------------------------------- one variable over the rationals
//
// The functions below treat an expression as a polynomial in one symbol `v` whose coefficients do not
// contain `v`. The expression is expanded first, so a product of sums is read term by term. Anything
// else (a function of `v`, a negative or non-integer power of `v`, a power of a sum that cannot be
// expanded) fails with a message, and nothing is guessed. Solutions are exact: rational roots are
// rational, and an irrational quadratic root is written as (-b ± sqrt(D)) / (2a) with the discriminant
// D kept exact. A perfect-square discriminant is detected only while its numerator and denominator fit
// in 63 bits; beyond that the root stays in the sqrt form, which is still exact.

record Term {
    degree: Int
    coefficient: Int
}

/// One term of an expanded polynomial in `v`: its degree and the id of the product of its other factors.
fn term_split(s: Store, term: Int, v: Int) -> Result<Term, String> {
    mut degree = 0
    mut rest: List<Int> = []
    factors = if s.kinds[term] == 3 { args_of(s, term) } else { [term] }
    for f in factors {
        if f == v {
            degree = degree + 1
        } else if s.kinds[f] == 4 and arg_of(s, f, 0) == v {
            e = arg_of(s, f, 1)
            if s.kinds[e] != 0 {
                return Err("the exponent of the variable must be a number")
            }
            ex = rat_of(s, e)
            if ex.big != "" or ex.d != 1 or ex.n < 0 {
                return Err("the exponent of the variable must be a non-negative integer")
            }
            degree = degree + ex.n
        } else if not free_of(s, f, v) {
            return Err("the expression is not a polynomial in the variable")
        } else {
            rest.push(f)
        }
    }
    Ok(Term { degree: degree, coefficient: mul_ids(s, rest) })
}

/// The coefficients of `a` as a polynomial in `v`, ascending in degree: element i is the coefficient of v^i.
pub fn coefficients(a: Expr, v: Expr) -> Result<List<Expr>, String> {
    s = a.store
    if s.kinds[v.id] != 1 {
        return Err("the variable must be a symbol")
    }
    if s.failures.length() > 0 {
        return Err(s.failures[0])
    }
    expanded = expand_ids(s, a.id)
    if s.failures.length() > 0 {
        return Err(s.failures[0])
    }
    terms = if s.kinds[expanded] == 2 { args_of(s, expanded) } else { [expanded] }
    mut parts: List<Term> = []
    mut top = 0
    for t in terms {
        match term_split(s, t, v.id) {
            Err(message) => {
                return Err(message)
            },
            Ok(part) => {
                parts.push(part)
                if part.degree > top {
                    top = part.degree
                }
            },
        }
    }
    mut out: List<Expr> = []
    for k in 0 until top + 1 {
        mut same_degree: List<Int> = []
        for part in parts {
            if part.degree == k {
                same_degree.push(part.coefficient)
            }
        }
        out.push(wrap(s, add_ids(s, same_degree)))
    }
    Ok(out)
}

/// The coefficients as exact rationals, or a failure naming the first coefficient that is not a number.
fn exact_coefficients(s: Store, cs: List<Expr>) -> Result<List<Rat>, String> {
    mut out: List<Rat> = []
    for c in cs {
        if s.kinds[c.id] != 0 {
            return Err("solving needs exact rational coefficients; a coefficient depends on another symbol")
        }
        out.push(rat_of(s, c.id))
    }
    Ok(out)
}

/// The integer square root of n when n is a perfect square with 0 <= n <= 3037000499^2, else -1.
fn exact_isqrt(n: Int) -> Int {
    if n < 0 or n > 9223372030926249001 {
        return 0 - 1
    }
    mut lo = 0
    mut hi = 3037000499
    while lo < hi {
        mid = (lo + hi + 1) / 2
        if mid * mid <= n {
            lo = mid
        } else {
            hi = mid - 1
        }
    }
    if lo * lo == n {
        return lo
    }
    0 - 1
}

/// Roots of the exact polynomial with ascending rational coefficients `c`.
fn solve_rationals(s: Store, c: List<Rat>) -> Result<List<Expr>, String> {
    mut top = c.length() - 1
    while top >= 0 and rat_is_zero(c[top]) {
        top = top - 1
    }
    if top < 0 {
        return Err("every value is a solution: the expression is zero")
    }
    if top == 0 {
        return Ok([])
    }
    if top == 1 {
        root = rat(s, 0 - c[0].n * c[1].d, c[0].d * c[1].n)
        return Ok([wrap(s, num_id(s, root))])
    }
    if top == 2 {
        return solve_quadratic(s, c[2], c[1], c[0])
    }
    polynomial_roots(s, c, top)
}

/// Roots of a x^2 + b x + c = 0 with a nonzero. Negative discriminants fail: complex roots are not represented.
fn solve_quadratic(s: Store, a: Rat, b: Rat, c: Rat) -> Result<List<Expr>, String> {
    if a.big != "" or b.big != "" or c.big != "" {
        return Err("the coefficients are too large for the closed form")
    }
    disc = rat_add(s, rat_mul(s, b, b), rat_mul(s, rat(s, 0 - 4 * a.n, a.d), c))
    if disc.big == "" and disc.n < 0 {
        return Err("the discriminant is negative: the roots are complex, which is not represented")
    }
    if disc.big != "" {
        return Err("the discriminant is too large for the closed form")
    }
    neg_b = rat(s, 0 - b.n, b.d)
    two_a_inverse = rat(s, a.d, 2 * a.n)
    sq_n = exact_isqrt(disc.n)
    sq_d = exact_isqrt(disc.d)
    if sq_n >= 0 and sq_d >= 0 {
        r1 = rat_mul(s, rat_add(s, neg_b, rat(s, sq_n, sq_d)), two_a_inverse)
        r2 = rat_mul(s, rat_add(s, neg_b, rat(s, 0 - sq_n, sq_d)), two_a_inverse)
        if disc.n == 0 {
            return Ok([wrap(s, num_id(s, r1))])
        }
        return Ok([wrap(s, num_id(s, r1)), wrap(s, num_id(s, r2))])
    }
    if disc.n <= 1000000000000 and disc.d <= 1000000 and disc.n * disc.d <= 1000000000000 {
        return radical_roots(s, disc, neg_b, two_a_inverse)
    }
    sqrt_id = pow_ids(s, num_id(s, disc), num_id(s, rat(s, 1, 2)))
    neg_b_id = num_id(s, neg_b)
    inverse_id = num_id(s, two_a_inverse)
    plus = mul_ids(s, [add_ids(s, [neg_b_id, sqrt_id]), inverse_id])
    minus = mul_ids(s, [add_ids(s, [neg_b_id, mul_ids(s, [int_id(s, 0 - 1), sqrt_id])]), inverse_id])
    Ok([wrap(s, plus), wrap(s, minus)])
}

/// Splits n = k * k * m with m squarefree, for 1 <= n <= 10^12.
fn square_split(n: Int) -> List<Int> {
    mut k = 1
    mut m = n
    mut f = 2
    while f * f <= m {
        while m % (f * f) == 0 {
            m = m / (f * f)
            k = k * f
        }
        f = f + 1
    }
    [k, m]
}

/// The two roots (-b +- sqrt(disc)) / (2a), written as p +- q * m^(1/2) with m squarefree, so 2^(1/2) and not 8^(1/2).
/// sqrt(n / d) is sqrt(n * d) / d; the square part of n * d is taken out, so the radical is always reduced.
fn radical_roots(s: Store, disc: Rat, neg_b: Rat, two_a_inverse: Rat) -> Result<List<Expr>, String> {
    parts = square_split(disc.n * disc.d)
    k = parts[0]
    m = parts[1]
    shift = rat_mul(s, neg_b, two_a_inverse)
    spread = rat_mul(s, rat(s, k, disc.d), two_a_inverse)
    if shift.big != "" or spread.big != "" {
        return Err("the coefficients are too large for the closed form")
    }
    root_form = pow_ids(s, int_id(s, m), num_id(s, rat(s, 1, 2)))
    shift_id = num_id(s, shift)
    plus = add_ids(s, [shift_id, mul_ids(s, [num_id(s, spread), root_form])])
    minus = add_ids(s, [shift_id, mul_ids(s, [num_id(s, rat(s, 0 - spread.n, spread.d)), root_form])])
    Ok([wrap(s, plus), wrap(s, minus)])
}

/// The result of splitting a polynomial over the rationals: the rational roots (one text per linear factor, in
/// the polynomial module's order), the degree of what is left, and the leftover constant when nothing is left.
record Split {
    roots: List<String>
    leftover_degree: Int
    constant: String
}

/// Splits a polynomial with exact rational coefficients by the polynomial module's rational root search.
fn split_polynomial(c: List<Rat>, top: Int) -> Result<Split, String> {
    mut texts: List<String> = []
    for i in 0 until top + 1 {
        texts.push(rat_text_of(c[i]))
    }
    match polynomial.poly_from_texts(texts) {
        Err(message) => Err(message),
        Ok(p) => match polynomial.poly_factor_linear(p) {
            Err(message) => Err(message),
            Ok(f) => {
                mut roots: List<String> = []
                for factor in f.factors {
                    roots.push(factor.coeffs[0])
                }
                leftover = f.cofactor.coeffs.length() - 1
                constant = if leftover == 0 { f.cofactor.coeffs[0] } else { "" }
                Ok(Split { roots: roots, leftover_degree: leftover, constant: constant })
            },
        },
    }
}

/// Rational roots of a polynomial of degree 3 or more, when it splits completely over the rationals.
/// A leftover factor without a rational root fails with its degree: its exact solution is not implemented.
fn polynomial_roots(s: Store, c: List<Rat>, top: Int) -> Result<List<Expr>, String> {
    match split_polynomial(c, top) {
        Err(message) => Err(message),
        Ok(f) => {
            if f.leftover_degree != 0 {
                return Err("a factor of degree " + f.leftover_degree.to_string() + " has no rational root; its exact solution is not implemented")
            }
            mut roots: List<Expr> = []
            mut seen: List<String> = []
            for text in f.roots {
                root = rat_neg_text(s, text)
                key = rat_text_of(root)
                if not text_in(seen, key) {
                    seen.push(key)
                    roots.push(wrap(s, num_id(s, root)))
                }
            }
            Ok(roots)
        },
    }
}

/// The exact rational written by `text`, failing the store when it does not fit the closed form.
fn rat_from_checked(s: Store, text: String) -> Rat {
    r = rat_from_text(s, text)
    if r.big != "" {
        fail(s, "the coefficient is too large for the closed form")
        return Rat { n: 0, d: 1, big: "" }
    }
    r
}

/// The root r of the linear factor (x - r), given its constant term `text`, which is -r.
fn rat_neg_text(s: Store, text: String) -> Rat {
    r = rat_from_checked(s, text)
    rat(s, 0 - r.n, r.d)
}

/// The exact solutions of a(v) = 0 for a polynomial a in the symbol v, with exact rational coefficients.
/// Degree 1 and 2 are closed forms; degree 3 and more return the rational roots when the polynomial splits
/// completely over the rationals, and fail otherwise.
pub fn solve_polynomial(a: Expr, v: Expr) -> Result<List<Expr>, String> {
    match coefficients(a, v) {
        Err(message) => Err(message),
        Ok(cs) => {
            if cs.length() == 0 {
                return Err("every value is a solution: the expression is zero")
            }
            s = cs[0].store
            match exact_coefficients(s, cs) {
                Err(message) => Err(message),
                Ok(c) => solve_rationals(s, c),
            }
        },
    }
}

/// a(v) as a product of linear factors (v - r) with rational r, times a rational constant. Fails when a does not
/// split completely over the rationals; the message names the degree of the part that has no rational root.
pub fn factor_rational(a: Expr, v: Expr) -> Result<Expr, String> {
    match coefficients(a, v) {
        Err(message) => Err(message),
        Ok(cs) => {
            if cs.length() == 0 {
                return Err("the zero expression has no factorization")
            }
            s = cs[0].store
            match exact_coefficients(s, cs) {
                Err(message) => Err(message),
                Ok(c) => factor_rationals(s, v, c),
            }
        },
    }
}

fn factor_rationals(s: Store, v: Expr, c: List<Rat>) -> Result<Expr, String> {
    mut top = c.length() - 1
    while top >= 0 and rat_is_zero(c[top]) {
        top = top - 1
    }
    match split_polynomial(c, top) {
        Err(message) => Err(message),
        Ok(f) => {
            if f.leftover_degree != 0 {
                return Err("a factor of degree " + f.leftover_degree.to_string() + " has no rational root; its factorization over the rationals is not implemented")
            }
            mut product = wrap(s, num_id(s, rat_from_text(s, f.constant)))
            for text in f.roots {
                // The factor's constant term is -r, so (v - r) is v plus that constant.
                linear = add(v, wrap(s, num_id(s, rat_from_checked(s, text))))
                product = mul(product, linear)
            }
            Ok(product)
        },
    }
}

/// The solutions of a(v) = 0 as text, separated by ", ", or "error: ..." with the typed message.
pub fn roots_text(a: Expr, v: Expr) -> String {
    match solve_polynomial(a, v) {
        Ok(roots) => {
            mut text = ""
            for i in 0 until roots.length() {
                if i > 0 {
                    text = text + ", "
                }
                text = text + show(roots[i])
            }
            text
        },
        Err(message) => "error: " + message,
    }
}

/// True when the expansion of a with v replaced by r is the number zero.
pub fn is_root(a: Expr, v: Expr, r: Expr) -> Bool {
    same(expand(subs(a, v, r)), number(a.store, 0))
}

fn text_in(items: List<String>, text: String) -> Bool {
    for item in items {
        if item == text {
            return true
        }
    }
    false
}

// ---------------------------------------------------------------- explicit assumptions
//
// A Context is a value: a list of facts about named symbols. It is separate from the expression store: an expression
// is analysed under any number of contexts without rebuilding its symbols, and assuming a fact returns a new context
// and leaves the old one unchanged. Symbols are real unless a context says otherwise.
//
// Reasoning is conservative. A fact is derived only from the closure below. `holds` answers "true" when the facts
// prove a kind, "false" when they refute it, and "unknown" otherwise; "unknown" is never reported as "false".

/// A fact about one named symbol. `kind` is one of: real, complex, positive, negative, nonnegative, nonpositive,
/// nonzero (zero is derived, never assumed directly).
pub record Fact {
    name: String
    kind: String
}

/// An immutable set of facts.
pub record Context {
    facts: List<Fact>
}

/// The result of a conditional rule. `required` are the conditions the rewritten expression needs to equal the
/// original; `established` are those the context proves; `unknown` are those it neither proves nor refutes. `status`
/// is "applied" (every required condition is established), "applied-conditional" (some are unknown: the result holds
/// only where they hold, and they are listed), or "refused" (the rule does not apply; `value` is the original).
/// One condition of a validity: `expr relation bound`, with relation one of !=, >, >=, <, <=. The expression is
/// kept, so the condition can be checked at points after the rule has been applied. `text` is its readable form.
pub record Condition {
    expr: Expr
    relation: String
    bound: Float
    text: String
}

fn condition(e: Expr, relation: String, bound: Float, text: String) -> Condition {
    Condition { expr: e, relation: relation, bound: bound, text: text }
}

pub record Outcome {
    rule: String
    conditions: List<Condition>
    original: String
    transformed: String
    value: Expr
    status: String
    required: List<String>
    established: List<String>
    unknown: List<String>
    reason: String
}

fn known_kinds() -> List<String> {
    ["real", "complex", "positive", "negative", "nonnegative", "nonpositive", "nonzero"]
}

/// The empty context: every symbol real, no other facts.
pub fn context() -> Context {
    Context { facts: [] }
}

/// The kinds of one symbol, closed under the implications between kinds: positive implies nonzero, nonnegative and
/// real; negative implies nonzero, nonpositive and real; nonnegative together with nonpositive implies zero.
fn closure_of(c: Context, name: String) -> List<String> {
    mut start: List<String> = []
    for f in c.facts {
        if f.name == name {
            start.push(f.kind)
        }
    }
    closure_of_kinds(start)
}

fn closure_of_kinds(start: List<String>) -> List<String> {
    mut kinds: List<String> = []
    for k in start {
        if not text_in(kinds, k) {
            kinds.push(k)
        }
    }
    mut changed = true
    while changed {
        changed = false
        mut derived: List<String> = []
        if text_in(kinds, "positive") {
            derived.push("nonzero")
            derived.push("nonnegative")
            derived.push("real")
        }
        if text_in(kinds, "negative") {
            derived.push("nonzero")
            derived.push("nonpositive")
            derived.push("real")
        }
        if text_in(kinds, "nonnegative") and text_in(kinds, "nonpositive") {
            derived.push("zero")
        }
        for k in derived {
            if not text_in(kinds, k) {
                kinds.push(k)
                changed = true
            }
        }
    }
    kinds
}

/// The kinds given to a symbol node by the older symbol(s, name, assumption) API: bit 1 is positive, bit 2 is nonzero.
/// Bit 4 (integer) is not an ordering kind and is not used here.
fn legacy_kinds(s: Store, id: Int) -> List<String> {
    mut kinds: List<String> = []
    if s.nums[id] % 2 == 1 {
        kinds.push("positive")
    }
    if s.nums[id] % 4 >= 2 {
        kinds.push("nonzero")
    }
    kinds
}

/// The kinds of a symbol node: the context's facts for its name together with the node's built-in assumption, closed
/// under the implications. A context and a built-in assumption are combined, never one overriding the other.
fn node_kinds(c: Context, s: Store, id: Int) -> List<String> {
    mut start = closure_of(c, s.names[id])
    for k in legacy_kinds(s, id) {
        start.push(k)
    }
    closure_of_kinds(start)
}

/// The conflict between the built-in assumption and the context, as text; empty when they agree.
fn node_conflict(c: Context, s: Store, id: Int) -> String {
    conflict_in(node_kinds(c, s, id))
}

/// "true", "false" or "unknown" for a kind of a symbol node, combining the context and the built-in assumption.
fn holds_node(c: Context, s: Store, id: Int, kind: String) -> String {
    kinds = node_kinds(c, s, id)
    if conflict_in(kinds) != "" {
        return "contradictory"
    }
    if kind == "real" {
        if text_in(kinds, "complex") {
            return "false"
        }
        return "true"
    }
    if text_in(kinds, kind) {
        return "true"
    }
    if refuted_by(kinds, kind) {
        return "false"
    }
    "unknown"
}

/// Pairs of kinds that cannot hold together for one symbol. A complex symbol has no ordering, so it conflicts with
/// every ordering kind and with real.
fn conflict_firsts() -> List<String> {
    ["positive", "positive", "positive", "negative", "negative", "nonzero", "complex", "complex", "complex", "complex", "complex", "complex"]
}

fn conflict_seconds() -> List<String> {
    ["negative", "nonpositive", "zero", "nonnegative", "zero", "zero", "positive", "negative", "nonnegative", "nonpositive", "zero", "real"]
}

/// The first conflicting pair among the kinds, as text; empty when they are consistent.
fn conflict_in(kinds: List<String>) -> String {
    firsts = conflict_firsts()
    seconds = conflict_seconds()
    for i in 0 until firsts.length() {
        if text_in(kinds, firsts[i]) and text_in(kinds, seconds[i]) {
            return firsts[i] + " and " + seconds[i]
        }
    }
    ""
}

/// True when `kind` is excluded by one of the kinds in the list.
fn refuted_by(kinds: List<String>, kind: String) -> Bool {
    firsts = conflict_firsts()
    seconds = conflict_seconds()
    for i in 0 until firsts.length() {
        if firsts[i] == kind and text_in(kinds, seconds[i]) {
            return true
        }
        if seconds[i] == kind and text_in(kinds, firsts[i]) {
            return true
        }
    }
    false
}

/// Assumes one fact about a symbol. An unknown kind, or a contradiction with the facts already in the context, is an
/// error that names the conflicting pair; the context is not changed, because a new one is returned only on success.
pub fn assume(c: Context, name: String, kind: String) -> Result<Context, String> {
    if not text_in(known_kinds(), kind) {
        return Err("unknown assumption " + kind + ": use real, complex, positive, negative, nonnegative, nonpositive or nonzero")
    }
    mut facts: List<Fact> = []
    for f in c.facts {
        facts.push(f)
    }
    facts.push(Fact { name: name, kind: kind })
    next = Context { facts: facts }
    conflict = conflict_in(closure_of(next, name))
    if conflict != "" {
        return Err("contradictory assumptions for " + name + ": " + conflict)
    }
    Ok(next)
}

/// Assumes that a symbol lies in the interval with the given bounds, open or closed at each end. The interval is used
/// through the sign facts it implies (a closed interval [0, b] implies nonnegative) and through its emptiness; general
/// interval arithmetic is not performed.
pub fn assume_interval(c: Context, name: String, lower: Float, lower_closed: Bool, upper: Float, upper_closed: Bool) -> Result<Context, String> {
    if lower > upper or (lower == upper and not (lower_closed and upper_closed)) {
        return Err("the interval for " + name + " is empty")
    }
    mut kinds: List<String> = []
    if lower > 0.0 or (lower == 0.0 and not lower_closed) {
        kinds.push("positive")
    } else if lower == 0.0 {
        kinds.push("nonnegative")
    }
    if upper < 0.0 or (upper == 0.0 and not upper_closed) {
        kinds.push("negative")
    } else if upper == 0.0 {
        kinds.push("nonpositive")
    }
    mut next = c
    for k in kinds {
        match assume(next, name, k) {
            Ok(n) => {
                next = n
            },
            Err(message) => {
                return Err(message)
            },
        }
    }
    Ok(next)
}

/// "true" when the context proves the kind for the symbol, "false" when it refutes it, "unknown" otherwise, and
/// "contradictory" when the facts for the symbol are inconsistent (then nothing is proved). A symbol is real unless the
/// context says it is complex, so "real" holds by default.
pub fn holds(c: Context, name: String, kind: String) -> String {
    kinds = closure_of(c, name)
    if conflict_in(kinds) != "" {
        return "contradictory"
    }
    if kind == "real" {
        if text_in(kinds, "complex") {
            return "false"
        }
        return "true"
    }
    if text_in(kinds, kind) {
        return "true"
    }
    if refuted_by(kinds, kind) {
        return "false"
    }
    "unknown"
}

/// "true", "false" or "unknown" for a kind of an expression that is a symbol: the context's facts for its name, together
/// with the symbol's built-in assumption from the older API. A contradiction between them is reported as "false" for
/// the kinds it excludes and by sign_of as "contradictory". Non-symbols are "unknown" for every kind except real.
pub fn knows(c: Context, a: Expr, kind: String) -> String {
    if a.store.kinds[a.id] != 1 {
        if kind == "real" {
            return "unknown"
        }
        return "unknown"
    }
    holds_node(c, a.store, a.id, kind)
}

/// Name-based query: uses only the context's facts for the name. Use knows for an expression, which also includes the
/// built-in assumption of the symbol.
/// A readable list of the facts of a context, in the order they were assumed.
pub fn describe(c: Context) -> String {
    if c.facts.length() == 0 {
        return "no assumptions (every symbol real)"
    }
    mut text = ""
    for i in 0 until c.facts.length() {
        piece = c.facts[i].name + " " + c.facts[i].kind
        if i == 0 {
            text = piece
        } else {
            text = text + ", " + piece
        }
    }
    text
}

// ---------------------------------------------------------------- signs

/// The sign of a node under the context, from its structure. "unknown" means the engine could not prove a sign; it never
/// means that the expression has none.
fn sign_id(c: Context, s: Store, id: Int) -> String {
    kind = s.kinds[id]
    if kind == 0 {
        if s.dens[id] == 0 {
            if s.names[id].starts_with("-") {
                return "negative"
            }
            return "positive"
        }
        if s.nums[id] > 0 {
            return "positive"
        }
        if s.nums[id] < 0 {
            return "negative"
        }
        return "zero"
    }
    if kind == 1 {
        if node_conflict(c, s, id) != "" {
            return "contradictory"
        }
        kinds = node_kinds(c, s, id)
        if text_in(kinds, "positive") {
            return "positive"
        }
        if text_in(kinds, "negative") {
            return "negative"
        }
        if text_in(kinds, "zero") {
            return "zero"
        }
        if text_in(kinds, "nonnegative") {
            return "nonnegative"
        }
        if text_in(kinds, "nonpositive") {
            return "nonpositive"
        }
        if text_in(kinds, "nonzero") {
            return "nonzero"
        }
        return "unknown"
    }
    if kind == 2 {
        mut all_positive = true
        mut all_nonneg = true
        mut all_nonpos = true
        mut all_negative = true
        for i in 0 until s.counts[id] {
            t = sign_id(c, s, arg_of(s, id, i))
            if t != "positive" {
                all_positive = false
            }
            if not (t == "positive" or t == "nonnegative" or t == "zero") {
                all_nonneg = false
            }
            if not (t == "negative" or t == "nonpositive" or t == "zero") {
                all_nonpos = false
            }
            if t != "negative" {
                all_negative = false
            }
        }
        if all_positive {
            return "positive"
        }
        if all_negative {
            return "negative"
        }
        if all_nonneg {
            return "nonnegative"
        }
        if all_nonpos {
            return "nonpositive"
        }
        return "unknown"
    }
    if kind == 3 {
        mut zero = false
        mut unknown = false
        mut strict = true
        mut negatives = 0
        for i in 0 until s.counts[id] {
            t = sign_id(c, s, arg_of(s, id, i))
            if t == "zero" {
                zero = true
            } else if t == "negative" {
                negatives = negatives + 1
            } else if t == "nonnegative" {
                strict = false
            } else if t == "nonpositive" {
                strict = false
                negatives = negatives + 1
            } else if t != "positive" {
                unknown = true
            }
        }
        if zero {
            return "zero"
        }
        if unknown {
            return "unknown"
        }
        negative = negatives % 2 == 1
        if strict {
            if negative {
                return "negative"
            }
            return "positive"
        }
        if negative {
            return "nonpositive"
        }
        return "nonnegative"
    }
    if kind == 4 {
        base = arg_of(s, id, 0)
        exponent = arg_of(s, id, 1)
        base_sign = sign_id(c, s, base)
        if base_sign == "positive" {
            return "positive"
        }
        if is_int_num(s, exponent) and s.nums[exponent] > 0 and s.nums[exponent] % 2 == 0 {
            if base_sign == "positive" or base_sign == "negative" or base_sign == "nonzero" {
                return "positive"
            }
            return "nonnegative"
        }
        return "unknown"
    }
    if kind == 5 {
        name = s.names[id]
        if name == "exp" {
            return "positive"
        }
        if name == "abs" {
            return "nonnegative"
        }
        return "unknown"
    }
    "unknown"
}

/// The sign of an expression under a context: positive, negative, zero, nonnegative, nonpositive, nonzero or unknown.
pub fn sign_of(c: Context, a: Expr) -> String {
    sign_id(c, a.store, a.id)
}

// ---------------------------------------------------------------- conditional rules

fn applied_status(unknown: List<String>) -> String {
    if unknown.length() == 0 {
        return "applied"
    }
    "applied-conditional"
}

/// sqrt(u^2) for a symbol u. For real u the identity is sqrt(u^2) = abs(u), with no condition. When the context shows
/// u >= 0 the result is u; when it shows u <= 0 the result is -u. For complex u the identity is not valid on the
/// principal branch, so the rule is refused; so it is when u is not a symbol.
pub fn sqrt_of_square(c: Context, u: Expr) -> Outcome {
    s = u.store
    square_id = pow_ids(s, u.id, int_id(s, 2))
    root_id = pow_ids(s, square_id, num_id(s, rat(s, 1, 2)))
    original = show(wrap(s, root_id))
    if s.kinds[u.id] != 1 {
        return Outcome { conditions: [], rule: "sqrt-of-square", original: original, transformed: original, value: wrap(s, root_id), status: "refused", required: [], established: [], unknown: [], reason: "the rule is stated for a symbol; the argument is not a symbol" }
    }
    name = s.names[u.id]
    if node_conflict(c, s, u.id) != "" {
        return Outcome { conditions: [], rule: "sqrt-of-square", original: original, transformed: original, value: wrap(s, root_id), status: "refused", required: [], established: [], unknown: [], reason: "the built-in assumption of " + name + " contradicts the context: " + node_conflict(c, s, u.id) }
    }
    if holds_node(c, s, u.id, "real") != "true" {
        return Outcome { conditions: [], rule: "sqrt-of-square", original: original, transformed: original, value: wrap(s, root_id), status: "refused", required: [], established: [], unknown: [], reason: "sqrt(x^2) = abs(x) holds for real x only, and " + name + " is not known to be real" }
    }
    sign = sign_of(c, u)
    if sign == "contradictory" {
        return Outcome { conditions: [], rule: "sqrt-of-square", original: original, transformed: original, value: wrap(s, root_id), status: "refused", required: [], established: [], unknown: [], reason: "the sign of " + name + " is contradictory in this context" }
    }
    if sign == "positive" or sign == "nonnegative" or sign == "zero" {
        return Outcome { conditions: [condition(u, ">=", 0.0, name + " >= 0")], rule: "sqrt-of-square", original: original, transformed: name, value: u, status: "applied", required: [name + " >= 0"], established: [name + " >= 0"], unknown: [], reason: "the context shows " + name + " >= 0, so sqrt(x^2) = x" }
    }
    if sign == "negative" or sign == "nonpositive" {
        negated = wrap(s, mul_ids(s, [int_id(s, 0 - 1), u.id]))
        return Outcome { conditions: [condition(u, "<=", 0.0, name + " <= 0")], rule: "sqrt-of-square", original: original, transformed: "-" + name, value: negated, status: "applied", required: [name + " <= 0"], established: [name + " <= 0"], unknown: [], reason: "the context shows " + name + " <= 0, so sqrt(x^2) = -x" }
    }
    absolute = wrap(s, intern(s, 5, 0, 1, "abs", [u.id]))
    Outcome { conditions: [], rule: "sqrt-of-square", original: original, transformed: "abs(" + name + ")", value: absolute, status: "applied", required: [], established: [], unknown: [], reason: "for real " + name + ", sqrt(x^2) = abs(x); the sign of " + name + " is not needed and is not assumed" }
}

/// Cancels the factor (x - r) of numerator / denominator, when the denominator is linear in the symbol v with root r
/// and the numerator vanishes at r. The quotient is exact. The condition v != r of the original is kept in `required`;
/// it is listed as established only when the context proves it (v nonzero when r = 0; v positive when r < 0;
/// v negative when r > 0), and as unknown otherwise.
pub fn simplify_quotient(c: Context, numerator: Expr, denominator: Expr, v: Expr) -> Outcome {
    s = v.store
    original_expr = div(numerator, denominator)
    original = show(original_expr)
    name = if s.kinds[v.id] == 1 { s.names[v.id] } else { "x" }
    return match coefficients(denominator, v) {
        Err(message) => refusal_outcome("cancel-factor", original, original_expr, "the denominator is not a polynomial in the variable: " + message),
        Ok(dcs) => match exact_coefficients(s, dcs) {
            Err(message) => refusal_outcome("cancel-factor", original, original_expr, "the denominator does not have exact rational coefficients: " + message),
            Ok(dr) => match coefficients(numerator, v) {
                Err(message) => refusal_outcome("cancel-factor", original, original_expr, "the numerator is not a polynomial in the variable: " + message),
                Ok(ncs) => match exact_coefficients(s, ncs) {
                    Err(message) => refusal_outcome("cancel-factor", original, original_expr, "the numerator does not have exact rational coefficients: " + message),
                    Ok(nr) => cancel_linear(c, s, v, name, original, original_expr, dr, nr),
                },
            },
        },
    }
}

/// A refused rule: the original expression is kept and the reason is stated.
fn refusal_outcome(rule: String, original: String, value: Expr, reason: String) -> Outcome {
    Outcome { conditions: [], rule: rule, original: original, transformed: original, value: value, status: "refused", required: [], established: [], unknown: [], reason: reason }
}

fn cancel_linear(c: Context, s: Store, v: Expr, name: String, original: String, original_expr: Expr, dr: List<Rat>, nr: List<Rat>) -> Outcome {
    if dr.length() != 2 or rat_is_zero(dr[1]) or nr.length() < 2 {
        return Outcome { conditions: [], rule: "cancel-factor", original: original, transformed: original, value: original_expr, status: "refused", required: [], established: [], unknown: [], reason: "the denominator is not linear in " + name }
    }
    a = dr[1]
    // denominator = a (x - r) with r = -b / a, where b = dr[0]
    r = rat_mul(s, rat(s, 0 - dr[0].n, dr[0].d), rat(s, a.d, a.n))
    if r.big != "" {
        return Outcome { conditions: [], rule: "cancel-factor", original: original, transformed: original, value: original_expr, status: "refused", required: [], established: [], unknown: [], reason: "the root is too large for an exact cancellation" }
    }
    // The numerator must vanish at r, evaluated exactly.
    mut total = rat(s, 0, 1)
    mut pw = rat(s, 1, 1)
    for k in 0 until nr.length() {
        total = rat_add(s, total, rat_mul(s, nr[k], pw))
        pw = rat_mul(s, pw, r)
    }
    if not rat_is_zero(total) {
        return Outcome { conditions: [], rule: "cancel-factor", original: original, transformed: original, value: original_expr, status: "refused", required: [], established: [], unknown: [], reason: "the numerator does not vanish at the root, so nothing cancels" }
    }
    // Synthetic division of the ascending numerator coefficients by (x - r). The quotient coefficients are produced from
    // the highest degree down: descending[i] is the coefficient of x^(deg - 1 - i).
    deg = nr.length() - 1
    mut descending: List<Rat> = []
    mut current = nr[deg]
    descending.push(current)
    for j in 1 until deg {
        k = deg - j
        current = rat_add(s, nr[k], rat_mul(s, r, current))
        descending.push(current)
    }
    scale = rat(s, a.d, a.n)
    mut terms: List<Int> = []
    for i in 0 until descending.length() {
        power_index = deg - 1 - i
        coefficient = num_id(s, rat_mul(s, descending[i], scale))
        if power_index == 0 {
            terms.push(coefficient)
        } else {
            terms.push(mul_ids(s, [coefficient, pow_ids(s, v.id, int_id(s, power_index))]))
        }
    }
    result_id = add_ids(s, terms)
    rtext = rat_text_of(r)
    condition_text = name + " != " + rtext
    mut unknown: List<String> = []
    mut established: List<String> = []
    if rat_is_zero(r) and holds_node(c, s, v.id, "nonzero") == "true" {
        established.push(condition_text)
    } else if r.n < 0 and sign_of(c, v) == "positive" {
        established.push(condition_text)
    } else if r.n > 0 and sign_of(c, v) == "negative" {
        established.push(condition_text)
    } else {
        unknown.push(condition_text)
    }
    mut required: List<String> = []
    required.push(condition_text)
    root_value = (r.n as Float) / (r.d as Float)
    Outcome { conditions: [condition(v, "!=", root_value, condition_text)], rule: "cancel-factor", original: original, transformed: show(wrap(s, result_id)), value: wrap(s, result_id), status: applied_status(unknown), required: required, established: established, unknown: unknown, reason: "the factor " + name + " - " + rtext + " cancels; the original is undefined at " + name + " = " + rtext + ", so the result is kept with that condition" }
}

/// x / x for a symbol x. The result 1 requires x != 0. When the context proves it, the rule is applied. When the context
/// does not decide it, the result is given with x != 0 listed as unknown. When the context says x = 0, the rule is refused.
pub fn simplify_self_quotient(c: Context, x: Expr) -> Outcome {
    s = x.store
    name = s.names[x.id]
    original_expr = div(x, x)
    original = show(original_expr)
    condition_text = name + " != 0"
    if node_conflict(c, s, x.id) != "" {
        return Outcome { conditions: [], rule: "self-quotient", original: original, transformed: original, value: original_expr, status: "refused", required: [condition_text], established: [], unknown: [], reason: "the built-in assumption of " + name + " contradicts the context" }
    }
    verdict = holds_node(c, s, x.id, "nonzero")
    if verdict == "false" {
        return Outcome { conditions: [], rule: "self-quotient", original: original, transformed: original, value: original_expr, status: "refused", required: [condition_text], established: [], unknown: [], reason: name + " is zero in this context, so " + name + " / " + name + " is undefined" }
    }
    mut unknown: List<String> = []
    mut established: List<String> = []
    if verdict == "true" {
        established.push(condition_text)
    } else {
        unknown.push(condition_text)
    }
    mut required: List<String> = []
    required.push(condition_text)
    Outcome { conditions: [condition(x, "!=", 0.0, condition_text)], rule: "self-quotient", original: original, transformed: "1", value: wrap(s, int_id(s, 1)), status: applied_status(unknown), required: required, established: established, unknown: unknown, reason: name + " / " + name + " = 1 when " + condition_text + "; the context gives: " + verdict }
}

/// ln(a b) = ln(a) + ln(b) is applied only when both a and b are positive in the context. Otherwise it is refused and the
/// conditions are listed: the splitting is not an identity for arbitrary real or complex arguments.
pub fn expand_log_product(c: Context, a: Expr, b: Expr) -> Outcome {
    s = a.store
    product_id = mul_ids(s, [a.id, b.id])
    original = show(wrap(s, intern(s, 5, 0, 1, "ln", [product_id])))
    ca = show(a) + " > 0"
    cb = show(b) + " > 0"
    mut established: List<String> = []
    mut unknown: List<String> = []
    if sign_of(c, a) == "positive" {
        established.push(ca)
    } else {
        unknown.push(ca)
    }
    if sign_of(c, b) == "positive" {
        if cb != ca {
            established.push(cb)
        }
    } else {
        if cb != ca {
            unknown.push(cb)
        }
    }
    mut required: List<String> = []
    required.push(ca)
    if cb != ca {
        required.push(cb)
    }
    original_id = intern(s, 5, 0, 1, "ln", [product_id])
    if unknown.length() == 0 {
        split_id = add_ids(s, [intern(s, 5, 0, 1, "ln", [a.id]), intern(s, 5, 0, 1, "ln", [b.id])])
        return Outcome { conditions: [condition(a, ">", 0.0, ca), condition(b, ">", 0.0, cb)], rule: "log-of-product", original: original, transformed: show(wrap(s, split_id)), value: wrap(s, split_id), status: "applied", required: required, established: established, unknown: unknown, reason: "both factors are positive in this context, so ln(a b) = ln(a) + ln(b)" }
    }
    Outcome { conditions: [condition(a, ">", 0.0, ca), condition(b, ">", 0.0, cb)], rule: "log-of-product", original: original, transformed: original, value: wrap(s, original_id), status: "refused", required: required, established: established, unknown: unknown, reason: "ln(a b) = ln(a) + ln(b) needs a > 0 and b > 0, and the context does not establish both, so the rule is not applied" }
}

/// True only when the result holds with no condition: the rule was applied and required nothing. A conditional result
/// is not an identity of the expression; it is valid only where its required conditions hold.
pub fn is_identity(o: Outcome) -> Bool {
    o.status == "applied" and o.required.length() == 0
}

// ---------------------------------------------------------------- composition of conditional steps
//
// A Chain is a derivation: an expression, the context it was built under, and the conditional steps applied to its
// subexpressions. A step is an Outcome computed on `input`, a subexpression of the chain's current value (identified by
// its node in the store, so only the very same subexpression qualifies). The chain's value becomes the value with that
// subexpression replaced. The conditions of every step are kept, and no condition is dropped when an expression is
// produced; a condition the context proves is listed as established, and the others as unknown. A chain is refused
// when a step is refused, when a step uses another context, when its input is not in the value, or when two of its
// conditions cannot hold together.

/// A derivation of conditional steps. `status` is "applied" (all conditions established), "applied-conditional" (some
/// are unknown) or "refused" (the reason is given and the value is the last valid one).
pub record Chain {
    input: String
    value: Expr
    context: String
    ctx: Context
    steps: List<String>
    conditions: List<Condition>
    established: List<String>
    unknown: List<String>
    status: String
    reason: String
}

/// The expression with the subexpression `target` replaced by `replacement`, matched by node identity.
fn replace_sub_ids(s: Store, id: Int, target: Int, replacement: Int) -> Int {
    if id == target {
        return replacement
    }
    kind = s.kinds[id]
    if kind <= 1 {
        return id
    }
    mut parts: List<Int> = []
    for i in 0 until s.counts[id] {
        parts.push(replace_sub_ids(s, arg_of(s, id, i), target, replacement))
    }
    if kind == 2 {
        return add_ids(s, parts)
    }
    if kind == 3 {
        return mul_ids(s, parts)
    }
    if kind == 4 {
        return pow_ids(s, parts[0], parts[1])
    }
    call_id(s, s.names[id], parts[0])
}

/// True when `target` occurs in the expression (by node identity).
fn occurs_in(s: Store, id: Int, target: Int) -> Bool {
    if id == target {
        return true
    }
    kind = s.kinds[id]
    if kind <= 1 {
        return false
    }
    for i in 0 until s.counts[id] {
        if occurs_in(s, arg_of(s, id, i), target) {
            return true
        }
    }
    false
}

/// Two conditions on the same expression that cannot hold together: a lower bound above an upper bound, or equal
/// bounds where one of them is strict.
fn conditions_clash(a: Condition, b: Condition) -> Bool {
    if show(a.expr) != show(b.expr) {
        return false
    }
    a_lower = a.relation == ">" or a.relation == ">="
    a_upper = a.relation == "<" or a.relation == "<="
    b_lower = b.relation == ">" or b.relation == ">="
    b_upper = b.relation == "<" or b.relation == "<="
    if a_lower and b_upper {
        return a.bound > b.bound or (a.bound == b.bound and (a.relation == ">" or b.relation == "<"))
    }
    if b_lower and a_upper {
        return b.bound > a.bound or (b.bound == a.bound and (b.relation == ">" or a.relation == "<"))
    }
    false
}

fn refuse_chain(ch: Chain, reason: String) -> Chain {
    Chain { input: ch.input, value: ch.value, context: ch.context, ctx: ch.ctx, steps: ch.steps, conditions: ch.conditions, established: ch.established, unknown: ch.unknown, status: "refused", reason: reason }
}

/// The chain of the expression a, computed under the context c, with no steps yet.
pub fn chain_start(a: Expr, c: Context) -> Chain {
    Chain { input: show(a), value: a, context: describe(c), ctx: c, steps: [], conditions: [], established: [], unknown: [], status: "applied", reason: "" }
}

/// Applies the outcome o to the subexpression `input` of the chain's value. Refuses the chain (and leaves its value as
/// it was) when the step is refused, computed under another context, applied to an expression that is not in the
/// value, or when its conditions clash with those already in the chain.
pub fn chain_then(ch: Chain, c: Context, input: Expr, o: Outcome) -> Chain {
    if ch.status == "refused" {
        return ch
    }
    if describe(c) != ch.context {
        return refuse_chain(ch, "the step was computed under another context: " + describe(c) + " (the chain uses " + ch.context + ")")
    }
    s = ch.value.store
    if not occurs_in(s, ch.value.id, input.id) {
        return refuse_chain(ch, "the step does not apply: " + show(input) + " is not a subexpression of " + show(ch.value))
    }
    if o.status == "refused" {
        return refuse_chain(ch, "step " + o.rule + " is refused: " + o.reason)
    }
    if show(input) != o.original {
        return refuse_chain(ch, "the step was computed on " + o.original + ", not on " + show(input))
    }
    mut conditions: List<Condition> = []
    for cond in ch.conditions {
        conditions.push(cond)
    }
    for cond in o.conditions {
        mut known = false
        for existing in conditions {
            if existing.text == cond.text {
                known = true
            }
            if conditions_clash(existing, cond) {
                return refuse_chain(ch, "the conditions " + existing.text + " and " + cond.text + " cannot hold together")
            }
        }
        if not known {
            conditions.push(cond)
        }
    }
    mut established: List<String> = []
    for t in ch.established {
        established.push(t)
    }
    for t in o.established {
        if not text_in(established, t) {
            established.push(t)
        }
    }
    mut unknown: List<String> = []
    for cond in conditions {
        if not text_in(established, cond.text) {
            unknown.push(cond.text)
        }
    }
    mut steps: List<String> = []
    for done in ch.steps {
        steps.push(done)
    }
    steps.push(o.rule)
    replaced = replace_sub_ids(s, ch.value.id, input.id, o.value.id)
    status = if unknown.length() == 0 { "applied" } else { "applied-conditional" }
    Chain { input: ch.input, value: wrap(s, replaced), context: ch.context, ctx: ch.ctx, steps: steps, conditions: conditions, established: established, unknown: unknown, status: status, reason: "" }
}

fn relation_holds(v: Float, relation: String, bound: Float) -> Bool {
    if relation == "!=" {
        return v != bound
    }
    if relation == ">" {
        return v > bound
    }
    if relation == ">=" {
        return v >= bound
    }
    if relation == "<" {
        return v < bound
    }
    if relation == "<=" {
        return v <= bound
    }
    false
}

/// The value of the chain at the given symbol values. The chain's value is returned only when every condition holds at
/// those values, and the context's facts hold too: a point outside the domain is an error that names the condition, not
/// a number. Established conditions are not checked again, because the context proves them for every value it allows.
pub fn chain_evaluate(ch: Chain, names: List<String>, values: List<Float>) -> Result<Float, String> {
    if ch.status == "refused" {
        return Err("the chain is refused: " + ch.reason)
    }
    for f in ch.ctx.facts {
        mut index = -1
        for i in 0 until names.length() {
            if names[i] == f.name {
                index = i
            }
        }
        if index < 0 {
            return Err("no value for " + f.name + ", whose context fact " + f.kind + " must be checked")
        }
        mut relation = ""
        mut bound = 0.0
        if f.kind == "positive" {
            relation = ">"
        } else if f.kind == "negative" {
            relation = "<"
        } else if f.kind == "nonnegative" {
            relation = ">="
        } else if f.kind == "nonpositive" {
            relation = "<="
        } else if f.kind == "nonzero" {
            relation = "!="
        } else if f.kind == "complex" {
            return Err("complex values of " + f.name + " are not evaluated here")
        }
        if relation != "" and not relation_holds(values[index], relation, bound) {
            return Err("outside the context: " + f.name + " " + f.kind + " fails at " + f.name + " = " + values[index].to_string())
        }
    }
    for cond in ch.conditions {
        if not text_in(ch.established, cond.text) {
            match eval(cond.expr, names, values) {
                Ok(v) => {
                    if not relation_holds(v, cond.relation, cond.bound) {
                        return Err("outside the domain: " + cond.text + " fails (the expression has the value " + v.to_string() + ")")
                    }
                },
                Err(message) => {
                    return Err("cannot check " + cond.text + ": " + message)
                },
            }
        }
    }
    eval(ch.value, names, values)
}

// ---------------------------------------------------------------- multivariate polynomials and expressions
//
// Interchange form: one line per term, "coefficient|e1,e2,...", with one exponent for each variable, in the order of
// the variables. Other std modules cannot name the types of this module in a signature, so std.mpolynomial parses and
// formats these lines (mpoly_parse, mpoly_lines).

/// Adds `by` to the exponent at index (a fresh list; lists are not assigned by index).
fn bump_exponent(exponents: List<Int>, index: Int, by: Int) -> List<Int> {
    mut next: List<Int> = []
    for i in 0 until exponents.length() {
        if i == index {
            next.push(exponents[i] + by)
        } else {
            next.push(exponents[i])
        }
    }
    next
}

/// The first name that occurs twice in the list, or "" when all names are distinct.
fn repeated_name(names: List<String>) -> String {
    for i in 0 until names.length() {
        for j in 0 until i {
            if names[j] == names[i] {
                return names[i]
            }
        }
    }
    ""
}

fn symbol_position(names: List<String>, name: String) -> Int {
    for i in 0 until names.length() {
        if names[i] == name {
            return i
        }
    }
    -1
}

fn exponents_text(exponents: List<Int>) -> String {
    mut text = ""
    for i in 0 until exponents.length() {
        if i == 0 {
            text = exponents[i].to_string()
        } else {
            text = text + "," + exponents[i].to_string()
        }
    }
    text
}

/// The terms of an expression over the given variable names, as interchange lines. The expression is expanded first;
/// every term must be a rational number times the variables and non-negative integer powers of them. Anything else (a
/// function of a variable, a symbol that is not a variable, a negative or symbolic exponent) is refused with the term
/// that is not polynomial. The expression and its variables must come from the same store.
pub fn expression_term_lines(a: Expr, names: List<String>) -> Result<List<String>, String> {
    repeated = repeated_name(names)
    if repeated != "" {
        return Err("the variable " + repeated + " is repeated")
    }
    s = a.store
    expanded = expand_ids(s, a.id)
    mut parts: List<Int> = []
    if s.kinds[expanded] == 2 {
        for i in 0 until s.counts[expanded] {
            parts.push(arg_of(s, expanded, i))
        }
    } else {
        parts.push(expanded)
    }
    mut lines: List<String> = []
    for part in parts {
        mut factors: List<Int> = []
        if s.kinds[part] == 3 {
            for i in 0 until s.counts[part] {
                factors.push(arg_of(s, part, i))
            }
        } else {
            factors.push(part)
        }
        mut coefficient = rat(s, 1, 1)
        mut exponents: List<Int> = []
        for i in 0 until names.length() {
            exponents.push(0)
        }
        for f in factors {
            kind = s.kinds[f]
            if kind == 0 {
                coefficient = rat_mul(s, coefficient, rat_of(s, f))
            } else if kind == 1 {
                index = symbol_position(names, s.names[f])
                if index < 0 {
                    return Err("the expression has the symbol " + s.names[f] + ", which is not one of the variables")
                }
                exponents = bump_exponent(exponents, index, 1)
            } else if kind == 4 and s.kinds[arg_of(s, f, 0)] == 1 and is_int_num(s, arg_of(s, f, 1)) and s.nums[arg_of(s, f, 1)] >= 0 {
                index = symbol_position(names, s.names[arg_of(s, f, 0)])
                if index < 0 {
                    return Err("the expression has the symbol " + s.names[arg_of(s, f, 0)] + ", which is not one of the variables")
                }
                exponents = bump_exponent(exponents, index, s.nums[arg_of(s, f, 1)])
            } else {
                return Err("not a polynomial in these variables: " + show_ids(s, part))
            }
        }
        lines.push(rat_text_of(coefficient) + "|" + exponents_text(exponents))
    }
    Ok(lines)
}

/// The expression of interchange lines, over the given symbols (one for each variable, in order). Exact: the coefficients
/// are rationals and the expression is built with the store's canonical forms.
pub fn expression_of_term_lines(symbols: List<Expr>, lines: List<String>) -> Result<Expr, String> {
    if symbols.length() == 0 {
        return Err("give at least one symbol, so that the store is known")
    }
    s = symbols[0].store
    mut total = int_id(s, 0)
    for line in lines {
        pieces = line.split("|")
        if pieces.length() != 2 {
            return Err("a term line must be coefficient|exponents: " + line)
        }
        mut product = num_id(s, rat_from_text(s, pieces[0]))
        exponent_fields = pieces[1].split(",")
        if exponent_fields.length() != symbols.length() {
            return Err("a term has " + exponent_fields.length().to_string() + " exponents for " + symbols.length().to_string() + " variables")
        }
        for i in 0 until exponent_fields.length() {
            match parse_int(exponent_fields[i]) {
                Err(message) => {
                    return Err(message)
                },
                Ok(e) => {
                    if e < 0 {
                        return Err("the exponent " + e.to_string() + " is negative; polynomial exponents are not negative")
                    }
                    if e > 0 {
                        product = mul_ids(s, [product, pow_ids(s, symbols[i].id, int_id(s, e))])
                    }
                },
            }
        }
        total = add_ids(s, [total, product])
    }
    Ok(wrap(s, total))
}
