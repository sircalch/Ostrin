// std.measurements: experimental scalar measurements with explicit sensitivity sources.
//
// This is phase 1 of docs/design/25-mediciones-e-incertidumbre.md. It deliberately
// exposes functions instead of operator overloading while the generic scientific
// type contract is reviewed. `from_source` makes correlation identity explicit;
// `standard` remains compatible by using its label as the identity. Derived values
// retain source contributions so correlated cancellation is exact.
import std.numeric

pub record Sensitivity<T> {
    source_id: String
    label: String
    source_dimension: String
    source_sigma: Float
    contribution: T
}

pub record Measurement<T> {
    value: T
    sources: List<Sensitivity<T>>
    known: Bool
    reason: String
}

// A bounded dense covariance model for dimensionless scalar source variables.
// `source_ids` defines the row and column order of `matrix`.
pub record SourceCovariance {
    source_ids: List<String>
    matrix: Array<Float>
    relative_tolerance: Float
}

// A dimensionless correlation matrix. Unlike SourceCovariance, this model can
// relate sources whose input quantities have different dimensions: each
// measurement sensitivity is already expressed in the output quantity's unit.
pub record SourceCorrelation {
    source_ids: List<String>
    matrix: Array<Float>
    relative_tolerance: Float
}

// A standard uncertainty represented in the coherent unit of its static dimension.
pub record CoherentUncertainty<D> {
    dimension_key: String
    value: Float
}

pub fn exact(value: Float) -> Measurement<Float> {
    if not is_finite(value) {
        return unknown(value, "exact measurement value must be finite")
    }
    Measurement<Float> {
        value: value,
        sources: [],
        known: true,
        reason: "",
    }
}

pub fn standard(value: Float, sigma: Float, label: String) -> Result<Measurement<Float>, String> {
    if not is_finite(value) {
        return Err("measurement value must be finite")
    }
    if not is_finite(sigma) {
        return Err("measurement sigma must be finite")
    }
    if sigma < 0.0 {
        return Err("measurement sigma must be non-negative")
    }
    if label.length() == 0 {
        return Err("measurement source label must not be empty")
    }
    Ok(Measurement<Float> {
        value: value,
        sources: [Sensitivity<Float> {
            source_id: label,
            label: label,
            source_dimension: "dimensionless",
            source_sigma: sigma,
            contribution: sigma,
        }],
        known: true,
        reason: "",
    })
}

// Explicit identity keeps correlation separate from the human-readable label.
// Reusing a source_id intentionally reuses the same random variable.
pub fn from_source(value: Float, sigma: Float, source_id: String, label: String) -> Result<Measurement<Float>, String> {
    if not is_finite(value) {
        return Err("measurement value must be finite")
    }
    if not is_finite(sigma) {
        return Err("measurement sigma must be finite")
    }
    if sigma < 0.0 {
        return Err("measurement sigma must be non-negative")
    }
    if source_id.length() == 0 {
        return Err("measurement source id must not be empty")
    }
    Ok(Measurement<Float> {
        value: value,
        sources: [Sensitivity<Float> {
            source_id: source_id,
            label: label,
            source_dimension: "dimensionless",
            source_sigma: sigma,
            contribution: sigma,
        }],
        known: true,
        reason: "",
    })
}

// Dimensional constructor prototype. `source_sigma` is stored in the coherent
// reference unit, while `contribution` retains its Quantity unit for later
// dimension-aware propagation. Native Measurement<Quantity<D>> remains gated.
pub fn from_quantity_source<D: Dimension>(value: Quantity<D>, sigma: Quantity<D>, source_id: String, label: String) -> Result<Measurement<Quantity<D>>, String> {
    nominal = value.value()
    declared_sigma = sigma.value()
    if not is_finite(nominal) {
        return Err("measurement value must be finite")
    }
    if not is_finite(nominal * value.unit_scale()) {
        return Err("measurement value must be finite")
    }
    if not is_finite(declared_sigma) {
        return Err("measurement sigma must be finite")
    }
    if declared_sigma < 0.0 {
        return Err("measurement sigma must be non-negative")
    }
    if source_id.length() == 0 {
        return Err("measurement source id must not be empty")
    }
    canonical_sigma = declared_sigma * sigma.unit_scale()
    if not is_finite(canonical_sigma) {
        return Err("measurement sigma must be finite")
    }
    if canonical_sigma < 0.0 {
        return Err("measurement sigma must be non-negative")
    }
    dimension_key_value = value.dimension_key()
    Ok(Measurement<Quantity<D>> {
        value: value,
        sources: [Sensitivity<Quantity<D>> {
            source_id: source_id,
            label: label,
            source_dimension: dimension_key_value,
            source_sigma: canonical_sigma,
            contribution: sigma,
        }],
        known: true,
        reason: "",
    })
}

// Exact and unknown dimensional readings share the same finite nominal-value
// invariant as source-backed measurements. Unknown uncertainty is explicit; it
// never turns a non-finite nominal value into an apparently valid record.
pub fn exact_quantity<D: Dimension>(value: Quantity<D>) -> Result<Measurement<Quantity<D>>, String> {
    if not is_finite(value.value())
        or not is_finite(value.value() * value.unit_scale())
    {
        return Err("measurement value must be finite")
    }
    Ok(Measurement<Quantity<D>> {
        value: value,
        sources: [],
        known: true,
        reason: "",
    })
}

pub fn unknown_quantity<D: Dimension>(value: Quantity<D>, reason: String) -> Result<Measurement<Quantity<D>>, String> {
    if not is_finite(value.value())
        or not is_finite(value.value() * value.unit_scale())
    {
        return Err("measurement value must be finite")
    }
    Ok(Measurement<Quantity<D>> {
        value: value,
        sources: [],
        known: false,
        reason: reason,
    })
}

fn merge_quantity_sources<D: Dimension>(
    result: List<Sensitivity<Quantity<D>>>,
    input: List<Sensitivity<Quantity<D>>>,
    factor: Float
) -> Result<List<Sensitivity<Quantity<D>>>, String> {
    mut output: List<Sensitivity<Quantity<D>>> = result
    for item in input {
        mut validation_error = validate_quantity_source(item)
        if validation_error != "" {
            return Err(validation_error)
        }
        mut merged: List<Sensitivity<Quantity<D>>> = []
        mut found = false
        for current in output {
            validation_error = validate_quantity_source(current)
            if validation_error != "" {
                return Err(validation_error)
            }
            if current.source_id == item.source_id {
                if current.source_dimension != item.source_dimension
                    or current.source_sigma != item.source_sigma
                {
                    return Err("measurement source id was reused with a different dimension or sigma")
                }
                combined = Sensitivity<Quantity<D>> {
                    source_id: current.source_id,
                    label: current.label,
                    source_dimension: current.source_dimension,
                    source_sigma: current.source_sigma,
                    contribution: current.contribution + factor * item.contribution,
                }
                validation_error = validate_quantity_source(combined)
                if validation_error != "" {
                    return Err(validation_error)
                }
                merged.push(combined)
                found = true
            } else {
                merged.push(current)
            }
        }
        if not found {
            scaled = Sensitivity<Quantity<D>> {
                source_id: item.source_id,
                label: item.label,
                source_dimension: item.source_dimension,
                source_sigma: item.source_sigma,
                contribution: factor * item.contribution,
            }
            validation_error = validate_quantity_source(scaled)
            if validation_error != "" {
                return Err(validation_error)
            }
            merged.push(scaled)
        }
        output = merged
    }
    Ok(output)
}

fn validate_quantity_source<D: Dimension>(source: Sensitivity<Quantity<D>>) -> String {
    if source.source_id.length() == 0 {
        return "measurement source id must not be empty"
    }
    if source.source_dimension.length() == 0 {
        return "measurement source dimension must not be empty"
    }
    if not is_finite(source.source_sigma) or source.source_sigma < 0.0 {
        return "measurement source sigma must be finite and non-negative"
    }
    if not is_finite(source.contribution.value())
        or not is_finite(source.contribution.value() * source.contribution.unit_scale())
    {
        return "measurement sensitivity contribution must be finite"
    }
    ""
}

fn scale_quantity_sources_by_right<A: Dimension, B: Dimension>(
    input: List<Sensitivity<Quantity<A>>>,
    factor: Quantity<B>
) -> Result<List<Sensitivity<Quantity<A * B>>>, String> {
    mut output: List<Sensitivity<Quantity<A * B>>> = []
    for item in input {
        mut validation_error = validate_quantity_source(item)
        if validation_error != "" {
            return Err(validation_error)
        }
        scaled = Sensitivity<Quantity<A * B>> {
            source_id: item.source_id,
            label: item.label,
            source_dimension: item.source_dimension,
            source_sigma: item.source_sigma,
            contribution: item.contribution * factor,
        }
        validation_error = validate_quantity_source(scaled)
        if validation_error != "" {
            return Err(validation_error)
        }
        output.push(scaled)
    }
    Ok(output)
}

fn scale_quantity_sources_by_left<A: Dimension, B: Dimension>(
    input: List<Sensitivity<Quantity<B>>>,
    factor: Quantity<A>
) -> Result<List<Sensitivity<Quantity<A * B>>>, String> {
    mut output: List<Sensitivity<Quantity<A * B>>> = []
    for item in input {
        mut validation_error = validate_quantity_source(item)
        if validation_error != "" {
            return Err(validation_error)
        }
        scaled = Sensitivity<Quantity<A * B>> {
            source_id: item.source_id,
            label: item.label,
            source_dimension: item.source_dimension,
            source_sigma: item.source_sigma,
            contribution: factor * item.contribution,
        }
        validation_error = validate_quantity_source(scaled)
        if validation_error != "" {
            return Err(validation_error)
        }
        output.push(scaled)
    }
    Ok(output)
}

pub fn mul_quantity<A: Dimension, B: Dimension>(
    a: Measurement<Quantity<A>>,
    b: Measurement<Quantity<B>>
) -> Result<Measurement<Quantity<A * B>>, String> {
    result = a.value * b.value
    if not is_finite(result.value())
        or not is_finite(result.value() * result.unit_scale())
    {
        return Err("measurement value must be finite")
    }
    if not a.known or not b.known {
        return Ok(unknown_quantity_from("mul", result))
    }
    match scale_quantity_sources_by_right(a.sources, b.value) {
        Ok(left_sources) => match scale_quantity_sources_by_left(b.sources, a.value) {
            Ok(right_sources) => match merge_quantity_sources(left_sources, right_sources, 1.0) {
                Ok(sources) => Ok(Measurement<Quantity<A * B>> {
                    value: result,
                    sources: sources,
                    known: true,
                    reason: "",
                }),
                Err(message) => Err(message),
            },
            Err(message) => Err(message),
        },
        Err(message) => Err(message),
    }
}

fn divide_quantity_sources_by_right<A: Dimension, B: Dimension>(
    input: List<Sensitivity<Quantity<A>>>,
    divisor: Quantity<B>
) -> Result<List<Sensitivity<Quantity<A / B>>>, String> {
    mut output: List<Sensitivity<Quantity<A / B>>> = []
    for item in input {
        mut validation_error = validate_quantity_source(item)
        if validation_error != "" {
            return Err(validation_error)
        }
        scaled = Sensitivity<Quantity<A / B>> {
            source_id: item.source_id,
            label: item.label,
            source_dimension: item.source_dimension,
            source_sigma: item.source_sigma,
            contribution: item.contribution / divisor,
        }
        validation_error = validate_quantity_source(scaled)
        if validation_error != "" {
            return Err(validation_error)
        }
        output.push(scaled)
    }
    Ok(output)
}

fn divide_quantity_sources_by_left<A: Dimension, B: Dimension>(
    input: List<Sensitivity<Quantity<B>>>,
    numerator: Quantity<A>,
    denominator: Quantity<B>
) -> Result<List<Sensitivity<Quantity<A / B>>>, String> {
    mut output: List<Sensitivity<Quantity<A / B>>> = []
    for item in input {
        mut validation_error = validate_quantity_source(item)
        if validation_error != "" {
            return Err(validation_error)
        }
        scaled = Sensitivity<Quantity<A / B>> {
            source_id: item.source_id,
            label: item.label,
            source_dimension: item.source_dimension,
            source_sigma: item.source_sigma,
            contribution: ((numerator * item.contribution) / (denominator * denominator)) * -1.0,
        }
        validation_error = validate_quantity_source(scaled)
        if validation_error != "" {
            return Err(validation_error)
        }
        output.push(scaled)
    }
    Ok(output)
}

// Propagate division while preserving the quotient dimension in the result and
// in every source contribution. The same-dimension Float API remains available
// through div_quantity_same for compatibility.
pub fn div_quantity<A: Dimension, B: Dimension>(
    a: Measurement<Quantity<A>>,
    b: Measurement<Quantity<B>>
) -> Result<Measurement<Quantity<A / B>>, String> {
    a_value = a.value.value() * a.value.unit_scale()
    b_value = b.value.value() * b.value.unit_scale()
    if not is_finite(a_value) or not is_finite(b_value) {
        return Err("measurement value must be finite")
    }
    if b_value == 0.0 {
        return Err("measurement division by zero")
    }
    if a.value.dimension_key() == b.value.dimension_key() {
        return Err("dimensionless quotient requires div_quantity_same")
    }
    result = a.value / b.value
    if not is_finite(result.value()) or not is_finite(result.value() * result.unit_scale()) {
        return Err("measurement value must be finite")
    }
    if not a.known or not b.known {
        return Ok(unknown_quantity_from("div", result))
    }
    match divide_quantity_sources_by_right(a.sources, b.value) {
        Ok(left_sources) => match divide_quantity_sources_by_left(b.sources, a.value, b.value) {
            Ok(right_sources) => match merge_quantity_sources(left_sources, right_sources, 1.0) {
                Ok(sources) => Ok(Measurement<Quantity<A / B>> {
                    value: result,
                    sources: sources,
                    known: true,
                    reason: "",
                }),
                Err(message) => Err(message),
            },
            Err(message) => Err(message),
        },
        Err(message) => Err(message),
    }
}

fn scale_quantity_sources_to_float<D: Dimension>(
    input: List<Sensitivity<Quantity<D>>>,
    factor: Float
) -> Result<List<Sensitivity<Float>>, String> {
    if not is_finite(factor) {
        return Err("measurement sensitivity contribution must be finite")
    }
    mut output: List<Sensitivity<Float>> = []
    for item in input {
        mut validation_error = validate_quantity_source(item)
        if validation_error != "" {
            return Err(validation_error)
        }
        canonical_contribution = item.contribution.value() * item.contribution.unit_scale()
        contribution = factor * canonical_contribution
        if not is_finite(contribution) {
            return Err("measurement sensitivity contribution must be finite")
        }
        output.push(Sensitivity<Float> {
            source_id: item.source_id,
            label: item.label,
            source_dimension: item.source_dimension,
            source_sigma: item.source_sigma,
            contribution: contribution,
        })
    }
    Ok(output)
}

pub fn div_quantity_same<D: Dimension>(
    a: Measurement<Quantity<D>>,
    b: Measurement<Quantity<D>>
) -> Result<Measurement<Float>, String> {
    a_value = a.value.value() * a.value.unit_scale()
    b_value = b.value.value() * b.value.unit_scale()
    if not is_finite(a_value) or not is_finite(b_value) {
        return Err("measurement value must be finite")
    }
    if b_value == 0.0 {
        return Err("measurement division by zero")
    }
    result = a_value / b_value
    if not is_finite(result) {
        return Err("measurement value must be finite")
    }
    if not a.known or not b.known {
        return Ok(unknown_from("div", result))
    }
    a_factor = 1.0 / b_value
    b_factor = (-1.0 * (a_value / b_value)) / b_value
    match scale_quantity_sources_to_float(a.sources, a_factor) {
        Ok(left) => match scale_quantity_sources_to_float(b.sources, b_factor) {
            Ok(right) => match merge_scaled(left, right, 1.0) {
                Ok(sources) => Ok(Measurement<Float> {
                    value: result,
                    sources: sources,
                    known: true,
                    reason: "",
                }),
                Err(message) => Err(message),
            },
            Err(message) => Err(message),
        },
        Err(message) => Err(message),
    }
}

fn unknown_quantity_from<D: Dimension>(operation: String, value: Quantity<D>) -> Measurement<Quantity<D>> {
    Measurement<Quantity<D>> {
        value: value,
        sources: [],
        known: false,
        reason: operation + " received a measurement with unknown uncertainty",
    }
}

pub fn add_quantity<D: Dimension>(
    a: Measurement<Quantity<D>>,
    b: Measurement<Quantity<D>>
) -> Result<Measurement<Quantity<D>>, String> {
    result = a.value + b.value
    if not is_finite(result.value()) or not is_finite(result.value() * result.unit_scale()) {
        return Err("measurement value must be finite")
    }
    if not a.known or not b.known {
        return Ok(unknown_quantity_from("add", result))
    }
    match merge_quantity_sources([], a.sources, 1.0) {
        Ok(left) => match merge_quantity_sources(left, b.sources, 1.0) {
            Ok(sources) => Ok(Measurement<Quantity<D>> {
                value: result,
                sources: sources,
                known: true,
                reason: "",
            }),
            Err(message) => Err(message),
        },
        Err(message) => Err(message),
    }
}

pub fn sub_quantity<D: Dimension>(
    a: Measurement<Quantity<D>>,
    b: Measurement<Quantity<D>>
) -> Result<Measurement<Quantity<D>>, String> {
    result = a.value - b.value
    if not is_finite(result.value()) or not is_finite(result.value() * result.unit_scale()) {
        return Err("measurement value must be finite")
    }
    if not a.known or not b.known {
        return Ok(unknown_quantity_from("sub", result))
    }
    match merge_quantity_sources([], a.sources, 1.0) {
        Ok(left) => match merge_quantity_sources(left, b.sources, -1.0) {
            Ok(sources) => Ok(Measurement<Quantity<D>> {
                value: result,
                sources: sources,
                known: true,
                reason: "",
            }),
            Err(message) => Err(message),
        },
        Err(message) => Err(message),
    }
}

pub fn quantity_uncertainty<D: Dimension>(
    measurement: Measurement<Quantity<D>>
) -> Result<CoherentUncertainty<D>, String> {
    if not measurement.known {
        return Err(measurement.reason)
    }
    if not is_finite(measurement.value.value())
        or not is_finite(measurement.value.value() * measurement.value.unit_scale())
    {
        return Err("measurement value must be finite")
    }
    mut variance_value = 0.0
    for source in measurement.sources {
        validation_error = validate_quantity_source(source)
        if validation_error != "" {
            return Err(validation_error)
        }
        canonical_contribution = source.contribution.value() * source.contribution.unit_scale()
        contribution_variance = canonical_contribution * canonical_contribution
        if not is_finite(contribution_variance) {
            return Err("measurement uncertainty overflowed")
        }
        variance_value = variance_value + contribution_variance
        if not is_finite(variance_value) {
            return Err("measurement uncertainty overflowed")
        }
    }
    uncertainty_value = sqrt(variance_value)
    if not is_finite(uncertainty_value) {
        return Err("measurement uncertainty overflowed")
    }
    Ok(CoherentUncertainty<D> {
        dimension_key: measurement.value.dimension_key(),
        value: uncertainty_value,
    })
}

pub fn unknown(value: Float, reason: String) -> Measurement<Float> {
    Measurement<Float> {
        value: value,
        sources: [],
        known: false,
        reason: reason,
    }
}

pub fn value(measurement: Measurement<Float>) -> Float {
    measurement.value
}

pub fn is_known(measurement: Measurement<Float>) -> Bool {
    measurement.known
}

pub fn is_exact(measurement: Measurement<Float>) -> Bool {
    measurement.known and measurement.sources.length() == 0
}

pub fn source_count(measurement: Measurement<Float>) -> Int {
    measurement.sources.length()
}

// Project a series into nominal values without discarding the original
// measurements. Callers can pair this with `uncertainties` and pass both
// arrays to `std.viz.errorbars`.
pub fn values(measurements: List<Measurement<Float>>) -> List<Float> {
    mut output: List<Float> = []
    for measurement in measurements {
        output.push(measurement.value)
    }
    output
}

// Return one standard uncertainty per element. Unknown uncertainty remains an
// explicit error so a plot cannot silently turn missing information into zero.
pub fn uncertainties(measurements: List<Measurement<Float>>) -> Result<List<Float>, String> {
    mut output: List<Float> = []
    for measurement in measurements {
        match uncertainty(measurement) {
            Ok(sigma) => output.push(sigma),
            Err(message) => { return Err(message) },
        }
    }
    Ok(output)
}

// Sum a finite series while retaining source correlation. Reusing the same
// source identity therefore contributes once with the accumulated coefficient.
pub fn sum(measurements: List<Measurement<Float>>) -> Result<Measurement<Float>, String> {
    if measurements.length() == 0 {
        return Err("measurement sum needs at least one item")
    }
    mut total = exact(0.0)
    for measurement in measurements {
        match add(total, measurement) {
            Ok(next) => { total = next },
            Err(message) => { return Err(message) },
        }
    }
    Ok(total)
}

// Arithmetic mean implemented in terms of sum and scale so it shares the
// same correlation and unknown-state rules as scalar operations.
pub fn mean(measurements: List<Measurement<Float>>) -> Result<Measurement<Float>, String> {
    count = measurements.length()
    if count == 0 {
        return Err("measurement mean needs at least one item")
    }
    match sum(measurements) {
        Ok(total) => Ok(scale(total, 1.0 / (count as Float))),
        Err(message) => Err(message),
    }
}

pub fn uncertainty(measurement: Measurement<Float>) -> Result<Float, String> {
    if not measurement.known {
        return Err(measurement.reason)
    }
    if not is_finite(measurement.value) {
        return Err("measurement value must be finite")
    }
    variance(measurement.sources)
}

pub fn summary(measurement: Measurement<Float>) -> String {
    if not measurement.known {
        return "unknown: " + measurement.reason
    }
    match uncertainty(measurement) {
        Ok(sigma) => measurement.value.to_string() + " ± " + sigma.to_string(),
        Err(message) => "invalid: " + message,
    }
}

fn variance(sources: List<Sensitivity<Float>>) -> Result<Float, String> {
    mut total = 0.0
    for source in sources {
        if not is_finite(source.contribution) {
            return Err("measurement sensitivity contribution must be finite")
        }
        if not is_finite(source.source_sigma) {
            return Err("measurement source sigma must be finite")
        }
        if source.source_sigma < 0.0 {
            return Err("measurement source sigma must be non-negative")
        }
        contribution = source.contribution * source.contribution
        if not is_finite(contribution) {
            return Err("measurement uncertainty overflowed")
        }
        total = total + contribution
        if not is_finite(total) {
            return Err("measurement uncertainty overflowed")
        }
    }
    Ok(sqrt(total))
}

// Add a scaled sensitivity list, merging equal explicit source identities.
fn merge_scaled(
    result: List<Sensitivity<Float>>,
    input: List<Sensitivity<Float>>,
    factor: Float
) -> Result<List<Sensitivity<Float>>, String> {
    mut output: List<Sensitivity<Float>> = result
    for item in input {
        mut merged: List<Sensitivity<Float>> = []
        mut found = false
        for current in output {
            if current.source_id == item.source_id {
                if current.source_dimension != item.source_dimension
                    or current.source_sigma != item.source_sigma
                {
                    if current.source_dimension != item.source_dimension {
                        return Err("measurement source id was reused with a different dimension or sigma")
                    }
                    return Err("measurement source id was reused with a different sigma")
                }
                merged.push(Sensitivity<Float> {
                    source_id: current.source_id,
                    label: current.label,
                    source_dimension: current.source_dimension,
                    source_sigma: current.source_sigma,
                    contribution: current.contribution + factor * item.contribution,
                })
                found = true
            } else {
                merged.push(current)
            }
        }
        if not found {
            merged.push(Sensitivity<Float> {
                source_id: item.source_id,
                label: item.label,
                source_dimension: item.source_dimension,
                source_sigma: item.source_sigma,
                contribution: factor * item.contribution,
            })
        }
        output = merged
    }
    Ok(output)
}

fn unknown_from(operation: String, value: Float) -> Measurement<Float> {
    unknown(value, operation + " received a measurement with unknown uncertainty")
}

pub fn scale(measurement: Measurement<Float>, factor: Float) -> Measurement<Float> {
    if not measurement.known {
        return unknown_from("scale", measurement.value * factor)
    }
    match merge_scaled([], measurement.sources, factor) {
        Ok(sources) => Measurement<Float> {
            value: measurement.value * factor,
            sources: sources,
            known: true,
            reason: "",
        },
        Err(message) => unknown(measurement.value * factor, message),
    }
}

pub fn add(a: Measurement<Float>, b: Measurement<Float>) -> Result<Measurement<Float>, String> {
    if not a.known {
        return Ok(unknown_from("add", a.value + b.value))
    }
    if not b.known {
        return Ok(unknown_from("add", a.value + b.value))
    }
    match merge_scaled([], a.sources, 1.0) {
        Ok(left) => match merge_scaled(left, b.sources, 1.0) {
            Ok(sources) => Ok(Measurement<Float> {
                value: a.value + b.value,
                sources: sources,
                known: true,
                reason: "",
            }),
            Err(message) => Err(message),
        },
        Err(message) => Err(message),
    }
}

pub fn sub(a: Measurement<Float>, b: Measurement<Float>) -> Result<Measurement<Float>, String> {
    if not a.known {
        return Ok(unknown_from("sub", a.value - b.value))
    }
    if not b.known {
        return Ok(unknown_from("sub", a.value - b.value))
    }
    match merge_scaled([], a.sources, 1.0) {
        Ok(left) => match merge_scaled(left, b.sources, -1.0) {
            Ok(sources) => Ok(Measurement<Float> {
                value: a.value - b.value,
                sources: sources,
                known: true,
                reason: "",
            }),
            Err(message) => Err(message),
        },
        Err(message) => Err(message),
    }
}

pub fn mul(a: Measurement<Float>, b: Measurement<Float>) -> Result<Measurement<Float>, String> {
    result = a.value * b.value
    if not a.known or not b.known {
        return Ok(unknown_from("mul", result))
    }
    match merge_scaled([], a.sources, b.value) {
        Ok(left) => match merge_scaled(left, b.sources, a.value) {
            Ok(sources) => Ok(Measurement<Float> {
                value: result,
                sources: sources,
                known: true,
                reason: "",
            }),
            Err(message) => Err(message),
        },
        Err(message) => Err(message),
    }
}

pub fn div(a: Measurement<Float>, b: Measurement<Float>) -> Result<Measurement<Float>, String> {
    if b.value == 0.0 {
        return Err("measurement division by zero")
    }
    result = a.value / b.value
    if not a.known or not b.known {
        return Ok(unknown_from("div", result))
    }
    a_factor = 1.0 / b.value
    b_factor = 0.0 - a.value / (b.value * b.value)
    match merge_scaled([], a.sources, a_factor) {
        Ok(left) => match merge_scaled(left, b.sources, b_factor) {
            Ok(sources) => Ok(Measurement<Float> {
                value: result,
                sources: sources,
                known: true,
                reason: "",
            }),
            Err(message) => Err(message),
        },
        Err(message) => Err(message),
    }
}

fn covariance_midpoint(lower: Float, upper: Float) -> Float {
    sum = lower + upper
    if is_finite(sum) {
        // Adding first preserves adjacent subnormal entries: halving their
        // subnormal difference can round to zero before the midpoint is formed.
        return sum * 0.5
    }
    // Only same-sign, large finite entries can overflow their sum. Halving
    // first keeps their midpoint finite without changing the subnormal path.
    lower * 0.5 + upper * 0.5
}

fn covariance_validation_error(
    source_ids: List<String>,
    matrix: Array<Float>,
    relative_tolerance: Float
) -> String {
    if not is_finite(relative_tolerance) or relative_tolerance <= 0.0 {
        return "covariance relative tolerance must be finite and positive"
    }
    if relative_tolerance > 1e-6 {
        return "covariance relative tolerance must not exceed 1e-6"
    }
    n = source_ids.length()
    if n == 0 {
        return "covariance needs at least one source id"
    }
    if n > 64 {
        return "dense covariance supports at most 64 sources"
    }
    shape = matrix.shape()
    if shape.length() != 2 or shape[0] != n or shape[1] != n {
        return "covariance matrix shape must match its source ids"
    }
    for i in 0 until n {
        if source_ids[i].length() == 0 {
            return "covariance source id must not be empty"
        }
        for j in 0 until i {
            if source_ids[i] == source_ids[j] {
                return "covariance source ids must be unique"
            }
        }
    }

    mut scale = 0.0
    for i in 0 until n {
        for j in 0 until n {
            value = matrix.get(i, j)
            if not is_finite(value) {
                return "covariance entries must be finite"
            }
            if abs(value) > scale {
                scale = abs(value)
            }
        }
    }
    if scale == 0.0 {
        scale = 1.0
    }
    mut symmetric = zeros([n, n])
    for i in 0 until n {
        symmetric.set(i, i, matrix.get(i, i) / scale)
        for j in i + 1 until n {
            upper = matrix.get(i, j) / scale
            lower = matrix.get(j, i) / scale
            if abs(upper - lower) > relative_tolerance {
                return "covariance matrix must be symmetric within tolerance"
            }
            average = covariance_midpoint(lower, upper)
            symmetric.set(i, j, average)
            symmetric.set(j, i, average)
        }
    }

    match numeric.eigen(symmetric, relative_tolerance) {
        Ok(factors) => {
            for i in 0 until n {
                value = factors.values[i]
                if not is_finite(value) {
                    return "covariance eigenvalues must be finite"
                }
            }
            if factors.values[0] < 0.0 - relative_tolerance {
                return "covariance matrix must be positive semidefinite"
            }
        },
        Err(_) => {
            return "covariance matrix must be symmetric and numerically valid"
        },
    }
    ""
}

/// Validate a small dense covariance matrix. The supplied source-id order is
/// the canonical row and column order for this model. Entries use coherent
/// squared units; this initial API is limited to dimensionless scalar sources.
pub fn covariance(
    source_ids: List<String>,
    matrix: Array<Float>,
    relative_tolerance: Float = 1e-12
) -> Result<SourceCovariance, String> {
    error = covariance_validation_error(source_ids, matrix, relative_tolerance)
    if error != "" {
        return Err(error)
    }
    Ok(SourceCovariance {
        source_ids: source_ids,
        matrix: matrix,
        relative_tolerance: relative_tolerance,
    })
}

fn source_correlation_canonical_matrix(source_ids: List<String>, matrix: Array<Float>) -> Array<Float> {
    n = source_ids.length()
    mut canonical = zeros([n, n])
    for i in 0 until n {
        canonical.set(i, i, 1.0)
        for j in 0 until i {
            average = covariance_midpoint(matrix.get(i, j), matrix.get(j, i))
            canonical.set(i, j, average)
            canonical.set(j, i, average)
        }
    }
    canonical
}

fn source_correlation_validation_error(
    source_ids: List<String>,
    matrix: Array<Float>,
    relative_tolerance: Float
) -> String {
    error = covariance_validation_error(source_ids, matrix, relative_tolerance)
    if error != "" {
        return "correlation model is invalid: " + error
    }
    n = source_ids.length()
    for i in 0 until n {
        diagonal = matrix.get(i, i)
        if abs(diagonal - 1.0) > relative_tolerance {
            return "correlation matrix diagonal must equal one"
        }
        for j in 0 until i {
            upper = matrix.get(i, j)
            lower = matrix.get(j, i)
            coefficient = covariance_midpoint(lower, upper)
            if abs(upper) > 1.0 or abs(lower) > 1.0 or abs(coefficient) > 1.0 {
                return "correlation coefficients must be within [-1, 1]"
            }
            // Do not canonicalize a tolerated asymmetric pair to exact
            // dependence when Float rounding erases its residual distance
            // from +/-1. The covariance kernel cannot recover that evidence.
            if abs(coefficient) == 1.0 and (upper != coefficient or lower != coefficient) {
                return "correlation coefficient is numerically unresolved"
            }
        }
    }
    canonical = source_correlation_canonical_matrix(source_ids, matrix)
    canonical_error = covariance_validation_error(source_ids, canonical, relative_tolerance)
    if canonical_error != "" {
        return "canonical correlation matrix is invalid: " + canonical_error
    }
    ""
}

/// Build a bounded dense, dimensionless correlation model for one to 64
/// source identities. Matrix entries are Pearson correlation coefficients;
/// the diagonal is one, and the matrix must be symmetric and positive
/// semidefinite within the declared tolerance.
pub fn source_correlation(
    source_ids: List<String>,
    matrix: Array<Float>,
    relative_tolerance: Float = 1e-12
) -> Result<SourceCorrelation, String> {
    error = source_correlation_validation_error(source_ids, matrix, relative_tolerance)
    if error != "" {
        return Err(error)
    }
    canonical = source_correlation_canonical_matrix(source_ids, matrix)
    Ok(SourceCorrelation {
        source_ids: source_ids,
        matrix: canonical,
        relative_tolerance: relative_tolerance,
    })
}

fn covariance_source_index(source_ids: List<String>, source_id: String) -> Int {
    for i in 0 until source_ids.length() {
        if source_ids[i] == source_id {
            return i
        }
    }
    -1
}

fn covariance_symmetric_entry(matrix: Array<Float>, row: Int, column: Int) -> Float {
    if row == column {
        return matrix.get(row, column)
    }
    covariance_midpoint(matrix.get(row, column), matrix.get(column, row))
}

/// Convert covariance entries to correlations using a scale-safe product of
/// standard deviations, rejecting subnormal scales and unequal-variance
/// near-perfect correlations that Float cannot establish exactly.
fn covariance_correlation_matrix(
    matrix: Array<Float>,
    relative_tolerance: Float
) -> Result<Array<Float>, String> {
    n = matrix.shape()[0]
    mut correlation = zeros([n, n])
    for i in 0 until n {
        row_variance = covariance_symmetric_entry(matrix, i, i)
        if not is_finite(row_variance) or row_variance < 0.0 {
            return Err("covariance matrix could not be stably factorized")
        }
        if row_variance == 0.0 {
            correlation.set(i, i, 0.0)
        } else {
            correlation.set(i, i, 1.0)
        }
        for j in 0 until i {
            column_variance = covariance_symmetric_entry(matrix, j, j)
            upper_entry = matrix.get(i, j)
            lower_entry = matrix.get(j, i)
            entry_is_nonzero = upper_entry != 0.0 or lower_entry != 0.0
            mut coefficient = 0.0
            mut covariance_scale = 0.0
            if not is_finite(column_variance) or column_variance < 0.0 {
                return Err("covariance matrix could not be stably factorized")
            }
            if row_variance == 0.0 or column_variance == 0.0 {
                if entry_is_nonzero {
                    return Err("covariance matrix could not be stably factorized")
                }
            } else {
                row_sigma = sqrt(row_variance)
                column_sigma = sqrt(column_variance)
                // The product of the standard deviations is the geometric
                // mean of the variances. Multiplying the roots avoids first
                // forming a variance ratio that can underflow to a subnormal
                // and distort the correlation before the square root.
                if row_variance == column_variance {
                    covariance_scale = row_variance
                } else {
                    covariance_scale = row_sigma * column_sigma
                }
                if covariance_scale > 0.0 and is_finite(covariance_scale) {
                    if entry_is_nonzero and row_variance != column_variance
                        and covariance_scale < 2.2250738585072014e-308
                    {
                        // A subnormal geometric scale has too few significant
                        // bits to resolve an unequal-variance correlation.
                        return Err("covariance correlation is numerically unresolved")
                    }
                    // Normalize each raw entry before averaging. Averaging
                    // adjacent subnormals first can discard half of their
                    // difference; here their local geometric scale makes the
                    // midpoint representable before correlation conversion.
                    lower_coefficient = lower_entry / covariance_scale
                    upper_coefficient = upper_entry / covariance_scale
                    if not is_finite(lower_coefficient) or not is_finite(upper_coefficient) {
                        return Err("covariance matrix could not be stably factorized")
                    }
                    if (lower_entry != 0.0 and lower_coefficient == 0.0)
                        or (upper_entry != 0.0 and upper_coefficient == 0.0)
                    {
                        return Err("covariance correlation underflows Float range")
                    }
                    coefficient = covariance_midpoint(lower_coefficient, upper_coefficient)
                } else {
                    // A nonzero covariance cannot be resolved against a zero
                    // or non-finite geometric mean in Float range.
                    if entry_is_nonzero {
                        return Err("covariance correlation underflows Float range")
                    }
                }
                if not is_finite(coefficient) {
                    return Err("covariance matrix could not be stably factorized")
                }
                mut correlation_resolution = relative_tolerance
                if correlation_resolution < 1.4210854715202004e-14 {
                    correlation_resolution = 1.4210854715202004e-14
                }
                coefficient_magnitude = abs(coefficient)
                if row_variance != column_variance
                    and coefficient_magnitude >= 1.0 - correlation_resolution
                {
                    // Rounded square roots and products cannot prove exact
                    // dependence (for example, sqrt(11) * sqrt(11) rounds to
                    // 11). Certify only small integer roots whose squares and
                    // product are exactly representable; otherwise preserve
                    // the positive-definite residual by rejecting the case.
                    max_exact_integer_root = 94906265.0
                    roots_are_integers = floor(row_sigma) == row_sigma
                        and floor(column_sigma) == column_sigma
                    if not roots_are_integers
                        or row_sigma > max_exact_integer_root
                        or column_sigma > max_exact_integer_root
                    {
                        return Err("covariance correlation is numerically unresolved")
                    }
                    row_root_square = row_sigma * row_sigma
                    column_root_square = column_sigma * column_sigma
                    exact_root_product = row_sigma * column_sigma
                    if row_root_square != row_variance
                        or column_root_square != column_variance
                        or exact_root_product != abs(upper_entry)
                        or exact_root_product != abs(lower_entry)
                    {
                        return Err("covariance correlation is numerically unresolved")
                    }
                }
                if coefficient_magnitude <= 1.0
                    and 1.0 - coefficient_magnitude <= correlation_resolution
                    and (covariance_scale == 0.0
                        or abs(upper_entry) < covariance_scale
                        or abs(lower_entry) < covariance_scale)
                {
                    return Err("covariance correlation is numerically unresolved")
                }
                coefficient_scale = abs(coefficient)
                if coefficient_scale > 1.0 {
                    if coefficient_scale - 1.0 > relative_tolerance {
                        return Err("covariance matrix could not be stably factorized")
                    }
                    if coefficient < 0.0 {
                        coefficient = -1.0
                    } else {
                        coefficient = 1.0
                    }
                }
            }
            correlation.set(i, j, coefficient)
            correlation.set(j, i, coefficient)
        }
    }
    Ok(correlation)
}

/// Factor a validated dimensionless correlation matrix as L·Lᵀ.
///
/// This factor is applied to stored source contributions so large signed terms
/// cancel before they are squared.
fn covariance_semidefinite_factor(
    matrix: Array<Float>,
    relative_tolerance: Float
) -> Result<Array<Float>, String> {
    n = matrix.shape()[0]
    mut lower = zeros([n, n])
    for i in 0 until n {
        mut diagonal_sum = 0.0
        mut diagonal_correction = 0.0
        mut diagonal_products = 0.0
        for k in 0 until i {
            diagonal_factor = lower.get(i, k)
            term = diagonal_factor * diagonal_factor
            if not is_finite(term) {
                return Err("covariance matrix could not be stably factorized")
            }
            if diagonal_factor != 0.0 and term == 0.0 {
                return Err("covariance matrix factorization underflows Float range")
            }
            next_sum = diagonal_sum + term
            mut residual = 0.0
            if abs(diagonal_sum) >= abs(term) {
                residual = (diagonal_sum - next_sum) + term
            } else {
                residual = (term - next_sum) + diagonal_sum
            }
            diagonal_correction = diagonal_correction + residual
            diagonal_sum = next_sum
            diagonal_products = diagonal_products + abs(term)
            if not is_finite(diagonal_sum) or not is_finite(diagonal_correction)
                or not is_finite(diagonal_products)
            {
                return Err("covariance matrix could not be stably factorized")
            }
        }
        diagonal = covariance_symmetric_entry(matrix, i, i)
        mut pivot = diagonal - (diagonal_sum + diagonal_correction)
        pivot_scale = abs(diagonal) + diagonal_products
        if not is_finite(pivot) or not is_finite(pivot_scale) {
            return Err("covariance matrix could not be stably factorized")
        }
        if pivot < 0.0 {
            return Err("covariance matrix could not be stably factorized")
        }
        if pivot > 0.0 and pivot_scale > 0.0
            and pivot <= relative_tolerance * pivot_scale
        {
            return Err("covariance matrix could not be stably factorized")
        }

        if pivot == 0.0 {
            lower.set(i, i, 0.0)
            for row in i + 1 until n {
                mut dot_sum = 0.0
                mut dot_correction = 0.0
                mut dot_products = 0.0
                for k in 0 until i {
                    left_factor = lower.get(row, k)
                    right_factor = lower.get(i, k)
                    term = left_factor * right_factor
                    if left_factor != 0.0 and right_factor != 0.0 and term == 0.0 {
                        return Err("covariance matrix factorization underflows Float range")
                    }
                    next_sum = dot_sum + term
                    mut residual = 0.0
                    if abs(dot_sum) >= abs(term) {
                        residual = (dot_sum - next_sum) + term
                    } else {
                        residual = (term - next_sum) + dot_sum
                    }
                    dot_correction = dot_correction + residual
                    dot_sum = next_sum
                    dot_products = dot_products + abs(term)
                }
                entry = covariance_symmetric_entry(matrix, row, i)
                residual = entry - (dot_sum + dot_correction)
                residual_scale = abs(entry) + dot_products
                if not is_finite(residual) or not is_finite(residual_scale)
                    or (residual_scale > 0.0 and abs(residual) > relative_tolerance * residual_scale)
                {
                    return Err("covariance matrix could not be stably factorized")
                }
                lower.set(row, i, 0.0)
            }
        } else {
            diagonal_factor = sqrt(pivot)
            if not is_finite(diagonal_factor) or diagonal_factor == 0.0 {
                return Err("covariance matrix could not be stably factorized")
            }
            lower.set(i, i, diagonal_factor)
            for row in i + 1 until n {
                mut dot_sum = 0.0
                mut dot_correction = 0.0
                for k in 0 until i {
                    left_factor = lower.get(row, k)
                    right_factor = lower.get(i, k)
                    term = left_factor * right_factor
                    if left_factor != 0.0 and right_factor != 0.0 and term == 0.0 {
                        return Err("covariance matrix factorization underflows Float range")
                    }
                    next_sum = dot_sum + term
                    mut residual = 0.0
                    if abs(dot_sum) >= abs(term) {
                        residual = (dot_sum - next_sum) + term
                    } else {
                        residual = (term - next_sum) + dot_sum
                    }
                    dot_correction = dot_correction + residual
                    dot_sum = next_sum
                }
                entry = covariance_symmetric_entry(matrix, row, i)
                residual_value = entry - (dot_sum + dot_correction)
                factor = residual_value / diagonal_factor
                if not is_finite(factor) {
                    return Err("covariance matrix could not be stably factorized")
                }
                if residual_value != 0.0 and factor == 0.0 {
                    return Err("covariance matrix factorization underflows Float range")
                }
                lower.set(row, i, factor)
            }
        }
    }
    Ok(lower)
}

/// Return J·Σ·Jᵀ for the sources currently present in a scalar measurement.
/// The equivalent contribution/correlation form avoids dividing and rebuilding
/// large sensitivities. Unused sources have zero sensitivity; each used source
/// must be present and its diagonal must match the recorded standard sigma.
pub fn variance_with_covariance(
    measurement: Measurement<Float>,
    model: SourceCovariance
) -> Result<Float, String> {
    if not measurement.known {
        return Err("covariance propagation needs known measurement uncertainty")
    }
    if not is_finite(measurement.value) {
        return Err("measurement value must be finite")
    }
    error = covariance_validation_error(model.source_ids, model.matrix, model.relative_tolerance)
    if error != "" {
        return Err(error)
    }

    n = model.source_ids.length()
    mut standardized_contributions = zeros([n])
    mut source_sigmas = zeros([n])
    mut contribution_adjustments = zeros([n])
    mut contribution_adjustment_flags = zeros([n])
    for i in 0 until measurement.sources.length() {
        source = measurement.sources[i]
        if source.source_id.length() == 0 or source.source_dimension != "dimensionless" {
            return Err("scalar covariance needs dimensionless sources with non-empty ids")
        }
        if not is_finite(source.source_sigma) or source.source_sigma < 0.0
            or not is_finite(source.contribution)
        {
            return Err("measurement source sigma and contribution must be finite")
        }
        for j in 0 until i {
            if measurement.sources[j].source_id == source.source_id {
                return Err("measurement source ids must be unique before covariance propagation")
            }
        }
        index = covariance_source_index(model.source_ids, source.source_id)
        if index < 0 {
            return Err("covariance model is missing a measurement source id")
        }
        expected_variance = source.source_sigma * source.source_sigma
        if not is_finite(expected_variance) {
            return Err("measurement source variance must be finite")
        }
        if source.source_sigma != 0.0 and expected_variance == 0.0 {
            return Err("measurement source variance underflows Float range")
        }
        diagonal = model.matrix.get(index, index)
        if expected_variance > 0.0 and expected_variance < 2.2250738585072014e-308 {
            // Compare in root space; rounded subnormal squares cannot establish this match.
            if diagonal <= 0.0 {
                return Err("covariance diagonal must match the measurement source sigma")
            }
            subnormal_sigma_ratio = sqrt(diagonal) / source.source_sigma
            if not is_finite(subnormal_sigma_ratio)
                or abs(subnormal_sigma_ratio - 1.0) > model.relative_tolerance * 0.5
            {
                return Err("covariance diagonal must match the measurement source sigma")
            }
        }
        mut diagonal_scale = abs(expected_variance)
        if abs(diagonal) > diagonal_scale {
            diagonal_scale = abs(diagonal)
        }
        if diagonal_scale > 0.0
            and abs(diagonal - expected_variance) > model.relative_tolerance * diagonal_scale
        {
            return Err("covariance diagonal must match the measurement source sigma")
        }
        if source.source_sigma == 0.0 {
            if source.contribution != 0.0 {
                return Err("zero-sigma source must have zero sensitivity contribution")
            }
        } else {
            if not is_finite(source.contribution) {
                return Err("standardized measurement source contribution must be finite")
            }
            standardized_contributions.set(index, source.contribution)
        }
        source_sigmas.set(index, source.source_sigma)
    }

    // The diagonal match is tolerance-based. Preserve the stored contribution
    // exactly for a bitwise match; otherwise retain the accepted sigma ratio
    // and apply it after power-of-two normalization. This avoids rounding a
    // large contribution before cancellation is assessed.
    for i in 0 until n {
        source_sigma = source_sigmas[i]
        if source_sigma != 0.0 {
            diagonal = covariance_symmetric_entry(model.matrix, i, i)
            expected_variance = source_sigma * source_sigma
            mut contribution_needs_adjustment = diagonal != expected_variance
            if expected_variance > 0.0 and expected_variance < 2.2250738585072014e-308
                and sqrt(diagonal) != source_sigma
            {
                // Distinct source roots can square to the same subnormal Float.
                // Preserve that root-space adjustment so cancellation is not
                // incorrectly certified as exact after rounding.
                contribution_needs_adjustment = true
            }
            if contribution_needs_adjustment {
                if diagonal < 0.0 {
                    return Err("covariance matrix could not be stably factorized")
                }
                adjustment = sqrt(diagonal) / source_sigma
                adjusted_contribution = standardized_contributions[i] * adjustment
                if not is_finite(adjustment) or adjustment == 0.0
                    or not is_finite(adjusted_contribution)
                {
                    return Err("standardized measurement source contribution must be finite")
                }
                if standardized_contributions[i] != 0.0 and adjusted_contribution == 0.0 {
                    return Err("standardized measurement source contribution underflows Float range")
                }
                contribution_adjustments.set(i, adjustment)
                contribution_adjustment_flags.set(i, 1.0)
            }
        }
    }

    mut contribution_scale = 0.0
    for i in 0 until n {
        if abs(standardized_contributions[i]) > contribution_scale {
            contribution_scale = abs(standardized_contributions[i])
        }
    }
    if contribution_scale == 0.0 {
        return Ok(0.0)
    }
    // Normalize by a power of two so binary scaling does not round away
    // small, representable differences between large source contributions.
    mut contribution_power_scale = 1.0
    if contribution_scale >= 1.0 {
        while contribution_power_scale <= contribution_scale * 0.5 {
            contribution_power_scale = contribution_power_scale * 2.0
        }
    } else {
        while contribution_power_scale > contribution_scale {
            contribution_power_scale = contribution_power_scale * 0.5
        }
    }
    correlation = match covariance_correlation_matrix(model.matrix, model.relative_tolerance) {
        Ok(value) => value,
        Err(message) => {
            return Err(message)
        },
    }
    factor = match covariance_semidefinite_factor(correlation, model.relative_tolerance) {
        Ok(value) => value,
        Err(message) => {
            return Err(message)
        },
    }
    mut variance = 0.0
    for column in 0 until n {
        mut projection = 0.0
        mut projection_correction = 0.0
        mut projection_term_magnitude = 0.0
        mut projection_has_inexact_factor = false
        mut projection_has_adjusted_contribution = false
        for row in column until n {
            normalized_contribution = standardized_contributions[row] / contribution_power_scale
            mut projection_adjustment = contribution_adjustments[row]
            if projection_adjustment == 0.0 {
                projection_adjustment = 1.0
            }
            adjusted_normalized_contribution = normalized_contribution * projection_adjustment
            factor_entry = factor.get(row, column)
            // Scaling by a power of two is exact for normal binary floats, but
            // can discard significant bits when a nonzero value becomes
            // subnormal. Refuse that lossy normalization explicitly.
            if contribution_power_scale > 1.0 and adjusted_normalized_contribution != 0.0
                and abs(adjusted_normalized_contribution) < 2.2250738585072014e-308
            {
                return Err("propagated covariance contribution normalization loses subnormal precision")
            }
            term = factor_entry * adjusted_normalized_contribution
            if not is_finite(term) {
                return Err("propagated covariance variance must be finite")
            }
            if (standardized_contributions[row] != 0.0 and adjusted_normalized_contribution == 0.0)
                or (factor_entry != 0.0 and adjusted_normalized_contribution != 0.0 and term == 0.0)
            {
                return Err("propagated covariance projection underflows Float range")
            }
            projection_term_magnitude = projection_term_magnitude + abs(term)
            if not is_finite(projection_term_magnitude) {
                return Err("propagated covariance variance must be finite")
            }
            if factor_entry != 0.0 and adjusted_normalized_contribution != 0.0
                and factor_entry != 1.0 and factor_entry != -1.0
            {
                projection_has_inexact_factor = true
            }
            if factor_entry != 0.0 and normalized_contribution != 0.0
                and contribution_adjustment_flags[row] != 0.0
            {
                projection_has_adjusted_contribution = true
            }
            next_projection = projection + term
            mut residual = 0.0
            if abs(projection) >= abs(term) {
                residual = (projection - next_projection) + term
            } else {
                residual = (term - next_projection) + projection
            }
            projection_correction = projection_correction + residual
            projection = next_projection
            if not is_finite(projection) or not is_finite(projection_correction) {
                return Err("propagated covariance variance must be finite")
            }
        }
        scaled_projection = projection + projection_correction
        if (projection_has_inexact_factor or projection_has_adjusted_contribution)
            and projection_term_magnitude > 0.0
        {
            // The input tolerance bounds accepted covariance perturbations.
            // Use at least 64 Float epsilons for factors, diagonal-adjustment
            // products, and compensated accumulation; smaller cancellation
            // residuals cannot be distinguished reliably from rounding error.
            mut projection_resolution = model.relative_tolerance
            if projection_resolution < 1.4210854715202004e-14 {
                projection_resolution = 1.4210854715202004e-14
            }
            projection_limit = projection_term_magnitude * projection_resolution
            if not is_finite(projection_limit) {
                return Err("propagated covariance variance must be finite")
            }
            if abs(scaled_projection) <= projection_limit {
                return Err("propagated covariance projection is numerically unresolved")
            }
        }
        propagated_sigma = scaled_projection * contribution_power_scale
        contribution_variance = propagated_sigma * propagated_sigma
        if not is_finite(scaled_projection) or not is_finite(propagated_sigma)
            or not is_finite(contribution_variance)
        {
            return Err("propagated covariance variance must be finite")
        }
        if scaled_projection != 0.0 and contribution_scale != 0.0 and propagated_sigma == 0.0 {
            return Err("propagated covariance uncertainty underflows Float range")
        }
        if propagated_sigma != 0.0 and contribution_variance == 0.0 {
            return Err("propagated covariance variance underflows Float range")
        }
        variance = variance + contribution_variance
        if not is_finite(variance) {
            return Err("propagated covariance variance must be finite")
        }
    }
    Ok(variance)
}

/// Return the standard uncertainty derived from J·Σ·Jᵀ.
pub fn uncertainty_with_covariance(
    measurement: Measurement<Float>,
    model: SourceCovariance
) -> Result<Float, String> {
    match variance_with_covariance(measurement, model) {
        Ok(variance) => Ok(sqrt(variance)),
        Err(message) => Err(message),
    }
}

/// Propagate correlated uncertainty through a dimensioned scalar measurement.
/// Sensitivities are converted to coherent units before the dimensionless
/// correlation kernel runs; the returned value retains the measurement's
/// static dimension in `CoherentUncertainty<D>`.
pub fn quantity_uncertainty_with_correlation<D: Dimension>(
    measurement: Measurement<Quantity<D>>,
    model: SourceCorrelation
) -> Result<CoherentUncertainty<D>, String> {
    if not measurement.known {
        return Err(measurement.reason)
    }
    nominal = measurement.value.value() * measurement.value.unit_scale()
    if not is_finite(measurement.value.value()) or not is_finite(nominal) {
        return Err("measurement value must be finite")
    }
    mut validation_error = source_correlation_validation_error(model.source_ids, model.matrix, model.relative_tolerance)
    if validation_error != "" {
        return Err(validation_error)
    }

    // The scalar covariance kernel accepts standardized unit-variance source
    // variables. Keep that representation private: map each original source
    // sensitivity to its canonical output-unit contribution, while preserving
    // its identity and using the model as the standardized sources' covariance.
    mut normalized_sources: List<Sensitivity<Float>> = []
    for i in 0 until measurement.sources.length() {
        source = measurement.sources[i]
        validation_error = validate_quantity_source(source)
        if validation_error != "" {
            return Err(validation_error)
        }
        for j in 0 until i {
            if measurement.sources[j].source_id == source.source_id {
                return Err("measurement source ids must be unique before correlation propagation")
            }
        }
        if covariance_source_index(model.source_ids, source.source_id) < 0 {
            return Err("correlation model is missing a measurement source id")
        }
        contribution = source.contribution.value() * source.contribution.unit_scale()
        if not is_finite(contribution) {
            return Err("measurement sensitivity contribution must be finite")
        }
        if source.source_sigma == 0.0 and contribution != 0.0 {
            return Err("zero-sigma source must have zero sensitivity contribution")
        }
        normalized_sources.push(Sensitivity<Float> {
            source_id: source.source_id,
            label: source.label,
            source_dimension: "dimensionless",
            source_sigma: 1.0,
            contribution: contribution,
        })
    }
    normalized_measurement = Measurement<Float> {
        value: nominal,
        sources: normalized_sources,
        known: true,
        reason: "",
    }
    canonical_matrix = source_correlation_canonical_matrix(model.source_ids, model.matrix)
    normalized_model = SourceCovariance {
        source_ids: model.source_ids,
        matrix: canonical_matrix,
        relative_tolerance: model.relative_tolerance,
    }
    variance = match variance_with_covariance(normalized_measurement, normalized_model) {
        Ok(value) => value,
        Err(message) => {
            return Err(message)
        },
    }
    uncertainty_value = sqrt(variance)
    if not is_finite(uncertainty_value) {
        return Err("measurement uncertainty overflowed")
    }
    Ok(CoherentUncertainty<D> {
        dimension_key: measurement.value.dimension_key(),
        value: uncertainty_value,
    })
}
