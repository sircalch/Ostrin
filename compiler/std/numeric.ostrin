// std.numeric — numerical methods written in Ostrin.
//
// Integration (trapezoid, Simpson), roots (bisection, secant, Newton),
// derivatives, one-dimensional minimization (golden section), interpolation
// (linear, natural cubic spline), ODE solvers (classic RK4 and adaptive
// Dormand–Prince RK45) and the FFT (radix-2, with a DFT for other lengths).
// Everything is deterministic: the interpreter, native code and the browser
// compute the same bits.

// ---------------------------------------------------------------- integration

/// Integral of samples `ys` over `xs` by the trapezoid rule.
pub fn trapz(xs: Array<Float>, ys: Array<Float>) -> Float {
    mut total = 0.0
    for i in 1 until xs.length() {
        total = total + (xs[i] - xs[i - 1]) * (ys[i] + ys[i - 1]) / 2.0
    }
    total
}

/// Integral of `f` over [a, b] by composite Simpson's rule with `n` panels
/// (rounded up to an even number).
pub fn simpson(f: fn(Float) -> Float, a: Float, b: Float, n: Int = 200) -> Float {
    panels = if n % 2 == 0 { n } else { n + 1 }
    h = (b - a) / (panels as Float)
    mut total = f(a) + f(b)
    for i in 1 until panels {
        x = a + (i as Float) * h
        total = total + (if i % 2 == 1 { 4.0 } else { 2.0 }) * f(x)
    }
    total * h / 3.0
}

// ---------------------------------------------------------------- roots and minima

/// A root of `f` in [a, b], where f(a) and f(b) have opposite signs.
pub fn bisect(f: fn(Float) -> Float, a: Float, b: Float, tol: Float = 1e-12, max_iter: Int = 200) -> Result<Float, String> {
    mut lo = a
    mut hi = b
    mut flo = f(lo)
    fhi = f(hi)
    if flo == 0.0 {
        return Ok(lo)
    }
    if fhi == 0.0 {
        return Ok(hi)
    }
    if (flo < 0.0) == (fhi < 0.0) {
        return Err("bisect needs f(a) and f(b) with opposite signs")
    }
    mut i = 0
    while i < max_iter and hi - lo > tol {
        mid = (lo + hi) / 2.0
        fmid = f(mid)
        if fmid == 0.0 {
            return Ok(mid)
        }
        if (fmid < 0.0) == (flo < 0.0) {
            lo = mid
            flo = fmid
        } else {
            hi = mid
        }
        i = i + 1
    }
    Ok((lo + hi) / 2.0)
}

/// A root of `f` by the secant method from two starting points.
pub fn secant(f: fn(Float) -> Float, x0: Float, x1: Float, tol: Float = 1e-12, max_iter: Int = 100) -> Result<Float, String> {
    mut a = x0
    mut b = x1
    mut fa = f(a)
    mut i = 0
    while i < max_iter {
        fb = f(b)
        if abs(fb) <= tol {
            return Ok(b)
        }
        if fb == fa {
            return Err("secant stalled: f(x0) == f(x1)")
        }
        next = b - fb * (b - a) / (fb - fa)
        a = b
        fa = fb
        b = next
        i = i + 1
    }
    Err("secant did not converge in " + max_iter.to_string() + " iterations")
}

/// A root of `f` by Newton's method with the derivative `df`.
pub fn newton(f: fn(Float) -> Float, df: fn(Float) -> Float, x0: Float, tol: Float = 1e-12, max_iter: Int = 50) -> Result<Float, String> {
    mut x = x0
    mut i = 0
    while i < max_iter {
        fx = f(x)
        if abs(fx) <= tol {
            return Ok(x)
        }
        slope = df(x)
        if slope == 0.0 {
            return Err("newton hit a zero derivative")
        }
        x = x - fx / slope
        i = i + 1
    }
    Err("newton did not converge in " + max_iter.to_string() + " iterations")
}

/// f'(x) by a central difference.
pub fn derivative(f: fn(Float) -> Float, x: Float, h: Float = 1e-5) -> Float {
    (f(x + h) - f(x - h)) / (2.0 * h)
}

/// The minimum of a unimodal `f` on [a, b] by golden-section search.
pub fn golden_min(f: fn(Float) -> Float, a: Float, b: Float, tol: Float = 1e-10) -> Float {
    ratio = (sqrt(5.0) - 1.0) / 2.0
    mut lo = a
    mut hi = b
    mut c = hi - ratio * (hi - lo)
    mut d = lo + ratio * (hi - lo)
    mut fc = f(c)
    mut fd = f(d)
    while hi - lo > tol {
        if fc < fd {
            hi = d
            d = c
            fd = fc
            c = hi - ratio * (hi - lo)
            fc = f(c)
        } else {
            lo = c
            c = d
            fc = fd
            d = lo + ratio * (hi - lo)
            fd = f(d)
        }
    }
    (lo + hi) / 2.0
}

// ---------------------------------------------------------------- interpolation

fn segment(xs: Array<Float>, x: Float) -> Int {
    n = xs.length()
    if x <= xs[0] {
        return 0
    }
    if x >= xs[n - 1] {
        return n - 2
    }
    mut lo = 0
    mut hi = n - 1
    while hi - lo > 1 {
        mid = (lo + hi) / 2
        if xs[mid] <= x {
            lo = mid
        } else {
            hi = mid
        }
    }
    lo
}

/// Linear interpolation of (xs, ys) at x; xs increasing. Outside the data
/// the end segments are extended.
pub fn interp(xs: Array<Float>, ys: Array<Float>, x: Float) -> Float {
    i = segment(xs, x)
    t = (x - xs[i]) / (xs[i + 1] - xs[i])
    ys[i] + t * (ys[i + 1] - ys[i])
}

pub fn interp_all(xs: Array<Float>, ys: Array<Float>, at: Array<Float>) -> Array<Float> {
    mut out: List<Float> = []
    for i in 0 until at.length() {
        out.push(interp(xs, ys, at[i]))
    }
    array(out)
}

/// A natural cubic spline through (xs, ys).
pub record Spline {
    xs: Array<Float>
    ys: Array<Float>
    m: Array<Float>
}

/// Second derivatives from the tridiagonal system (Thomas algorithm), zero at
/// both ends.
pub fn spline(xs: Array<Float>, ys: Array<Float>) -> Spline {
    n = xs.length()
    mut m = zeros([n])
    if n > 2 {
        mut c: List<Float> = []
        mut d: List<Float> = []
        c.push(0.0)
        d.push(0.0)
        for i in 1 until n - 1 {
            h0 = xs[i] - xs[i - 1]
            h1 = xs[i + 1] - xs[i]
            rhs = 6.0 * ((ys[i + 1] - ys[i]) / h1 - (ys[i] - ys[i - 1]) / h0)
            denom = 2.0 * (h0 + h1) - h0 * c[i - 1]
            c.push(h1 / denom)
            d.push((rhs - h0 * d[i - 1]) / denom)
        }
        mut i = n - 2
        while i >= 1 {
            m.set(i, d[i] - c[i] * m[i + 1])
            i = i - 1
        }
    }
    Spline { xs: xs, ys: ys, m: m }
}

impl Spline {
    fn at(self, x: Float) -> Float {
        i = segment(self.xs, x)
        h = self.xs[i + 1] - self.xs[i]
        a = (self.xs[i + 1] - x) / h
        b = (x - self.xs[i]) / h
        a * self.ys[i] + b * self.ys[i + 1] + ((a * a * a - a) * self.m[i] + (b * b * b - b) * self.m[i + 1]) * h * h / 6.0
    }

    fn sample(self, at: Array<Float>) -> Array<Float> {
        mut out: List<Float> = []
        for i in 0 until at.length() {
            out.push(self.at(at[i]))
        }
        array(out)
    }
}

// ---------------------------------------------------------------- with units

// These take arrays of quantities (`Array<Quantity<D>>`), so the result
// carries the right unit: speeds in km/h over times in h integrate to km.
// Each array needs at least two samples; xs must be increasing.

/// The trapezoid-rule integral of ys over xs: `Quantity<X * Y>`.
pub fn unit_trapz<X: Dimension, Y: Dimension>(xs: Array<Quantity<X>>, ys: Array<Quantity<Y>>) -> Quantity<X * Y> {
    mut total = (xs[1] - xs[0]) * ys[0] * 0.0
    for i in 1 until xs.length() {
        total = total + (xs[i] - xs[i - 1]) * (ys[i] + ys[i - 1]) * 0.5
    }
    total
}

/// The running trapezoid integral: element i integrates up to xs[i] (the first is zero).
pub fn unit_cumtrapz<X: Dimension, Y: Dimension>(xs: Array<Quantity<X>>, ys: Array<Quantity<Y>>) -> Array<Quantity<X * Y>> {
    mut total = (xs[1] - xs[0]) * ys[0] * 0.0
    mut out: List<Quantity<X * Y>> = [total]
    for i in 1 until xs.length() {
        total = total + (xs[i] - xs[i - 1]) * (ys[i] + ys[i - 1]) * 0.5
        out.push(total)
    }
    array(out)
}

/// dy/dx at every sample: central differences inside, one-sided at the ends.
pub fn unit_gradient<X: Dimension, Y: Dimension>(xs: Array<Quantity<X>>, ys: Array<Quantity<Y>>) -> Array<Quantity<Y / X>> {
    n = xs.length()
    mut out: List<Quantity<Y / X>> = []
    for i in 0 until n {
        lo = if i == 0 { 0 } else { i - 1 }
        hi = if i == n - 1 { n - 1 } else { i + 1 }
        out.push((ys[hi] - ys[lo]) / (xs[hi] - xs[lo]))
    }
    array(out)
}

/// Linear interpolation of (xs, ys) at x, in any unit of X; the result is in ys' unit.
pub fn unit_interp<X: Dimension, Y: Dimension>(xs: Array<Quantity<X>>, ys: Array<Quantity<Y>>, x: Quantity<X>) -> Quantity<Y> {
    // x in the unit of xs (a sum takes the left operand's unit).
    at = (xs[0] * 0.0 + x).value()
    values = xs.values()
    i = segment(values, at)
    frac = (at - values[i]) / (values[i + 1] - values[i])
    ys[i] + (ys[i + 1] - ys[i]) * frac
}

// ---------------------------------------------------------------- ODEs

/// A trajectory: times `t` and states `y` (one row per time).
pub record Solution {
    t: Array<Float>
    y: Array<Float>
    evaluations: Int
}

impl Solution {
    /// The i-th state variable over time.
    fn component(self, i: Int) -> Array<Float> {
        self.y.col(i)
    }

    fn final_state(self) -> Array<Float> {
        self.y.row(self.t.length() - 1)
    }

    fn length(self) -> Int {
        self.t.length()
    }
}

fn solution(times: List<Float>, states: List<Float>, dim: Int, evaluations: Int) -> Solution {
    Solution { t: array(times), y: array(states).reshape([times.length(), dim]), evaluations: evaluations }
}

// ---------------------------------------------------------------- linear algebra

/// A thin QR decomposition of a dense real matrix: `a = q @ r`.
///
/// `q` has orthonormal columns and `r` is upper triangular. The modified
/// Gram–Schmidt implementation keeps the algorithm in std.numeric, so the
/// interpreter, native compiler and browser use the same public API.
pub record Qr {
    q: Array<Float>
    r: Array<Float>
}

impl Qr {
    /// Reconstruct the matrix represented by this factorization.
    fn reconstruct(self) -> Array<Float> {
        self.q @ self.r
    }

    /// ||QᵀQ − I||, useful as a compact orthogonality diagnostic.
    fn orthogonality(self) -> Float {
        n = self.r.shape()[0]
        norm(self.q.transpose() @ self.q - eye(n))
    }
}

/// Thin QR decomposition by modified Gram–Schmidt.
///
/// The input must be a dense, full-column-rank real matrix with at least as
/// many rows as columns. A `Result` makes rank and shape failures explicit to
/// callers instead of returning a silently unstable factorization.
pub fn qr(a: Array<Float>, tol: Float = 1e-12) -> Result<Qr, String> {
    shape = a.shape()
    if shape.length() != 2 {
        return Err("qr needs a two-dimensional matrix")
    }
    m = shape[0]
    n = shape[1]
    if m < n {
        return Err("qr needs at least as many rows as columns")
    }
    mut q = zeros([m, n])
    mut r = zeros([n, n])
    for j in 0 until n {
        mut v = a.col(j)
        for i in 0 until j {
            qi = q.col(i)
            rij = qi.dot(v)
            r.set(i, j, rij)
            v = v - qi * rij
        }
        rjj = norm(v)
        if rjj <= tol {
            return Err("qr found a linearly dependent column")
        }
        r.set(j, j, rjj)
        for k in 0 until m {
            q.set(k, j, v[k] / rjj)
        }
    }
    Ok(Qr { q: q, r: r })
}

/// A lower-triangular Cholesky factor of a dense symmetric matrix: `a = l @ l.T`.
pub record Cholesky {
    l: Array<Float>
}

impl Cholesky {
    /// Reconstruct the positive-definite matrix represented by this factor.
    fn reconstruct(self) -> Array<Float> {
        self.l @ self.l.transpose()
    }

    /// Solve `a x = b` with forward and backward triangular substitution.
    /// The right-hand side must have the same length as the factor dimension.
    fn solve(self, rhs: Array<Float>) -> Array<Float> {
        n = self.l.shape()[0]
        mut y = zeros([n])
        for i in 0 until n {
            mut value = rhs[i]
            for k in 0 until i {
                value = value - self.l.get(i, k) * y[k]
            }
            y.set(i, value / self.l.get(i, i))
        }
        mut x = zeros([n])
        for offset in 0 until n {
            i = n - 1 - offset
            mut value = y[i]
            for k in i + 1 until n {
                value = value - self.l.get(k, i) * x[k]
            }
            x.set(i, value / self.l.get(i, i))
        }
        x
    }
}

/// Cholesky factorization by the textbook lower-triangular algorithm.
///
/// The input must be a square, symmetric, positive-definite dense real matrix.
/// Shape, symmetry and non-positive pivots return a diagnostic instead of
/// producing an invalid factor.
pub fn cholesky(a: Array<Float>, tol: Float = 1e-12) -> Result<Cholesky, String> {
    shape = a.shape()
    if shape.length() != 2 or shape[0] != shape[1] {
        return Err("cholesky needs a square matrix")
    }
    n = shape[0]
    for i in 0 until n {
        for j in i + 1 until n {
            if abs(a.get(i, j) - a.get(j, i)) > tol {
                return Err("cholesky needs a symmetric matrix")
            }
        }
    }
    mut l = zeros([n, n])
    for i in 0 until n {
        for j in 0 until i + 1 {
            mut value = a.get(i, j)
            for k in 0 until j {
                value = value - l.get(i, k) * l.get(j, k)
            }
            if i == j {
                if value <= tol {
                    return Err("cholesky needs a positive-definite matrix")
                }
                l.set(i, j, sqrt(value))
            } else {
                l.set(i, j, value / l.get(j, j))
            }
        }
    }
    Ok(Cholesky { l: l })
}

// ---------------------------------------------------------------- singular value decomposition

record SymmetricEigen {
    values: Array<Float>
    vectors: Array<Float>
}

fn mark_used(flags: List<Bool>, index: Int) -> List<Bool> {
    mut out: List<Bool> = []
    for i in 0 until flags.length() {
        out.push(if i == index { true } else { flags[i] })
    }
    out
}

/// Eigenpairs of a real symmetric matrix by cyclic Jacobi rotations.
/// Eigenvectors are stored as columns and the fixed iteration order keeps the
/// interpreter, native compiler and browser on the same deterministic path.
fn symmetric_eigen(input: Array<Float>) -> SymmetricEigen {
    n = input.shape()[0]
    mut matrix = zeros([n, n])
    for i in 0 until n {
        for j in 0 until n {
            matrix.set(i, j, input.get(i, j))
        }
    }
    mut vectors = eye(n)
    for sweep in 0 until 100 {
        mut rotated = false
        for p in 0 until n {
            for q in p + 1 until n {
                apq = matrix.get(p, q)
                if abs(apq) <= 1e-15 * (abs(matrix.get(p, p)) + abs(matrix.get(q, q))) {
                    continue
                }
                rotated = true
                theta = (matrix.get(q, q) - matrix.get(p, p)) / (2.0 * apq)
                sign = if theta < 0.0 { -1.0 } else { 1.0 }
                t = sign / (abs(theta) + sqrt(theta * theta + 1.0))
                c = 1.0 / sqrt(t * t + 1.0)
                s = t * c
                for k in 0 until n {
                    akp = matrix.get(k, p)
                    akq = matrix.get(k, q)
                    matrix.set(k, p, c * akp - s * akq)
                    matrix.set(k, q, s * akp + c * akq)
                }
                for k in 0 until n {
                    apk = matrix.get(p, k)
                    aqk = matrix.get(q, k)
                    matrix.set(p, k, c * apk - s * aqk)
                    matrix.set(q, k, s * apk + c * aqk)
                }
                for k in 0 until n {
                    vkp = vectors.get(k, p)
                    vkq = vectors.get(k, q)
                    vectors.set(k, p, c * vkp - s * vkq)
                    vectors.set(k, q, s * vkp + c * vkq)
                }
            }
        }
        if not rotated {
            break
        }
    }
    mut values = zeros([n])
    for i in 0 until n {
        values.set(i, matrix.get(i, i))
    }
    SymmetricEigen { values: values, vectors: vectors }
}

/// Select the largest eigenvalues first, with a stable index tie-break.
fn eigen_order(values: Array<Float>, count: Int) -> List<Int> {
    n = values.length()
    mut used: List<Bool> = []
    for i in 0 until n {
        used.push(false)
    }
    mut order: List<Int> = []
    for rank_index in 0 until count {
        mut best = -1
        mut best_value = -1.0
        for i in 0 until n {
            if not used[i] and values[i] > best_value {
                best = i
                best_value = values[i]
            }
        }
        if best >= 0 {
            order.push(best)
            used = mark_used(used, best)
        }
    }
    order
}

/// Select the smallest eigenvalues first, with a stable index tie-break.
fn eigen_order_ascending(values: Array<Float>, count: Int) -> List<Int> {
    n = values.length()
    mut used: List<Bool> = []
    for i in 0 until n {
        used.push(false)
    }
    mut order: List<Int> = []
    for rank_index in 0 until count {
        mut best = -1
        mut best_value = 0.0
        for i in 0 until n {
            if not used[i] and (best < 0 or values[i] < best_value) {
                best = i
                best_value = values[i]
            }
        }
        if best >= 0 {
            order.push(best)
            used = mark_used(used, best)
        }
    }
    order
}

/// Eigenvalues and orthonormal eigenvectors of a dense real symmetric matrix.
/// Eigenvalues are ascending and eigenvectors are stored as columns.
pub record Eigen {
    values: Array<Float>
    vectors: Array<Float>
}

impl Eigen {
    /// Reconstruct the symmetric matrix from `V * diag(values) * Vᵀ`.
    fn reconstruct(self) -> Array<Float> {
        n = self.values.length()
        mut out = zeros([n, n])
        for i in 0 until n {
            for j in 0 until n {
                mut value = 0.0
                for k in 0 until n {
                    value = value + self.vectors.get(i, k) * self.values[k] * self.vectors.get(j, k)
                }
                out.set(i, j, value)
            }
        }
        out
    }
}

/// Eigenpairs for a dense real symmetric matrix, ordered by ascending value.
pub fn eigen(a: Array<Float>, tol: Float = 1e-12) -> Result<Eigen, String> {
    shape = a.shape()
    if shape.length() != 2 or shape[0] != shape[1] {
        return Err("eigen needs a square matrix")
    }
    n = shape[0]
    if n < 1 {
        return Err("eigen needs a non-empty matrix")
    }
    for i in 0 until n {
        for j in i + 1 until n {
            if abs(a.get(i, j) - a.get(j, i)) > tol {
                return Err("eigen needs a symmetric matrix")
            }
        }
    }
    raw = symmetric_eigen(a)
    order = eigen_order_ascending(raw.values, n)
    mut values = zeros([n])
    mut vectors = zeros([n, n])
    for column in 0 until n {
        index = order[column]
        values.set(column, raw.values[index])
        for row in 0 until n {
            vectors.set(row, column, raw.vectors.get(row, index))
        }
    }
    Ok(Eigen { values: values, vectors: vectors })
}

/// Thin real singular value decomposition `A = U * diag(s) * Vᵀ`.
///
/// The implementation diagonalizes `AᵀA` with deterministic Jacobi rotations.
/// It is intended for dense scientific examples and diagnostics; large or
/// ill-conditioned production workloads should eventually use a LAPACK FFI.
pub record Svd {
    u: Array<Float>
    s: Array<Float>
    vt: Array<Float>
}

impl Svd {
    /// Reconstruct the input matrix from the thin factors.
    fn reconstruct(self) -> Array<Float> {
        m = self.u.shape()[0]
        r = self.s.length()
        n = self.vt.shape()[1]
        mut out = zeros([m, n])
        for i in 0 until m {
            for j in 0 until n {
                mut value = 0.0
                for k in 0 until r {
                    value = value + self.u.get(i, k) * self.s[k] * self.vt.get(k, j)
                }
                out.set(i, j, value)
            }
        }
        out
    }

    /// Number of singular values above `tol`.
    fn rank(self, tol: Float = 1e-12) -> Int {
        mut count = 0
        for i in 0 until self.s.length() {
            if self.s[i] > tol {
                count = count + 1
            }
        }
        count
    }

    /// The 2-norm condition number of a full-rank matrix.
    ///
    /// A rank-deficient matrix has no finite condition number at the requested
    /// tolerance and returns a diagnostic instead of exposing an infinity that
    /// would be easy to mistake for a usable numerical result.
    fn condition_number(self, tol: Float = 1e-12) -> Result<Float, String> {
        if self.s.length() == 0 {
            return Err("condition number needs at least one singular value")
        }
        smallest = self.s[self.s.length() - 1]
        if smallest <= tol {
            return Err("condition number is undefined for a rank-deficient matrix")
        }
        Ok(self.s[0] / smallest)
    }

    /// Least-squares or minimum-norm solution using the pseudoinverse.
    /// `rhs` must be a vector with one entry per matrix row.
    fn solve(self, rhs: Array<Float>, tol: Float = 1e-12) -> Array<Float> {
        m = self.u.shape()[0]
        n = self.vt.shape()[1]
        r = self.s.length()
        mut projected = zeros([r])
        for i in 0 until r {
            mut value = 0.0
            for k in 0 until m {
                value = value + self.u.get(k, i) * rhs[k]
            }
            projected.set(i, if self.s[i] > tol { value / self.s[i] } else { 0.0 })
        }
        mut solution = zeros([n])
        for j in 0 until n {
            mut value = 0.0
            for i in 0 until r {
                value = value + self.vt.get(i, j) * projected[i]
            }
            solution.set(j, value)
        }
        solution
    }
}

/// Dense real thin SVD. Singular values are returned in descending order.
pub fn svd(a: Array<Float>, tol: Float = 1e-12) -> Result<Svd, String> {
    shape = a.shape()
    if shape.length() != 2 {
        return Err("svd needs a two-dimensional matrix")
    }
    m = shape[0]
    n = shape[1]
    if m < 1 or n < 1 {
        return Err("svd needs a non-empty matrix")
    }
    r = if m < n { m } else { n }
    // Form AᵀA with scalar reads so this routine does not consume the input
    // array through a native matrix-multiply temporary.
    mut gram = zeros([n, n])
    for i in 0 until n {
        for j in 0 until n {
            mut value = 0.0
            for k in 0 until m {
                value = value + a.get(k, i) * a.get(k, j)
            }
            gram.set(i, j, value)
        }
    }
    eigen = symmetric_eigen(gram)
    order = eigen_order(eigen.values, r)
    mut u = zeros([m, r])
    mut vt = zeros([r, n])
    mut singular: List<Float> = []
    for column in 0 until r {
        index = order[column]
        lambda = eigen.values[index]
        sigma = sqrt(if lambda > 0.0 { lambda } else { 0.0 })
        singular.push(sigma)
        for j in 0 until n {
            vt.set(column, j, eigen.vectors.get(j, index))
        }
        if sigma > tol {
            for i in 0 until m {
                mut value = 0.0
                for j in 0 until n {
                    value = value + a.get(i, j) * vt.get(column, j)
                }
                u.set(i, column, value / sigma)
            }
        }
    }
    Ok(Svd { u: u, s: array(singular), vt: vt })
}

/// A partial-pivoting LU factorization of a dense square matrix: `P A = L U`.
///
/// `p[i]` is the source row of row `i` after the pivot permutations. Keeping
/// the permutation explicit makes reconstruction and solves deterministic and
/// keeps singular matrices in the typed `Result` path.
pub record Lu {
    l: Array<Float>
    u: Array<Float>
    p: Array<Int>
    swaps: Int
}

impl Lu {
    /// Reconstruct the original matrix `A`, undoing the row permutation.
    fn reconstruct(self) -> Array<Float> {
        n = self.u.shape()[0]
        mut out = zeros([n, n])
        for i in 0 until n {
            for j in 0 until n {
                mut value = 0.0
                for k in 0 until n {
                    value = value + self.l.get(i, k) * self.u.get(k, j)
                }
                out.set(self.p[i], j, value)
            }
        }
        out
    }

    /// Solve `A x = b` by applying `P`, then forward and backward substitution.
    fn solve(self, rhs: Array<Float>) -> Array<Float> {
        n = self.u.shape()[0]
        mut y = zeros([n])
        for i in 0 until n {
            mut value = rhs[self.p[i]]
            for k in 0 until i {
                value = value - self.l.get(i, k) * y[k]
            }
            y.set(i, value)
        }
        mut x = zeros([n])
        for offset in 0 until n {
            i = n - 1 - offset
            mut value = y[i]
            for k in i + 1 until n {
                value = value - self.u.get(i, k) * x[k]
            }
            x.set(i, value / self.u.get(i, i))
        }
        x
    }

    /// Determinant from the triangular factor and the number of row swaps.
    fn determinant(self) -> Float {
        n = self.u.shape()[0]
        mut value = if self.swaps % 2 == 0 { 1.0 } else { -1.0 }
        for i in 0 until n {
            value = value * self.u.get(i, i)
        }
        value
    }
}

/// LU factorization with partial pivoting.
///
/// The matrix must be square. A pivot whose magnitude is at most `tol` is
/// reported as singular instead of allowing a divide-by-zero to escape into
/// a later solve.
pub fn lu(a: Array<Float>, tol: Float = 1e-12) -> Result<Lu, String> {
    shape = a.shape()
    if shape.length() != 2 or shape[0] != shape[1] {
        return Err("lu needs a square matrix")
    }
    n = shape[0]
    mut u = zeros([n, n])
    for i in 0 until n {
        for j in 0 until n {
            u.set(i, j, a.get(i, j))
        }
    }
    mut l = zeros([n, n])
    mut permutation: List<Int> = []
    for i in 0 until n {
        permutation.push(i)
    }
    mut swaps = 0

    for k in 0 until n {
        mut pivot = k
        mut pivot_abs = abs(u.get(k, k))
        for i in k + 1 until n {
            candidate = abs(u.get(i, k))
            if candidate > pivot_abs {
                pivot = i
                pivot_abs = candidate
            }
        }
        if pivot_abs <= tol {
            return Err("lu found a singular matrix")
        }
        if pivot != k {
            for j in 0 until n {
                temporary = u.get(k, j)
                u.set(k, j, u.get(pivot, j))
                u.set(pivot, j, temporary)
            }
            for j in 0 until k {
                temporary = l.get(k, j)
                l.set(k, j, l.get(pivot, j))
                l.set(pivot, j, temporary)
            }
            mut reordered: List<Int> = []
            for i in 0 until n {
                reordered.push(if i == k { permutation[pivot] } else if i == pivot { permutation[k] } else { permutation[i] })
            }
            permutation = reordered
            swaps = swaps + 1
        }
        l.set(k, k, 1.0)
        pivot_value = u.get(k, k)
        for i in k + 1 until n {
            factor = u.get(i, k) / pivot_value
            l.set(i, k, factor)
            u.set(i, k, 0.0)
            for j in k + 1 until n {
                u.set(i, j, u.get(i, j) - factor * u.get(k, j))
            }
        }
    }
    Ok(Lu { l: l, u: u, p: array(permutation), swaps: swaps })
}

/// dy/dt = f(t, y) from t0 to t1 with `steps` classic Runge–Kutta steps.
pub fn rk4(f: fn(Float, Array<Float>) -> Array<Float>, y0: Array<Float>, t0: Float, t1: Float, steps: Int = 1000) -> Solution {
    h = (t1 - t0) / (steps as Float)
    mut times: List<Float> = [t0]
    mut states: List<Float> = []
    for i in 0 until y0.length() {
        states.push(y0[i])
    }
    mut y = y0
    mut t = t0
    for i in 0 until steps {
        k1 = f(t, y)
        k2 = f(t + h / 2.0, y + k1 * (h / 2.0))
        k3 = f(t + h / 2.0, y + k2 * (h / 2.0))
        k4 = f(t + h, y + k3 * h)
        y = y + (k1 + k2 * 2.0 + k3 * 2.0 + k4) * (h / 6.0)
        t = t0 + ((i + 1) as Float) * h
        times.push(t)
        for j in 0 until y.length() {
            states.push(y[j])
        }
    }
    solution(times, states, y0.length(), 4 * steps)
}

/// dy/dt = f(t, y) from t0 to t1 with the adaptive Dormand–Prince 5(4) pair:
/// each step keeps the local error below `tol` (relative to the state).
pub fn rk45(f: fn(Float, Array<Float>) -> Array<Float>, y0: Array<Float>, t0: Float, t1: Float, tol: Float = 1e-8, max_steps: Int = 100000) -> Solution {
    mut times: List<Float> = [t0]
    mut states: List<Float> = []
    for i in 0 until y0.length() {
        states.push(y0[i])
    }
    mut y = y0
    mut t = t0
    mut h = (t1 - t0) / 100.0
    mut evaluations = 0
    mut accepted = 0
    while t < t1 and accepted < max_steps {
        if t + h > t1 {
            h = t1 - t
        }
        k1 = f(t, y)
        k2 = f(t + h / 5.0, y + k1 * (h / 5.0))
        k3 = f(t + h * 0.3, y + (k1 * (3.0 / 40.0) + k2 * (9.0 / 40.0)) * h)
        k4 = f(t + h * 0.8, y + (k1 * (44.0 / 45.0) - k2 * (56.0 / 15.0) + k3 * (32.0 / 9.0)) * h)
        k5 = f(t + h * (8.0 / 9.0), y + (k1 * (19372.0 / 6561.0) - k2 * (25360.0 / 2187.0) + k3 * (64448.0 / 6561.0) - k4 * (212.0 / 729.0)) * h)
        k6 = f(t + h, y + (k1 * (9017.0 / 3168.0) - k2 * (355.0 / 33.0) + k3 * (46732.0 / 5247.0) + k4 * (49.0 / 176.0) - k5 * (5103.0 / 18656.0)) * h)
        fifth = y + (k1 * (35.0 / 384.0) + k3 * (500.0 / 1113.0) + k4 * (125.0 / 192.0) - k5 * (2187.0 / 6784.0) + k6 * (11.0 / 84.0)) * h
        k7 = f(t + h, fifth)
        fourth = y + (k1 * (5179.0 / 57600.0) + k3 * (7571.0 / 16695.0) + k4 * (393.0 / 640.0) - k5 * (92097.0 / 339200.0) + k6 * (187.0 / 2100.0) + k7 * (1.0 / 40.0)) * h
        evaluations = evaluations + 7
        // Error relative to the size of the state.
        scale = 1.0 + abs(y).max()
        err = abs(fifth - fourth).max() / scale
        if err <= tol {
            t = t + h
            y = fifth
            times.push(t)
            for j in 0 until y.length() {
                states.push(y[j])
            }
            accepted = accepted + 1
        }
        factor = if err == 0.0 { 5.0 } else { 0.9 * exp(ln(tol / err) / 5.0) }
        h = h * (if factor < 0.2 { 0.2 } else if factor > 5.0 { 5.0 } else { factor })
    }
    solution(times, states, y0.length(), evaluations)
}

// ---------------------------------------------------------------- complex numbers and FFT

/// A double-precision complex number.
///
/// Complex values are records rather than a compiler primitive for now.  The
/// arithmetic traits keep the public API natural while retaining the same
/// interpreter/native/WASM semantics as the rest of `std.numeric`.
pub record Complex {
    re: Float
    im: Float
}

impl Complex {
    /// The real component.
    fn real(self) -> Float { self.re }

    /// The imaginary component.
    fn imag(self) -> Float { self.im }

    /// The complex conjugate.
    fn conjugate(self) -> Complex { Complex { re: self.re, im: 0.0 - self.im } }

    /// The Euclidean magnitude, computed without a complex backend.
    fn magnitude(self) -> Float { sqrt(self.re * self.re + self.im * self.im) }

    /// `-self`.
    fn neg(self) -> Complex { Complex { re: 0.0 - self.re, im: 0.0 - self.im } }

    /// Reflected scalar operations, so `2.0 + z` and `2.0 * z` are valid.
    fn radd(self, k: Float) -> Complex { Complex { re: k + self.re, im: self.im } }
    fn rsub(self, k: Float) -> Complex { Complex { re: k - self.re, im: 0.0 - self.im } }
    fn rmul(self, k: Float) -> Complex { Complex { re: k * self.re, im: k * self.im } }
    fn rdiv(self, k: Float) -> Complex {
        denominator = self.re * self.re + self.im * self.im
        Complex { re: k * self.re / denominator, im: 0.0 - k * self.im / denominator }
    }
}

impl Add for Complex {
    fn add(self, other: Self) -> Self { Complex { re: self.re + other.re, im: self.im + other.im } }
}

impl Sub for Complex {
    fn sub(self, other: Self) -> Self { Complex { re: self.re - other.re, im: self.im - other.im } }
}

impl Mul for Complex {
    fn mul(self, other: Self) -> Self {
        Complex {
            re: self.re * other.re - self.im * other.im,
            im: self.re * other.im + self.im * other.re,
        }
    }
}

impl Div for Complex {
    fn div(self, other: Self) -> Self {
        denominator = other.re * other.re + other.im * other.im
        Complex {
            re: (self.re * other.re + self.im * other.im) / denominator,
            im: (self.im * other.re - self.re * other.im) / denominator,
        }
    }
}

impl Eq for Complex {
    fn equals(self, other: Self) -> Bool { self.re == other.re and self.im == other.im }
}

/// Construct a complex value from rectangular coordinates.
pub fn complex(re: Float, im: Float = 0.0) -> Complex { Complex { re: re, im: im } }

/// Construct `radius * exp(i angle)`.
pub fn polar(radius: Float, angle: Float) -> Complex {
    Complex { re: radius * cos(angle), im: radius * sin(angle) }
}

/// Construct `exp(i angle)`.
pub fn cis(angle: Float) -> Complex { polar(1.0, angle) }

/// Integer powers for non-negative exponents.
pub fn powi(z: Complex, n: Int) -> Complex {
    mut result = complex(1.0)
    mut i = 0
    while i < n {
        result = result * z
        i = i + 1
    }
    result
}

/// A dense complex vector stored as separate real and imaginary arrays.
///
/// The split representation keeps the current Array engine portable across
/// the interpreter, native backend and WASM while `Array<Complex>` is still
/// being designed as a first-class element type.
pub record ComplexVector {
    re: Array<Float>
    im: Array<Float>
}

impl ComplexVector {
    fn length(self) -> Int { self.re.length() }

    fn at(self, i: Int) -> Complex {
        complex(self.re[i], self.im[i])
    }

    fn magnitude(self) -> Array<Float> {
        sqrt(self.re * self.re + self.im * self.im)
    }
}

/// Build a dense complex vector from matching real and imaginary parts.
pub fn complex_vector(re: Array<Float>, im: Array<Float>) -> Result<ComplexVector, String> {
    if re.length() != im.length() {
        return Err("complex_vector needs real and imaginary arrays with the same length")
    }
    if re.length() == 0 {
        return Err("complex_vector needs a non-empty vector")
    }
    Ok(ComplexVector { re: re, im: im })
}

/// A dense complex matrix stored in row-major split-complex form.
///
/// `re` and `im` contain `rows * cols` values. Keeping the storage explicit
/// makes shape, layout and reproducibility visible instead of hiding a
/// complex allocation behind a backend-specific primitive.
pub record ComplexMatrix {
    rows: Int
    cols: Int
    re: Array<Float>
    im: Array<Float>
}

impl ComplexMatrix {
    fn at(self, row: Int, col: Int) -> Complex {
        index = row * self.cols + col
        complex(self.re[index], self.im[index])
    }

    fn conjugate_transpose(self) -> ComplexMatrix {
        mut out_re: List<Float> = []
        mut out_im: List<Float> = []
        for col in 0 until self.cols {
            for row in 0 until self.rows {
                value = self.at(row, col)
                out_re.push(value.re)
                out_im.push(0.0 - value.im)
            }
        }
        ComplexMatrix {
            rows: self.cols,
            cols: self.rows,
            re: array(out_re),
            im: array(out_im),
        }
    }

    fn matmul(self, other: ComplexMatrix) -> Result<ComplexMatrix, String> {
        if self.cols != other.rows {
            return Err("complex matmul needs compatible matrix dimensions")
        }
        mut out_re: List<Float> = []
        mut out_im: List<Float> = []
        for row in 0 until self.rows {
            for col in 0 until other.cols {
                mut total = complex(0.0)
                for k in 0 until self.cols {
                    total = total + self.at(row, k) * other.at(k, col)
                }
                out_re.push(total.re)
                out_im.push(total.im)
            }
        }
        Ok(ComplexMatrix {
            rows: self.rows,
            cols: other.cols,
            re: array(out_re),
            im: array(out_im),
        })
    }

    fn mul_vector(self, vector: ComplexVector) -> Result<ComplexVector, String> {
        if self.cols != vector.length() {
            return Err("complex matrix-vector multiplication needs compatible dimensions")
        }
        mut out_re: List<Float> = []
        mut out_im: List<Float> = []
        for row in 0 until self.rows {
            mut total = complex(0.0)
            for col in 0 until self.cols {
                total = total + self.at(row, col) * vector.at(col)
            }
            out_re.push(total.re)
            out_im.push(total.im)
        }
        Ok(ComplexVector { re: array(out_re), im: array(out_im) })
    }

    /// Solve `A x = b` with complex Gaussian elimination and partial pivoting.
    fn solve(self, rhs: ComplexVector, tol: Float = 1e-12) -> Result<ComplexVector, String> {
        if self.rows != self.cols {
            return Err("complex solve needs a square matrix")
        }
        if rhs.length() != self.rows {
            return Err("complex solve needs a right-hand side with one value per row")
        }
        n = self.rows
        mut ar = array(self.re.to_list())
        mut ai = array(self.im.to_list())
        mut br = array(rhs.re.to_list())
        mut bi = array(rhs.im.to_list())

        for col in 0 until n {
            mut pivot = col
            mut pivot_abs = sqrt(ar[col * n + col] * ar[col * n + col] + ai[col * n + col] * ai[col * n + col])
            for row in col + 1 until n {
                candidate = sqrt(ar[row * n + col] * ar[row * n + col] + ai[row * n + col] * ai[row * n + col])
                if candidate > pivot_abs {
                    pivot = row
                    pivot_abs = candidate
                }
            }
            if pivot_abs <= tol {
                return Err("complex solve found a singular or rank-deficient matrix")
            }
            if pivot != col {
                for j in col until n {
                    swap_re = ar[col * n + j]
                    swap_im = ai[col * n + j]
                    ar.set(col * n + j, ar[pivot * n + j])
                    ai.set(col * n + j, ai[pivot * n + j])
                    ar.set(pivot * n + j, swap_re)
                    ai.set(pivot * n + j, swap_im)
                }
                swap_re = br[col]
                swap_im = bi[col]
                br.set(col, br[pivot])
                bi.set(col, bi[pivot])
                br.set(pivot, swap_re)
                bi.set(pivot, swap_im)
            }

            pivot_value = complex(ar[col * n + col], ai[col * n + col])
            for row in col + 1 until n {
                factor = complex(ar[row * n + col], ai[row * n + col]) / pivot_value
                ar.set(row * n + col, 0.0)
                ai.set(row * n + col, 0.0)
                for j in col + 1 until n {
                    value = complex(ar[row * n + j], ai[row * n + j]) - factor * complex(ar[col * n + j], ai[col * n + j])
                    ar.set(row * n + j, value.re)
                    ai.set(row * n + j, value.im)
                }
                right = complex(br[row], bi[row]) - factor * complex(br[col], bi[col])
                br.set(row, right.re)
                bi.set(row, right.im)
            }
        }

        mut xr = zeros([n])
        mut xi = zeros([n])
        mut row = n - 1
        while row >= 0 {
            mut total = complex(br[row], bi[row])
            for col in row + 1 until n {
                total = total - complex(ar[row * n + col], ai[row * n + col]) * complex(xr[col], xi[col])
            }
            value = total / complex(ar[row * n + row], ai[row * n + row])
            xr.set(row, value.re)
            xi.set(row, value.im)
            row = row - 1
        }
        Ok(ComplexVector { re: xr, im: xi })
    }
}

/// Build a dense complex matrix from row-major real and imaginary parts.
pub fn complex_matrix(re: Array<Float>, im: Array<Float>, rows: Int, cols: Int) -> Result<ComplexMatrix, String> {
    if rows < 1 or cols < 1 {
        return Err("complex_matrix needs positive row and column counts")
    }
    if re.length() != rows * cols or im.length() != rows * cols {
        return Err("complex_matrix data length must equal rows * cols")
    }
    Ok(ComplexMatrix { rows: rows, cols: cols, re: re, im: im })
}

/// A complex spectrum as real and imaginary parts.
pub record Spectrum {
    re: Array<Float>
    im: Array<Float>
}

impl Spectrum {
    fn magnitude(self) -> Array<Float> {
        sqrt(self.re * self.re + self.im * self.im)
    }

    fn length(self) -> Int {
        self.re.length()
    }
}

fn power_of_two(n: Int) -> Bool {
    mut k = 1
    while k < n {
        k = k * 2
    }
    k == n
}

/// Discrete Fourier transform of a complex signal (re, im); `sign` = -1 for
/// the forward transform, +1 for the inverse (unscaled). Radix-2 Cooley–Tukey
/// when the length is a power of two, the direct O(n²) sum otherwise.
fn transform(re: Array<Float>, im: Array<Float>, sign: Float) -> Spectrum {
    n = re.length()
    if not power_of_two(n) {
        mut out_re = zeros([n])
        mut out_im = zeros([n])
        for k in 0 until n {
            mut sr = 0.0
            mut si = 0.0
            for j in 0 until n {
                angle = sign * 2.0 * pi() * (((k * j) % n) as Float) / (n as Float)
                sr = sr + re[j] * cos(angle) - im[j] * sin(angle)
                si = si + re[j] * sin(angle) + im[j] * cos(angle)
            }
            out_re.set(k, sr)
            out_im.set(k, si)
        }
        return Spectrum { re: out_re, im: out_im }
    }
    // Bit-reversal permutation, then butterflies.
    mut ar = zeros([n])
    mut ai = zeros([n])
    mut bits = 0
    while pow2(bits) < n {
        bits = bits + 1
    }
    for i in 0 until n {
        mut r = 0
        mut v = i
        for b in 0 until bits {
            r = r * 2 + v % 2
            v = v / 2
        }
        ar.set(r, re[i])
        ai.set(r, im[i])
    }
    mut size = 2
    while size <= n {
        half = size / 2
        for start in 0 until n / size {
            base = start * size
            for k in 0 until half {
                angle = sign * 2.0 * pi() * (k as Float) / (size as Float)
                wr = cos(angle)
                wi = sin(angle)
                p = base + k
                q = p + half
                tr = wr * ar[q] - wi * ai[q]
                ti = wr * ai[q] + wi * ar[q]
                ar.set(q, ar[p] - tr)
                ai.set(q, ai[p] - ti)
                ar.set(p, ar[p] + tr)
                ai.set(p, ai[p] + ti)
            }
        }
        size = size * 2
    }
    Spectrum { re: ar, im: ai }
}

fn pow2(k: Int) -> Int {
    mut r = 1
    for i in 0 until k {
        r = r * 2
    }
    r
}

/// Spectrum of a real signal.
pub fn fft(signal: Array<Float>) -> Spectrum {
    transform(signal, zeros([signal.length()]), -1.0)
}

/// The real signal back from its spectrum.
pub fn ifft(spectrum: Spectrum) -> Array<Float> {
    back = transform(spectrum.re, spectrum.im, 1.0)
    back.re / (spectrum.length() as Float)
}

/// Frequencies of the first n/2 + 1 bins for samples `dt` apart: bin k is
/// k / (n dt). Only an even n reaches the Nyquist frequency 1 / (2 dt).
pub fn frequencies(n: Int, dt: Float) -> Array<Float> {
    mut out: List<Float> = []
    for k in 0 to n / 2 {
        out.push((k as Float) / ((n as Float) * dt))
    }
    array(out)
}

/// The first n/2 + 1 magnitudes, scaled so a unit sinusoid reads 1.
pub fn amplitude(spectrum: Spectrum) -> Array<Float> {
    n = spectrum.length()
    mags = spectrum.magnitude()
    mut out: List<Float> = []
    for k in 0 to n / 2 {
        out.push(mags[k] * (if k == 0 or k * 2 == n { 1.0 } else { 2.0 }) / (n as Float))
    }
    array(out)
}
