// Multivariate polynomials with exact rational coefficients.
//
// A polynomial names its variables; each term holds one exponent for each variable, in that order, and an exact
// rational coefficient in canonical text (see std.bigint). The representation is canonical, and every operation
// returns a canonical value: terms are sorted by their exponent vectors in decreasing lexicographic order, no two terms
// share an exponent vector, no coefficient is zero, and the zero polynomial has no terms. Equal polynomials therefore
// have equal representations, and equality can be tested term by term.
//
// Scope: addition, subtraction, multiplication, evaluation at rational points, partial derivatives, total degree and
// degree in one variable, and a readable text. There is no multivariate gcd and no multivariate division here: those
// need algorithms that are not implemented, and nothing in this module claims them.

import std.bigint

/// One term: an exponent for each variable, and an exact rational coefficient in canonical text.
pub record Term {
    exponents: List<Int>
    coefficient: String
}

/// A multivariate polynomial. `variables` names the exponent positions; `terms` is canonical.
pub record MPoly {
    variables: List<String>
    terms: List<Term>
}

// ---------------------------------------------------------------- exact rational text

fn frac_add(a: String, b: String) -> Result<String, String> {
    return match bigint.fraction_parse(a) {
        Err(message) => Err(message),
        Ok(x) => match bigint.fraction_parse(b) {
            Err(message) => Err(message),
            Ok(y) => Ok(bigint.fraction_to_string(bigint.fraction_add(x, y))),
        },
    }
}

fn frac_mul(a: String, b: String) -> Result<String, String> {
    return match bigint.fraction_parse(a) {
        Err(message) => Err(message),
        Ok(x) => match bigint.fraction_parse(b) {
            Err(message) => Err(message),
            Ok(y) => Ok(bigint.fraction_to_string(bigint.fraction_mul(x, y))),
        },
    }
}

fn frac_negate(a: String) -> Result<String, String> {
    return match bigint.fraction_parse(a) {
        Err(message) => Err(message),
        Ok(x) => Ok(bigint.fraction_to_string(bigint.fraction_negate(x))),
    }
}

fn frac_normal(a: String) -> Result<String, String> {
    return match bigint.fraction_parse(a) {
        Err(message) => Err(message),
        Ok(x) => Ok(bigint.fraction_to_string(x)),
    }
}

// ---------------------------------------------------------------- canonical form

fn same_exponents(a: List<Int>, b: List<Int>) -> Bool {
    if a.length() != b.length() {
        return false
    }
    for i in 0 until a.length() {
        if a[i] != b[i] {
            return false
        }
    }
    true
}

/// 1 when a comes before b in decreasing lexicographic order, -1 when after, 0 when equal.
fn exponent_order(a: List<Int>, b: List<Int>) -> Int {
    for i in 0 until a.length() {
        if a[i] > b[i] {
            return 1
        }
        if a[i] < b[i] {
            return -1
        }
    }
    0
}

fn same_variables(a: List<String>, b: List<String>) -> Bool {
    if a.length() != b.length() {
        return false
    }
    for i in 0 until a.length() {
        if a[i] != b[i] {
            return false
        }
    }
    true
}

// Limits of the interchange contract (see the header). They bound work and memory; they are not mathematical limits.
fn max_variables() -> Int {
    16
}

fn max_exponent() -> Int {
    1000
}

fn max_terms() -> Int {
    10000
}

fn max_line_length() -> Int {
    4096
}

/// "" when the variable names are usable: at most max_variables names, none empty, none repeated.
fn variables_problem(variables: List<String>) -> String {
    if variables.length() > max_variables() {
        return "more than " + max_variables().to_string() + " variables"
    }
    for i in 0 until variables.length() {
        if variables[i] == "" {
            return "a variable has an empty name"
        }
        for j in 0 until i {
            if variables[j] == variables[i] {
                return "the variable " + variables[i] + " is repeated"
            }
        }
    }
    ""
}

/// "" when the exponents have one entry per variable and each is between 0 and max_exponent.
fn exponents_problem(exponents: List<Int>, count: Int) -> String {
    if exponents.length() != count {
        return "a term has " + exponents.length().to_string() + " exponents for " + count.to_string() + " variables"
    }
    for e in exponents {
        if e < 0 {
            return "the exponent " + e.to_string() + " is negative; polynomial exponents are not negative"
        }
        if e > max_exponent() {
            return "the exponent " + e.to_string() + " exceeds the limit " + max_exponent().to_string()
        }
    }
    ""
}

/// Canonical polynomial from raw terms: equal exponent vectors are added, zero coefficients are dropped, and the
/// result is sorted. Every raw term must have one exponent per variable, each between 0 and max_exponent, and a canonical
/// coefficient. Variable names must be non-empty and distinct, and there may be at most max_terms raw terms.
pub fn mpoly_from_terms(variables: List<String>, raw: List<Term>) -> Result<MPoly, String> {
    names_problem = variables_problem(variables)
    if names_problem != "" {
        return Err(names_problem)
    }
    if raw.length() > max_terms() {
        return Err("more than " + max_terms().to_string() + " terms")
    }
    mut merged: List<Term> = []
    for t in raw {
        problem = exponents_problem(t.exponents, variables.length())
        if problem != "" {
            return Err(problem)
        }
        mut found = -1
        for j in 0 until merged.length() {
            if same_exponents(merged[j].exponents, t.exponents) {
                found = j
            }
        }
        if found < 0 {
            merged.push(t)
        } else {
            match frac_add(merged[found].coefficient, t.coefficient) {
                Err(message) => {
                    return Err(message)
                },
                Ok(sum) => {
                    mut next: List<Term> = []
                    for j in 0 until merged.length() {
                        if j == found {
                            next.push(Term { exponents: merged[j].exponents, coefficient: sum })
                        } else {
                            next.push(merged[j])
                        }
                    }
                    merged = next
                },
            }
        }
    }
    // insertion sort into decreasing lexicographic order, dropping zeros
    mut sorted: List<Term> = []
    for t in merged {
        if t.coefficient == "0" {
            continue
        }
        mut placed: List<Term> = []
        mut done = false
        for u in sorted {
            if not done and exponent_order(t.exponents, u.exponents) > 0 {
                placed.push(t)
                done = true
            }
            placed.push(u)
        }
        if not done {
            placed.push(t)
        }
        sorted = placed
    }
    Ok(MPoly { variables: variables, terms: sorted })
}

/// The zero polynomial over the given variables.
pub fn mpoly_zero(variables: List<String>) -> MPoly {
    MPoly { variables: variables, terms: [] }
}

/// The constant polynomial with the given rational value.
pub fn mpoly_constant(variables: List<String>, value: String) -> Result<MPoly, String> {
    match frac_normal(value) {
        Err(message) => Err(message),
        Ok(text) => {
            mut exponents: List<Int> = []
            for i in 0 until variables.length() {
                exponents.push(0)
            }
            mpoly_from_terms(variables, [Term { exponents: exponents, coefficient: text }])
        },
    }
}

/// The polynomial x_index (the variable at position index).
pub fn mpoly_variable(variables: List<String>, index: Int) -> Result<MPoly, String> {
    if index < 0 or index >= variables.length() {
        return Err("variable index " + index.to_string() + " is outside the " + variables.length().to_string() + " variables")
    }
    mut exponents: List<Int> = []
    for i in 0 until variables.length() {
        if i == index {
            exponents.push(1)
        } else {
            exponents.push(0)
        }
    }
    mpoly_from_terms(variables, [Term { exponents: exponents, coefficient: "1" }])
}

// ---------------------------------------------------------------- arithmetic

pub fn mpoly_add(a: MPoly, b: MPoly) -> Result<MPoly, String> {
    if not same_variables(a.variables, b.variables) {
        return Err("the polynomials are over different variables")
    }
    mut raw: List<Term> = []
    for t in a.terms {
        raw.push(t)
    }
    for t in b.terms {
        raw.push(t)
    }
    mpoly_from_terms(a.variables, raw)
}

pub fn mpoly_negate(a: MPoly) -> Result<MPoly, String> {
    mut raw: List<Term> = []
    for t in a.terms {
        match frac_negate(t.coefficient) {
            Err(message) => {
                return Err(message)
            },
            Ok(c) => {
                raw.push(Term { exponents: t.exponents, coefficient: c })
            },
        }
    }
    mpoly_from_terms(a.variables, raw)
}

pub fn mpoly_subtract(a: MPoly, b: MPoly) -> Result<MPoly, String> {
    match mpoly_negate(b) {
        Err(message) => Err(message),
        Ok(nb) => mpoly_add(a, nb),
    }
}

pub fn mpoly_multiply(a: MPoly, b: MPoly) -> Result<MPoly, String> {
    if not same_variables(a.variables, b.variables) {
        return Err("the polynomials are over different variables")
    }
    mut raw: List<Term> = []
    for s in a.terms {
        for t in b.terms {
            mut exponents: List<Int> = []
            for i in 0 until a.variables.length() {
                exponents.push(s.exponents[i] + t.exponents[i])
            }
            match frac_mul(s.coefficient, t.coefficient) {
                Err(message) => {
                    return Err(message)
                },
                Ok(c) => {
                    raw.push(Term { exponents: exponents, coefficient: c })
                },
            }
        }
    }
    mpoly_from_terms(a.variables, raw)
}

/// The value at the rational point `values` (one value for each variable, in order).
pub fn mpoly_evaluate(p: MPoly, values: List<String>) -> Result<String, String> {
    if values.length() != p.variables.length() {
        return Err("expected " + p.variables.length().to_string() + " values, got " + values.length().to_string())
    }
    mut total = "0"
    for t in p.terms {
        mut value = t.coefficient
        for i in 0 until p.variables.length() {
            for k in 0 until t.exponents[i] {
                match frac_mul(value, values[i]) {
                    Err(message) => {
                        return Err(message)
                    },
                    Ok(v) => {
                        value = v
                    },
                }
            }
        }
        match frac_add(total, value) {
            Err(message) => {
                return Err(message)
            },
            Ok(sum) => {
                total = sum
            },
        }
    }
    Ok(total)
}

/// The partial derivative with respect to the variable at position index.
pub fn mpoly_derivative(p: MPoly, index: Int) -> Result<MPoly, String> {
    if index < 0 or index >= p.variables.length() {
        return Err("variable index " + index.to_string() + " is outside the variables")
    }
    mut raw: List<Term> = []
    for t in p.terms {
        if t.exponents[index] > 0 {
            mut exponents: List<Int> = []
            for i in 0 until p.variables.length() {
                if i == index {
                    exponents.push(t.exponents[i] - 1)
                } else {
                    exponents.push(t.exponents[i])
                }
            }
            match frac_mul(t.coefficient, t.exponents[index].to_string()) {
                Err(message) => {
                    return Err(message)
                },
                Ok(c) => {
                    raw.push(Term { exponents: exponents, coefficient: c })
                },
            }
        }
    }
    mpoly_from_terms(p.variables, raw)
}

// ---------------------------------------------------------------- degrees and text

/// The total degree (the largest sum of exponents), -1 for the zero polynomial.
pub fn mpoly_total_degree(p: MPoly) -> Int {
    mut best = -1
    for t in p.terms {
        mut sum = 0
        for e in t.exponents {
            sum = sum + e
        }
        if sum > best {
            best = sum
        }
    }
    best
}

/// The degree in the variable at position index, -1 for the zero polynomial. An index outside the variables is an error.
pub fn mpoly_degree_in(p: MPoly, index: Int) -> Result<Int, String> {
    if index < 0 or index >= p.variables.length() {
        return Err("variable index " + index.to_string() + " is outside the variables")
    }
    mut best = -1
    for t in p.terms {
        if t.exponents[index] > best {
            best = t.exponents[index]
        }
    }
    Ok(best)
}

/// A readable text: terms in canonical order, for example "2*x^2*y - 3*y + 1".
pub fn mpoly_to_text(p: MPoly) -> String {
    if p.terms.length() == 0 {
        return "0"
    }
    mut text = ""
    mut first = true
    for t in p.terms {
        mut negative = false
        mut magnitude = t.coefficient
        if magnitude.starts_with("-") {
            negative = true
            magnitude = magnitude.slice(1, magnitude.length())
        }
        mut factors: List<String> = []
        for i in 0 until p.variables.length() {
            if t.exponents[i] == 1 {
                factors.push(p.variables[i])
            } else if t.exponents[i] > 1 {
                factors.push(p.variables[i] + "^" + t.exponents[i].to_string())
            }
        }
        mut body = ""
        if factors.length() == 0 {
            body = magnitude
        } else {
            mut product = ""
            for f in factors {
                if product == "" {
                    product = f
                } else {
                    product = product + "*" + f
                }
            }
            if magnitude == "1" {
                body = product
            } else {
                body = magnitude + "*" + product
            }
        }
        if first {
            if negative {
                text = "-" + body
            } else {
                text = body
            }
            first = false
        } else {
            if negative {
                text = text + " - " + body
            } else {
                text = text + " + " + body
            }
        }
    }
    text
}

// ---------------------------------------------------------------- interchange lines

/// The polynomial of interchange lines "coefficient|e1,e2,..." (see std.symbolic.expression_term_lines). The coefficients
/// are canonicalised; a line with the wrong shape or a non-integer exponent is an error.
pub fn mpoly_parse(variables: List<String>, lines: List<String>) -> Result<MPoly, String> {
    mut raw: List<Term> = []
    for line in lines {
        if line.length() > max_line_length() {
            return Err("a term line is longer than " + max_line_length().to_string() + " characters")
        }
        pieces = line.split("|")
        if pieces.length() != 2 {
            return Err("a term line must be coefficient|exponents: " + line)
        }
        match frac_normal(pieces[0]) {
            Err(message) => {
                return Err(message)
            },
            Ok(coefficient) => {
                mut exponents: List<Int> = []
                for field in pieces[1].split(",") {
                    match parse_int(field) {
                        Err(message) => {
                            return Err(message)
                        },
                        Ok(e) => {
                            exponents.push(e)
                        },
                    }
                }
                raw.push(Term { exponents: exponents, coefficient: coefficient })
            },
        }
    }
    mpoly_from_terms(variables, raw)
}

/// The interchange lines of a polynomial, in canonical term order.
pub fn mpoly_lines(p: MPoly) -> List<String> {
    mut lines: List<String> = []
    for t in p.terms {
        mut text = t.coefficient + "|"
        for i in 0 until t.exponents.length() {
            if i == 0 {
                text = text + t.exponents[i].to_string()
            } else {
                text = text + "," + t.exponents[i].to_string()
            }
        }
        lines.push(text)
    }
    lines
}
