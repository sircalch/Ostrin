// std.strings: helpers built on the String methods.

pub fn repeat(text: String, count: Int) -> String {
    mut out = ""
    mut i = 0
    while i < count {
        out = out + text
        i = i + 1
    }
    out
}

pub fn pad_left(text: String, width: Int, fill: String) -> String {
    mut out = text
    while out.length() < width {
        out = fill + out
    }
    out
}

pub fn pad_right(text: String, width: Int, fill: String) -> String {
    mut out = text
    while out.length() < width {
        out = out + fill
    }
    out
}

pub fn count_of(text: String, part: String) -> Int {
    if part.length() == 0 {
        return 0
    }
    text.split(part).length() - 1
}

pub fn join_with(items: List<String>, separator: String) -> String {
    items.join(separator)
}

pub fn trim(text: String) -> String {
    text.trim()
}

pub fn split(text: String, separator: String) -> List<String> {
    text.split(separator)
}

pub fn lines(text: String) -> List<String> {
    text.lines()
}

pub fn is_blank(text: String) -> Bool {
    text.trim().is_empty()
}

pub fn format_text(template: String, values: List<String>) -> String {
    format(template, values)
}

pub fn char_at(text: String, index: Int) -> String {
    text.char_at(index)
}

pub fn slice(text: String, start: Int, end: Int) -> String {
    text.slice(start, end)
}
