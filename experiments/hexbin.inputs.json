{
  "seed": 91,
  "parameters": {
    "samples": 1200,
    "bins_x": 18,
    "bins_y": 14
  },
  "description": "Seeded bivariate sample counted into hexagonal bins.",
  "reproducibility": {
    "level": "R2",
    "label": "R2 · external snapshot replay verified",
    "next": "R3 · auditable artifact (planned verification)"
  },
  "execution": {
    "mode": "input-file",
    "input_file": "data.json",
    "consumes": [
      "seed",
      "parameters.samples",
      "parameters.bins_x",
      "parameters.bins_y"
    ],
    "sensitivity": {
      "path": "seed",
      "alternate": 92
    },
    "randomness": {
      "seed_path": "seed",
      "algorithm": "xoshiro256**",
      "version": "ostrin.rng/v1",
      "partition": "single sequential stream",
      "status": "verified-in-ci"
    },
    "command": "node scripts/experiment-replay.mjs --fixture hexbin",
    "target": "wasm32-wasip1",
    "wasi": "preview1",
    "status": "verified-in-ci",
    "capabilities": [
      "filesystem.read:data.json"
    ],
    "snapshot": {
      "path": "data.json",
      "kind": "json",
      "embedded": true
    }
  }
}
