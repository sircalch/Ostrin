{
  "seed": 11,
  "parameters": {
    "groups": 5,
    "samples_per_group": 30
  },
  "description": "Seeded five-group measurements with standard uncertainties.",
  "reproducibility": {
    "level": "R1",
    "label": "R1 · seeded replay verified",
    "next": "R2 · external snapshots (planned verification)"
  },
  "execution": {
    "mode": "input-file",
    "input_file": "data.json",
    "consumes": ["seed", "parameters.samples_per_group"],
    "sensitivity": {
      "path": "seed",
      "alternate": 12
    },
    "randomness": {
      "seed_path": "seed",
      "algorithm": "xoshiro256**",
      "version": "ostrin.rng/v1",
      "partition": "single sequential stream",
      "status": "verified-in-ci"
    },
    "command": "node scripts/experiment-replay.mjs --fixture bars",
    "target": "wasm32-wasip1",
    "wasi": "preview1",
    "status": "verified-in-ci"
  }
}
