{
  "seed": 3,
  "parameters": {
    "random_samples": 3000,
    "grid": 28
  },
  "description": "Seeded four-panel dashboard inputs and 28×28 scalar grid.",
  "reproducibility": {
    "level": "R1",
    "label": "R1 · seeded replay verified",
    "next": "R2 · external snapshots (planned verification)"
  },
  "execution": {
    "mode": "input-file",
    "input_file": "data.json",
    "consumes": ["seed", "parameters.random_samples", "parameters.grid"],
    "sensitivity": {
      "path": "seed",
      "alternate": 4
    },
    "randomness": {
      "seed_path": "seed",
      "algorithm": "xoshiro256**",
      "version": "ostrin.rng/v1",
      "partition": "single sequential stream",
      "status": "verified-in-ci"
    },
    "command": "node scripts/experiment-replay.mjs --fixture dashboard",
    "target": "wasm32-wasip1",
    "wasi": "preview1",
    "status": "verified-in-ci"
  }
}
