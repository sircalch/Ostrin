{
  "seed": 7,
  "parameters": {
    "samples": 20000,
    "bins": 48
  },
  "description": "Seeded normal sample histogram and analytic density overlay.",
  "reproducibility": {
    "level": "R1",
    "label": "R1 · seeded replay verified",
    "next": "R2 · external snapshots (planned verification)"
  },
  "execution": {
    "mode": "input-file",
    "input_file": "data.json",
    "consumes": ["seed", "parameters.samples", "parameters.bins"],
    "sensitivity": {
      "path": "seed",
      "alternate": 8
    },
    "randomness": {
      "seed_path": "seed",
      "algorithm": "xoshiro256**",
      "version": "ostrin.rng/v1",
      "partition": "single sequential stream",
      "status": "verified-in-ci"
    },
    "command": "node scripts/experiment-replay.mjs --fixture histogram",
    "target": "wasm32-wasip1",
    "wasi": "preview1",
    "status": "verified-in-ci"
  }
}
