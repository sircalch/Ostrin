{
  "seed": 5,
  "parameters": {
    "clusters": 3,
    "points_per_cluster": 120
  },
  "camera": {
    "azimuth": -40,
    "elevation": 22
  },
  "description": "Seeded three-cluster 3D point cloud and camera.",
  "reproducibility": {
    "level": "R1",
    "label": "R1 · seeded replay verified",
    "next": "R2 · external snapshots (planned verification)"
  },
  "execution": {
    "mode": "input-file",
    "input_file": "data.json",
    "consumes": ["seed", "parameters.clusters", "parameters.points_per_cluster"],
    "sensitivity": {
      "path": "seed",
      "alternate": 6
    },
    "randomness": {
      "seed_path": "seed",
      "algorithm": "xoshiro256**",
      "version": "ostrin.rng/v1",
      "partition": "single sequential stream",
      "status": "verified-in-ci"
    },
    "command": "node scripts/experiment-replay.mjs --fixture point-cloud",
    "target": "wasm32-wasip1",
    "wasi": "preview1",
    "status": "verified-in-ci"
  }
}
